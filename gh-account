#!/bin/sh

# Multi-account GitHub CLI router with fail-closed diagnostics and native auth repair.
# GitHub CLI behavior used here is documented at:
#   https://cli.github.com/manual/gh_auth_status
#   https://cli.github.com/manual/gh_auth_refresh
#   https://cli.github.com/manual/gh_auth_login
#   https://cli.github.com/manual/gh_auth_switch
#   https://cli.github.com/manual/gh_auth_setup-git

set -u
LC_ALL=C
export LC_ALL
umask 077

program=gh-account
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# run_tracked supervises routed commands through job-control process groups
# (`set -m`) that must work without a controlling terminal. bash provides
# that; dash — /bin/sh on Debian and Ubuntu — does not, and every routed
# command then fails with AUTH.SWITCH_FAILED. macOS's /bin/sh is bash, so
# bash is the only runtime this tool has been validated under. Re-exec under
# bash when the pinned PATH above provides one (never the caller's PATH);
# GH_ACCOUNT_SH=posix opts out for diagnosis and is unsupported.
if [ -z "${BASH_VERSION-}" ] && [ "${GH_ACCOUNT_SH-}" != posix ] && \
   [ -z "${GH_ACCOUNT_REEXEC-}" ] && command -v bash >/dev/null 2>&1; then
  GH_ACCOUNT_REEXEC=1 exec bash "$0" "$@"
fi
# The routed-command supervisor is a separate `-c` script. It must run under
# the same shell as the router: it needs `set -m` to succeed without a tty and
# `kill -SIG -- -pgid` to address its own group, and dash provides neither
# (its `set -m` fails with "can't access tty; job control turned off" and its
# builtin kill rejects `-- -pgid` with "Illegal number"). $BASH is bash's own
# path when running under bash — including macOS /bin/sh — and unset otherwise.
supervisor_shell=${BASH:-/bin/sh}
original_xdg_config_home=${XDG_CONFIG_HOME-}
original_gh_config_dir=${GH_CONFIG_DIR-}
trusted_xdg_config_home=$HOME/.config
trusted_gh_config_dir=$trusted_xdg_config_home/gh
gh_context_overrides=
if [ -n "$original_xdg_config_home" ] && [ "$original_xdg_config_home" != "$trusted_xdg_config_home" ]; then
  gh_context_overrides=XDG_CONFIG_HOME
fi
if [ -n "$original_gh_config_dir" ] && [ "$original_gh_config_dir" != "$trusted_gh_config_dir" ]; then
  [ -z "$gh_context_overrides" ] || gh_context_overrides="$gh_context_overrides,"
  gh_context_overrides="${gh_context_overrides}GH_CONFIG_DIR"
fi
XDG_CONFIG_HOME=$trusted_xdg_config_home
GH_CONFIG_DIR=$trusted_gh_config_dir
export XDG_CONFIG_HOME GH_CONFIG_DIR
host=$(printf '%s' "${GH_ACCOUNT_HOST:-github.com}" | tr '[:upper:]' '[:lower:]')
account_uid=$(command -p id -u 2>/dev/null || printf unknown)
platform_name=$(uname -s 2>/dev/null || true)
case "$platform_name" in
  Darwin|FreeBSD|NetBSD|OpenBSD) stat_style=bsd ;;
  Linux) stat_style=gnu ;;
  *) stat_style=unsupported ;;
esac
lock_root=/tmp/gh-account-$account_uid
state_root=$lock_root/$host
lock_dir=$lock_root/operation.lock
lock_gate=$lock_root/operation.gate
restore_failure_file=$state_root/restore.pending
# Git configuration is shared across every GitHub host. Keep its recovery WAL
# beside the UID-wide operation lock so a later operation on any host must
# recover (or refuse) an interrupted whole-file transaction first.
transaction_journal=$lock_root/config.pending.json
audit_file=$HOME/.local/state/gh-account/events.jsonl
lock_attempts=100
lock_sleep=0.1
signal_grace=5
lock_parent=${lock_dir%/*}

EXIT_FAILURE=1
EXIT_AUTH=4
EXIT_USAGE=64
EXIT_UNAVAILABLE=69
EXIT_TEMPFAIL=75
EXIT_NOPERM=77
EXIT_CONFIG=78

lock_held=false
lock_backend=
lock_nonce=
lock_birth=
active_child_pid=
active_child_birth=
child_registration_in_progress=false
pending_child_signal=
tracked_interactive_mode=false
terminal_handoff_backend=
terminal_handoff_active=false
terminal_parent_group=
restore_account=
restore_required=false
recovery_pending=false
restoration_status=not-required
mutation_performed=false
temp_root=
new_temp_path=
accounts_cache=
accounts_stderr_file=
findings_file=
finding_errors=0
finding_warnings=0
auth_action_required=false
diagnostic_status_override=
channel_gh=unchecked
channel_api=unchecked
channel_git_https=unchecked
channel_git_ssh=unchecked
channel_connector=unchecked
transaction_mode=none
binding_config_path=
binding_config_root=
binding_config_state=
binding_config_snapshot=
binding_expected_state=
binding_expected_snapshot=
rr_home_config_state=
rr_home_config_snapshot=
rr_home_expected_state=
rr_home_expected_snapshot=
rr_xdg_config_state=
rr_xdg_config_snapshot=
rr_xdg_expected_state=
rr_xdg_expected_snapshot=
exec_resolved_repo=
last_network_failure=
last_finish_lock_failed=false
rr_home_config_path=
rr_xdg_config_path=
auto_revalidation_required=false
auto_expected_binding=

usage() {
  cat <<'EOF'
Usage:
  gh-account list
  gh-account current [REPO_PATH]
  gh-account doctor [REPO_PATH] [--account USER] [--deep] [--json]
  gh-account preflight USER [REPO_PATH] [--required-scopes LIST] [--json]
  gh-account repair USER [REPO_PATH] [--dry-run] [--interactive]
  gh-account reauth USER [--scopes LIST] [--json]
  gh-account onboard USER [REPO_PATH] [--scopes LIST]
  gh-account insights [ANALYZER_OPTIONS]
  gh-account bind USER [REPO_PATH]
  gh-account use USER [REPO_PATH]
  gh-account auto [REPO_PATH]
  gh-account exec USER [--] GH_ARGUMENTS...
  gh-account git-exec USER REPO_PATH -- {fetch|push|ls-remote} origin [GIT_ARGUMENTS...]

REPO_PATH is a filesystem path to a local Git worktree (e.g. "$PWD"), never owner/repo.
doctor is read-only and emits secret-free findings for humans or agents.
preflight proves the routed account identity and restores the prior account.
repair applies deterministic Git configuration fixes; --interactive may reauth.
reauth/onboard use native GitHub CLI browser/device authorization explicitly.
exec temporarily switches under a per-user lock, runs gh, and verifies restore.
git-exec does the same for an HTTPS origin Git transport operation.
EOF
}

die_code() {
  dc_code=$1
  shift
  printf '%s: %s\n' "$program" "$*" >&2
  exit "$dc_code"
}

make_temp() {
  if [ -z "$temp_root" ]; then
    temp_root=$(mktemp -d /tmp/gh-account.XXXXXX) || return 1
    chmod 700 "$temp_root" 2>/dev/null || { rmdir "$temp_root" 2>/dev/null || true; temp_root=; return 1; }
  fi
  new_temp_path=$(mktemp "$temp_root/item.XXXXXX") || return 1
}

cleanup_temps() {
  [ -n "$temp_root" ] || return 0
  for ct_file in "$temp_root"/*; do
    [ -e "$ct_file" ] || [ -L "$ct_file" ] || continue
    rm -f "$ct_file" 2>/dev/null || true
  done
  rmdir "$temp_root" 2>/dev/null || true
  temp_root=
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

path_uid() {
  case "$stat_style" in
    bsd) stat -f '%u' "$1" 2>/dev/null ;;
    gnu) stat -c '%u' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

path_links() {
  case "$stat_style" in
    bsd) stat -f '%l' "$1" 2>/dev/null ;;
    gnu) stat -c '%h' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

path_device() {
  case "$stat_style" in
    bsd) stat -f '%d' "$1" 2>/dev/null ;;
    gnu) stat -c '%d' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

path_inode() {
  case "$stat_style" in
    bsd) stat -f '%i' "$1" 2>/dev/null ;;
    gnu) stat -c '%i' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

path_mode() {
  case "$stat_style" in
    bsd) stat -f '%Lp' "$1" 2>/dev/null ;;
    gnu) stat -c '%a' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

normalize_octal_mode() {
  nom_mode=$1
  case "$nom_mode" in ''|*[!0-7]*) return 1 ;; esac
  case "$nom_mode" in
    ?) printf '000%s\n' "$nom_mode" ;;
    ??) printf '00%s\n' "$nom_mode" ;;
    ???) printf '0%s\n' "$nom_mode" ;;
    ????) printf '%s\n' "$nom_mode" ;;
    *) return 1 ;;
  esac
}

path_gid() {
  case "$stat_style" in
    bsd) stat -f '%g' "$1" 2>/dev/null ;;
    gnu) stat -c '%g' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

path_group_name() {
  case "$stat_style" in
    bsd) stat -f '%Sg' "$1" 2>/dev/null ;;
    gnu) stat -c '%G' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

# A group-write bit only widens who can write if the group contains someone
# other than the owner. On user-private-group systems (the Debian/Ubuntu
# default: umask 002, every user's primary group is a same-named group with no
# other members) group-writable IS owner-only, and rejecting it makes every
# `git init` repository unusable. Accept the bit only when all of these hold:
# the group is named after the owner, it is the owner's primary group, and its
# explicit member list contains nobody but the owner. Anything else — a shared
# `staff`/`admin`/`users` group, a group with members, an unresolvable group —
# stays rejected. Fail closed on any lookup failure. Memoised on gid because
# the ancestor walks ask the same question dozens of times per run.
group_is_private_to_owner() {
  gipo_path=$1
  gipo_gid=$(path_gid "$gipo_path") || return 1
  gipo_uid=$(path_uid "$gipo_path") || return 1
  case "$gipo_gid$gipo_uid" in ''|*[!0-9]*) return 1 ;; esac
  if [ "${upg_cache_key-}" = "$gipo_gid:$gipo_uid" ]; then
    return "$upg_cache_result"
  fi
  upg_cache_key=$gipo_gid:$gipo_uid
  upg_cache_result=1
  gipo_owner=$(id -un "$gipo_uid" 2>/dev/null) || return 1
  gipo_primary=$(id -g "$gipo_uid" 2>/dev/null) || return 1
  [ "$gipo_primary" = "$gipo_gid" ] || return 1
  gipo_group=$(path_group_name "$gipo_path") || return 1
  [ -n "$gipo_group" ] && [ "$gipo_group" = "$gipo_owner" ] || return 1
  case "$platform_name" in
    Darwin)
      gipo_members=$(dscl . -read "/Groups/$gipo_group" GroupMembership 2>/dev/null | sed 's/^GroupMembership://')
      ;;
    *)
      # getent consults NSS (LDAP, SSSD); /etc/group is the local fallback
      # when getent is absent (minimal images, restricted PATHs). A gid
      # resolvable by neither stays rejected.
      if command_exists getent; then
        gipo_entry=$(getent group "$gipo_gid" 2>/dev/null) || return 1
      elif [ -r /etc/group ]; then
        gipo_entry=$(awk -F: -v gid="$gipo_gid" '$3 == gid { print; exit }' /etc/group 2>/dev/null)
      else
        return 1
      fi
      [ -n "$gipo_entry" ] || return 1
      gipo_members=$(printf '%s\n' "$gipo_entry" | cut -d: -f4 | tr ',' ' ')
      ;;
  esac
  for gipo_member in $gipo_members; do
    [ "$gipo_member" = "$gipo_owner" ] || return 1
  done
  upg_cache_result=0
  return 0
}

path_mode_is_owner_controlled() {
  pmoc_mode=$(normalize_octal_mode "$(path_mode "$1" 2>/dev/null || true)" 2>/dev/null) || return 1
  pmoc_tail=${pmoc_mode#??}
  case "$pmoc_tail" in ?[2367]) return 1 ;; esac
  case "$pmoc_tail" in
    [2367]?) group_is_private_to_owner "$1" || return 1 ;;
  esac
  return 0
}

path_mode_is_not_world_writable() {
  pminww_mode=$(normalize_octal_mode "$(path_mode "$1" 2>/dev/null || true)" 2>/dev/null) || return 1
  pminww_last=${pminww_mode#???}
  case "$pminww_last" in 2|3|6|7) return 1 ;; esac
  return 0
}

dir_mode_has_sticky_bit() {
  dhsb_mode=$(normalize_octal_mode "$(path_mode "$1" 2>/dev/null || true)" 2>/dev/null) || return 1
  dhsb_special=${dhsb_mode%???}
  case "$dhsb_special" in 1|3|5|7) return 0 ;; esac
  return 1
}

config_regular_file_is_safe() {
  crfis_path=$1
  [ -f "$crfis_path" ] && [ ! -L "$crfis_path" ] || return 1
  [ "$(path_uid "$crfis_path")" = "$account_uid" ] && \
    [ "$(path_links "$crfis_path")" = 1 ] && \
    path_mode_is_owner_controlled "$crfis_path" && \
    audit_path_acl_is_safe "$crfis_path"
}

audit_path_acl_is_safe() {
  [ "$(uname -s 2>/dev/null || true)" = Darwin ] || return 0
  apais_acl=$(LC_ALL=C /bin/ls -lde "$1" 2>/dev/null) || return 1
  if printf '%s\n' "$apais_acl" | awk '
    /^[[:space:]]*[0-9]+:/ && / allow / {
      line = $0
      gsub(/,/, " ", line)
      count = split(line, fields, /[[:space:]]+/)
      for (i = 1; i <= count; i++) {
        if (fields[i] ~ /^(write|append|add_file|add_subdirectory|delete|delete_child|writeattr|writeextattr|writesecurity|chown)$/) {
          unsafe = 1
        }
      }
    }
    END { exit(unsafe ? 0 : 1) }
  '; then
    return 1
  fi
  return 0
}

process_birth() {
  pb_pid=$1
  case "$pb_pid" in ''|*[!0-9]*) return 1 ;; esac
  pb_value=$(LC_ALL=C TZ=UTC ps -o lstart= -p "$pb_pid" 2>/dev/null |
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
    awk 'NF == 5 { print; exit }')
  [ -n "$pb_value" ] || return 1
  printf '%s\n' "$pb_value"
}

validate_host() {
  case "$host" in
    ''|.*|*.|*..*|*[!A-Za-z0-9.-]*) return 1 ;;
  esac
  [ "${#host}" -le 253 ] || return 1
  vh_old_ifs=$IFS
  case $- in *f*) vh_had_noglob=true ;; *) vh_had_noglob=false ;; esac
  IFS=.
  set -f
  for vh_label in $host; do
    IFS=$vh_old_ifs
    case "$vh_label" in
      ''|-*|*-|*[!A-Za-z0-9-]*) [ "$vh_had_noglob" = true ] || set +f; return 1 ;;
    esac
    [ "${#vh_label}" -le 63 ] || { [ "$vh_had_noglob" = true ] || set +f; return 1; }
    IFS=.
  done
  [ "$vh_had_noglob" = true ] || set +f
  IFS=$vh_old_ifs
  return 0
}

validate_login() {
  vl_login=$1
  case "$vl_login" in
    ''|-*|*-|*[!A-Za-z0-9-]*) return 1 ;;
  esac
  [ "${#vl_login}" -le 39 ]
}

# A commit author name is only usable when it holds at least one
# non-whitespace character. Git rejects an empty or whitespace-only name
# ("name consists only of disallowed characters"), so callers must treat such
# a value as unconfigured rather than as a present binding.
commit_name_is_configured() {
  case $1 in
    *[![:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

noreply_email_matches_login() {
  nem_login=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  nem_email=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  validate_login "$nem_login" || return 1
  if [ "$host" = github.com ]; then
    nem_suffix="+$nem_login@users.noreply.github.com"
  else
    nem_suffix="+$nem_login@users.noreply.$host"
  fi
  case "$nem_email" in
    *"$nem_suffix") nem_id=${nem_email%"$nem_suffix"} ;;
    *) return 1 ;;
  esac
  case "$nem_id" in ''|*[!0-9]*) return 1 ;; esac
  return 0
}

normalize_scope_list() {
  nsl_input=$1
  [ "${#nsl_input}" -le 512 ] || return 1
  case "$nsl_input" in *[!A-Za-z0-9:_,[:space:]-]*) return 1 ;; esac
  nsl_output=
  nsl_old_ifs=$IFS
  IFS=,
  for nsl_scope in $nsl_input; do
    IFS=$nsl_old_ifs
    nsl_scope=$(printf '%s' "$nsl_scope" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -n "$nsl_scope" ] && [ "${#nsl_scope}" -le 64 ] || return 1
    case "$nsl_scope" in *[!A-Za-z0-9:_-]*) return 1 ;; esac
    [ -n "$nsl_output" ] && nsl_output="$nsl_output,$nsl_scope" || nsl_output=$nsl_scope
    IFS=,
  done
  IFS=$nsl_old_ifs
  [ -n "$nsl_output" ] || return 1
  printf '%s\n' "$nsl_output"
}

token_override_names() {
  to_names=
  [ "${GH_TOKEN+x}" = x ] && to_names=GH_TOKEN
  if [ "${GITHUB_TOKEN+x}" = x ]; then
    [ -n "$to_names" ] && to_names="$to_names,GITHUB_TOKEN" || to_names=GITHUB_TOKEN
  fi
  if [ "${GH_ENTERPRISE_TOKEN+x}" = x ]; then
    [ -n "$to_names" ] && to_names="$to_names,GH_ENTERPRISE_TOKEN" || to_names=GH_ENTERPRISE_TOKEN
  fi
  if [ "${GITHUB_ENTERPRISE_TOKEN+x}" = x ]; then
    [ -n "$to_names" ] && to_names="$to_names,GITHUB_ENTERPRISE_TOKEN" || to_names=GITHUB_ENTERPRISE_TOKEN
  fi
  printf '%s\n' "$to_names"
}

assert_no_token_override() {
  ano_names=$(token_override_names)
  [ -z "$ano_names" ] || die_code "$EXIT_NOPERM" "environment token override present ($ano_names); stored-account routing is not authoritative"
}

assert_safe_gh_context() {
  asgc_transport=$(gh_transport_override_names)
  [ -z "$gh_context_overrides" ] || \
    die_code "$EXIT_NOPERM" "GitHub CLI configuration override present ($gh_context_overrides); native account routing is not authoritative"
  [ -z "$asgc_transport" ] || \
    die_code "$EXIT_NOPERM" "GitHub transport/debug override present ($asgc_transport); credential routing is not authoritative"
}

gh_transport_override_names() {
  gto_names=
  for gto_name in GH_HTTP_UNIX_SOCKET GH_DEBUG GODEBUG HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy SSL_CERT_FILE SSL_CERT_DIR SSLKEYLOGFILE; do
    gto_present=
    # shellcheck disable=SC2154 # Assigned dynamically by the immediately preceding eval.
    eval "gto_present=\${$gto_name+x}"
    if [ "$gto_present" = x ]; then
      [ -n "$gto_names" ] && gto_names="$gto_names,$gto_name" || gto_names=$gto_name
    fi
  done
  printf '%s\n' "$gto_names"
}

git_context_override_names() {
  gco_names=
  for gco_name in GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_EXEC_PATH GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_NOSYSTEM GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_PARAMETERS GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_SSH GIT_SSH_COMMAND GIT_ASKPASS SSH_ASKPASS SSH_ASKPASS_REQUIRE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_SSL_NO_VERIFY GIT_SSL_CAINFO GIT_SSL_CAPATH GIT_SSL_CIPHER_LIST GIT_CURL_VERBOSE GIT_TRACE GIT_TRACE_CURL GIT_TRACE_CURL_NO_DATA GIT_TRACE_PACKET GIT_TRACE_REDACT; do
    gco_present=
    # shellcheck disable=SC2154 # Assigned dynamically by the immediately preceding eval.
    eval "gco_present=\${$gco_name+x}"
    if [ "$gco_present" = x ]; then
      [ -n "$gco_names" ] && gco_names="$gco_names,$gco_name" || gco_names=$gco_name
    fi
  done
  printf '%s\n' "$gco_names"
}

assert_safe_git_context() {
  asg_names=$(git_context_override_names)
  [ -z "$asg_names" ] || die_code "$EXIT_NOPERM" "SAFETY.REFUSED: Git context override present ($asg_names)"
}

refresh_accounts() {
  last_network_failure=
  make_temp || return 1
  accounts_stdout_file=$new_temp_path
  make_temp || return 1
  accounts_stderr_file=$new_temp_path
  if [ "$lock_held" = true ]; then
    run_tracked gh auth status --hostname "$host" --json hosts \
      >"$accounts_stdout_file" 2>"$accounts_stderr_file"
  else
    gh auth status --hostname "$host" --json hosts \
      >"$accounts_stdout_file" 2>"$accounts_stderr_file"
  fi
  accounts_status=$?
  if [ "$accounts_status" -ne 0 ]; then
    classify_network_error "$accounts_stderr_file" || true
    return 1
  fi
  accounts_raw=$(cat "$accounts_stdout_file") || return 1
  printf '%s\n' "$accounts_raw" | jq -e --arg host "$host" '
    type == "object" and
    (.hosts | type == "object") and
    ((.hosts[$host] // []) | type == "array") and
    all((.hosts[$host] // [])[];
      (.login | type == "string") and
      (.login | test("^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$")) and
      (.active | type == "boolean") and
      (.state == "success" or .state == "error" or .state == "timeout") and
      ((.tokenSource // "unknown") | type == "string"))
  ' >/dev/null 2>&1 || return 2
  accounts_cache=$(printf '%s\n' "$accounts_raw" | jq -c --arg host "$host" '
    .hosts[$host] = (.hosts[$host] // [])
  ') || return 2
  return 0
}

stored_account() {
  sa_user=$1
  printf '%s\n' "$accounts_cache" | jq -e --arg host "$host" --arg user "$sa_user" '
    .hosts[$host] | any((.login | ascii_downcase) == ($user | ascii_downcase))
  ' >/dev/null 2>&1
}

healthy_account() {
  ha_user=$1
  printf '%s\n' "$accounts_cache" | jq -e --arg host "$host" --arg user "$ha_user" '
    .hosts[$host] | any(
      ((.login | ascii_downcase) == ($user | ascii_downcase)) and .state == "success"
    )
  ' >/dev/null 2>&1
}

keyring_account() {
  ka_user=$1
  [ "$(account_source "$ka_user")" = keyring ]
}

usable_account() {
  ua_user=$1
  healthy_account "$ua_user" && keyring_account "$ua_user"
}

canonical_account() {
  ca_user=$1
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" --arg user "$ca_user" '
    .hosts[$host] | map(select((.login | ascii_downcase) == ($user | ascii_downcase))) | first | .login // empty
  '
}

account_state() {
  as_user=$1
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" --arg user "$as_user" '
    .hosts[$host] | map(select((.login | ascii_downcase) == ($user | ascii_downcase))) | first | .state // "missing"
  '
}

account_source() {
  ats_user=$1
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" --arg user "$ats_user" '
    .hosts[$host] | map(select((.login | ascii_downcase) == ($user | ascii_downcase))) | first | .tokenSource // "unknown"
  '
}

account_scopes() {
  asc_user=$1
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" --arg user "$asc_user" '
    .hosts[$host]
    | map(select((.login | ascii_downcase) == ($user | ascii_downcase)))
    | first
    | (.scopes // "")
    | if type == "array" then join(",") elif type == "string" then . else "" end
  '
}

active_account() {
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" '
    .hosts[$host] | map(select(.active == true)) | first | .login // empty
  '
}

active_count() {
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" '
    [.hosts[$host][] | select(.active == true)] | length
  '
}

repository_root() {
  git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null
}

native_helper_configured() {
  nhc_host=$1
  nhc_repo=${2:-}
  make_temp || return 1
  nhc_file=$new_temp_path
  if [ -n "$nhc_repo" ]; then
    git -C "$nhc_repo" config --get-all "credential.https://$nhc_host.helper" >"$nhc_file" 2>/dev/null || return 1
  else
    git config --global --get-all "credential.https://$nhc_host.helper" >"$nhc_file" 2>/dev/null || return 1
  fi
  nhc_seen_reset=false
  nhc_after_count=0
  nhc_command=
  while IFS= read -r nhc_value; do
    if [ -z "$nhc_value" ]; then
      nhc_seen_reset=true
      nhc_after_count=0
      nhc_command=
    elif [ "$nhc_seen_reset" = true ]; then
      nhc_after_count=$((nhc_after_count + 1))
      nhc_command=$nhc_value
    fi
  done <"$nhc_file"
  [ "$nhc_seen_reset" = true ] && [ "$nhc_after_count" -eq 1 ] || return 1
  nhc_trusted_gh=$(command -v gh 2>/dev/null || true)
  [ -n "$nhc_trusted_gh" ] || return 1
  [ "$nhc_command" = '!gh auth git-credential' ] || \
    [ "$nhc_command" = "!$nhc_trusted_gh auth git-credential" ]
}

bound_account() {
  ba_repo=$1
  ba_account=$(git -C "$ba_repo" config --local --get github.account 2>/dev/null || true)
  if [ -z "$ba_account" ]; then
    ba_account=$(git -C "$ba_repo" config --local --get credential.username 2>/dev/null || true)
  fi
  printf '%s\n' "$ba_account"
}

parse_remote_url() {
  remote_url=$1
  remote_owner=
  remote_repo=
  remote_protocol=unknown
  case "$remote_url" in
    "ssh://git@$host/"*) pr_path=${remote_url#"ssh://git@$host/"}; remote_protocol=ssh ;;
    "git@$host:"*) pr_path=${remote_url#"git@$host:"}; remote_protocol=ssh ;;
    https://*@*|http://*@*) return 2 ;;
    "https://$host/"*) pr_path=${remote_url#"https://$host/"}; remote_protocol=https ;;
    "http://$host/"*) pr_path=${remote_url#"http://$host/"}; remote_protocol=http ;;
    '') return 1 ;;
    *) return 3 ;;
  esac
  pr_path=${pr_path%.git}
  case "$pr_path" in
    */*) remote_owner=${pr_path%%/*}; remote_repo=${pr_path#*/} ;;
    *) return 3 ;;
  esac
  [ -n "$remote_owner" ] && [ -n "$remote_repo" ] || return 3
  case "$remote_owner$remote_repo" in *[!A-Za-z0-9_.-]*) return 3 ;; esac
  return 0
}

parse_remote() {
  pr_repo=$1
  make_temp || return 3
  pr_urls=$new_temp_path
  git -C "$pr_repo" remote get-url --all origin >"$pr_urls" 2>/dev/null || return 1
  git -C "$pr_repo" remote get-url --push --all origin >>"$pr_urls" 2>/dev/null || return 3
  pr_seen=false
  pr_owner=
  pr_name=
  pr_protocol=
  while IFS= read -r pr_url; do
    [ -n "$pr_url" ] || return 3
    parse_remote_url "$pr_url"
    pr_status=$?
    [ "$pr_status" -eq 0 ] || return "$pr_status"
    if [ "$pr_seen" = false ]; then
      pr_seen=true
      pr_owner=$remote_owner
      pr_name=$remote_repo
      pr_protocol=$remote_protocol
    elif [ "$(printf '%s/%s' "$remote_owner" "$remote_repo" | tr '[:upper:]' '[:lower:]')" != \
           "$(printf '%s/%s' "$pr_owner" "$pr_name" | tr '[:upper:]' '[:lower:]')" ]; then
      return 4
    elif [ "$remote_protocol" != "$pr_protocol" ]; then
      pr_protocol=mixed
    fi
  done <"$pr_urls"
  [ "$pr_seen" = true ] || return 1
  remote_owner=$pr_owner
  remote_repo=$pr_name
  remote_protocol=$pr_protocol
  return 0
}

repository_transport_overrides() {
  rto_repo=$1
  repository_helper_override=false
  repository_local_helper_override=false
  repository_specific_helper_override=false
  repository_username_override=false
  repository_header_override=false
  repository_tls_unsafe=false
  repository_proxy_configured=false
  repository_url_rewrite=false
  repository_use_http_path_unsafe=false
  repository_use_config_only_unsafe=false
  repository_use_http_path_override=false
  repository_use_config_only_override=false
  make_temp || return 1
  rto_values=$new_temp_path
  rto_trusted_gh=$(command -v gh 2>/dev/null || true)
  for rto_scope in --local --worktree; do
    : >"$rto_values"
    if git -C "$rto_repo" config "$rto_scope" --get-regexp '^credential\..*\.helper$|^credential\.helper$' >"$rto_values" 2>/dev/null; then
      while IFS=' ' read -r rto_helper_key _; do
        if [ -n "$rto_helper_key" ]; then
          repository_helper_override=true
          repository_local_helper_override=true
        fi
      done <"$rto_values"
    fi
    : >"$rto_values"
    if git -C "$rto_repo" config "$rto_scope" --get-regexp '^credential\..*\.usehttppath$' >"$rto_values" 2>/dev/null; then
      while IFS=' ' read -r rto_path_key rto_path_value; do
        case "$(printf '%s' "$rto_path_value" | tr '[:upper:]' '[:lower:]')" in
          true|yes|on|1) ;;
          *) [ -n "$rto_path_key" ] && repository_use_http_path_override=true ;;
        esac
      done <"$rto_values"
    fi
    : >"$rto_values"
    if git -C "$rto_repo" config "$rto_scope" --get-regexp '^user\.useconfigonly$' >"$rto_values" 2>/dev/null; then
      while IFS=' ' read -r rto_only_key rto_only_value; do
        case "$(printf '%s' "$rto_only_value" | tr '[:upper:]' '[:lower:]')" in
          true|yes|on|1) ;;
          *) [ -n "$rto_only_key" ] && repository_use_config_only_override=true ;;
        esac
      done <"$rto_values"
    fi
  done
  : >"$rto_values"
  if git config --global --get-regexp '^credential\..*\.helper$' >"$rto_values" 2>/dev/null; then
    while IFS=' ' read -r rto_helper_key _; do
      case "$rto_helper_key" in
        "credential.https://$host.helper") ;;
        "credential.https://$host/"*.helper)
          repository_helper_override=true
          repository_specific_helper_override=true
          ;;
      esac
    done <"$rto_values"
  fi
  : >"$rto_values"
  if git config --global --get-regexp '^credential\..*\.usehttppath$' >"$rto_values" 2>/dev/null; then
    while IFS=' ' read -r rto_path_key rto_path_value; do
      case "$rto_path_key" in
        "credential.https://$host.useHttpPath") ;;
        "credential.https://$host/"*.useHttpPath)
          case "$(printf '%s' "$rto_path_value" | tr '[:upper:]' '[:lower:]')" in
            true|yes|on|1) ;;
            *) repository_use_http_path_override=true ;;
          esac
          ;;
      esac
    done <"$rto_values"
  fi
  if [ -s "${pr_urls:-/dev/null}" ]; then
    while IFS= read -r rto_url; do
      case "$rto_url" in "https://$host/"*) ;; *) continue ;; esac
      : >"$rto_values"
      if git -C "$rto_repo" config --get-urlmatch credential.helper "$rto_url" >"$rto_values" 2>/dev/null; then
        rto_helper=$(sed -n '1p' "$rto_values")
        [ "$rto_helper" = '!gh auth git-credential' ] || \
          { [ -n "$rto_trusted_gh" ] && [ "$rto_helper" = "!$rto_trusted_gh auth git-credential" ]; } || \
          repository_helper_override=true
        [ "$(wc -l <"$rto_values" | tr -d '[:space:]')" = 1 ] || repository_helper_override=true
      else
        repository_helper_override=true
      fi
      rto_bound=$(git -C "$rto_repo" config --local --get credential.username 2>/dev/null || true)
      rto_effective_user=$(git -C "$rto_repo" config --get-urlmatch credential.username "$rto_url" 2>/dev/null || true)
      [ -z "$rto_effective_user" ] || [ "$rto_effective_user" = "$rto_bound" ] || repository_username_override=true
      rto_ssl=$(git -C "$rto_repo" config --get-urlmatch http.sslVerify "$rto_url" 2>/dev/null || true)
      case "$(printf '%s' "$rto_ssl" | tr '[:upper:]' '[:lower:]')" in false|no|off|0) repository_tls_unsafe=true ;; esac
      for rto_tls_key in http.sslCAInfo http.sslCAPath http.sslCert http.sslKey; do
        [ -z "$(git -C "$rto_repo" config --get-urlmatch "$rto_tls_key" "$rto_url" 2>/dev/null || true)" ] || \
          repository_tls_unsafe=true
      done
      [ -z "$(git -C "$rto_repo" config --get-urlmatch http.proxy "$rto_url" 2>/dev/null || true)" ] || \
        repository_proxy_configured=true
      rto_use_path=$(git -C "$rto_repo" config --get-urlmatch credential.useHttpPath "$rto_url" 2>/dev/null || true)
      [ "$rto_use_path" = true ] || repository_use_http_path_unsafe=true
    done <"$pr_urls"
  fi
  [ -z "$(git -C "$rto_repo" config --get remote.origin.proxy 2>/dev/null || true)" ] || \
    repository_proxy_configured=true
  [ -z "$(git -C "$rto_repo" config --get remote.origin.proxyAuthMethod 2>/dev/null || true)" ] || \
    repository_proxy_configured=true
  [ "$(git -C "$rto_repo" config --get user.useConfigOnly 2>/dev/null || true)" = true ] || \
    repository_use_config_only_unsafe=true
  : >"$rto_values"
  if git -C "$rto_repo" config --get-regexp '^http\..*\.extraheader$|^http\.extraheader$' >"$rto_values" 2>/dev/null; then
    while IFS=' ' read -r rto_header_key _; do
      rto_header_key=$(printf '%s' "$rto_header_key" | tr '[:upper:]' '[:lower:]')
      case "$rto_header_key" in
        http.extraheader|"http.https://$host"*.extraheader)
          repository_header_override=true
          ;;
      esac
    done <"$rto_values"
  fi
  for rto_scope in --local --worktree; do
    : >"$rto_values"
    if git -C "$rto_repo" config "$rto_scope" --get-regexp '^http\..*\.extraheader$|^http\.extraheader$' >"$rto_values" 2>/dev/null; then
      while IFS=' ' read -r rto_header_key _; do
        [ -n "$rto_header_key" ] && repository_header_override=true
      done <"$rto_values"
    fi
  done
  make_temp || return 1
  rto_raw_urls=$new_temp_path
  git -C "$rto_repo" config --get-all remote.origin.url >"$rto_raw_urls" 2>/dev/null || true
  git -C "$rto_repo" config --get-all remote.origin.pushurl >>"$rto_raw_urls" 2>/dev/null || true
  : >"$rto_values"
  if git -C "$rto_repo" config --get-regexp '^url\..*\.' >"$rto_values" 2>/dev/null; then
    while IFS=' ' read -r rto_rewrite_key rto_rewrite_prefix; do
      rto_rewrite_key=$(printf '%s' "$rto_rewrite_key" | tr '[:upper:]' '[:lower:]')
      case "$rto_rewrite_key" in *.insteadof|*.pushinsteadof) ;; *) continue ;; esac
      [ -n "$rto_rewrite_prefix" ] || { repository_url_rewrite=true; continue; }
      while IFS= read -r rto_raw_url; do
        [ -n "$rto_raw_url" ] || continue
        case "$rto_raw_url" in "$rto_rewrite_prefix"*) repository_url_rewrite=true ;; esac
      done <"$rto_raw_urls"
    done <"$rto_values"
  fi
  return 0
}

init_findings() {
  make_temp || return 1
  findings_file=$new_temp_path
  finding_errors=0
  finding_warnings=0
  auth_action_required=false
  diagnostic_status_override=
}

add_finding() {
  af_id=$1
  af_severity=$2
  af_summary=$3
  af_safe=$4
  af_operator=$5
  af_retry=$6
  shift 6
  jq -cn \
    --arg id "$af_id" \
    --arg severity "$af_severity" \
    --arg summary "$af_summary" \
    --argjson safe "$af_safe" \
    --argjson operator "$af_operator" \
    --argjson retry "$af_retry" \
    --args '{
      id:$id,
      severity:$severity,
      summary:$summary,
      safe_to_automate:$safe,
      requires_operator:$operator,
      retryable:$retry,
      remediation_argv:$ARGS.positional
    }' -- "$@" >>"$findings_file"
  case "$af_severity" in
    error|critical) finding_errors=$((finding_errors + 1)) ;;
    warning) finding_warnings=$((finding_warnings + 1)) ;;
  esac
}

add_repair_remediation_finding() {
  arrf_id=$1
  arrf_severity=$2
  arrf_summary=$3
  arrf_user=$4
  arrf_repo=$5
  if validate_login "$arrf_user"; then
    if [ -n "$arrf_repo" ]; then
      add_finding "$arrf_id" "$arrf_severity" "$arrf_summary" false true false \
        gh-account repair "$arrf_user" "$arrf_repo"
    else
      add_finding "$arrf_id" "$arrf_severity" "$arrf_summary" false true false \
        gh-account repair "$arrf_user"
    fi
  else
    add_finding "$arrf_id" "$arrf_severity" "$arrf_summary" false true false
  fi
}

add_preflight_remediation_finding() {
  aprf_id=$1
  aprf_severity=$2
  aprf_summary=$3
  aprf_safe=$4
  aprf_operator=$5
  aprf_retry=$6
  aprf_user=$7
  aprf_repo=$8
  if validate_login "$aprf_user"; then
    if [ -n "$aprf_repo" ]; then
      add_finding "$aprf_id" "$aprf_severity" "$aprf_summary" \
        "$aprf_safe" "$aprf_operator" "$aprf_retry" \
        gh-account preflight "$aprf_user" "$aprf_repo" --json
    else
      add_finding "$aprf_id" "$aprf_severity" "$aprf_summary" \
        "$aprf_safe" "$aprf_operator" "$aprf_retry" \
        gh-account preflight "$aprf_user" --json
    fi
  else
    add_finding "$aprf_id" "$aprf_severity" "$aprf_summary" \
      "$aprf_safe" "$aprf_operator" "$aprf_retry"
  fi
}

finding_ids_json() {
  if [ -n "$findings_file" ] && [ -s "$findings_file" ]; then
    jq -s 'map(.id) | unique' "$findings_file"
  else
    printf '[]\n'
  fi
}

diagnostic_status() {
  if [ -n "$diagnostic_status_override" ]; then
    printf '%s\n' "$diagnostic_status_override"
  elif [ "$finding_errors" -gt 0 ]; then
    printf 'action_required\n'
  elif [ "$finding_warnings" -gt 0 ]; then
    printf 'warning\n'
  else
    printf 'healthy\n'
  fi
}

event_outcome() {
  eo_status=$1
  case "$eo_status" in
    0) printf 'completed\n' ;;
    2) printf 'cancelled\n' ;;
    77) printf 'refused\n' ;;
    *) printf 'failed\n' ;;
  esac
}

render_diagnostic() {
  rd_json=$1
  rd_account=$2
  rd_repo=$3
  rd_exit_origin=$4
  rd_status=$(diagnostic_status)
  rd_findings=$(jq -s '.' "$findings_file")
  if [ "$rd_json" = true ]; then
    jq -n \
      --arg schema gh-account.diagnostic.v1 \
      --arg status "$rd_status" \
      --arg host "$host" \
      --arg account "$rd_account" \
      --arg repository "$rd_repo" \
      --arg gh_keyring "$channel_gh" \
      --arg api "$channel_api" \
      --arg git_https "$channel_git_https" \
      --arg git_ssh "$channel_git_ssh" \
      --arg connector "$channel_connector" \
      --arg exit_origin "$rd_exit_origin" \
      --argjson mutation "$mutation_performed" \
      --argjson findings "$rd_findings" '
      {
        schema:$schema,
        status:$status,
        mutation_performed:$mutation,
        host:$host,
        account:$account,
        repository:$repository,
        channels:{
          gh_keyring:$gh_keyring,
          api:$api,
          git_https:$git_https,
          git_ssh:$git_ssh,
          connector:$connector
        },
        findings:$findings,
        exit_origin:$exit_origin
      }'
  else
    printf 'status: %s\n' "$rd_status"
    printf 'host: %s\n' "$host"
    [ -n "$rd_account" ] && printf 'account: %s\n' "$rd_account"
    [ -n "$rd_repo" ] && printf 'repository: %s\n' "$rd_repo"
    printf 'channels: gh=%s api=%s git-https=%s git-ssh=%s connector=%s\n' \
      "$channel_gh" "$channel_api" "$channel_git_https" "$channel_git_ssh" "$channel_connector"
    jq -r '. | "\(.severity): \(.id): \(.summary)"' "$findings_file"
  fi
}

audit_directory_is_safe() {
  ads_expected=$HOME/.local/state/gh-account
  [ "${audit_file%/*}" = "$ads_expected" ] || return 1
  case "$HOME" in /*) ;; *) return 1 ;; esac
  for ads_dir in "$HOME" "$HOME/.local" "$HOME/.local/state" "$ads_expected"; do
    if [ -e "$ads_dir" ] || [ -L "$ads_dir" ]; then
      [ -d "$ads_dir" ] && [ ! -L "$ads_dir" ] || return 1
      [ "$(path_uid "$ads_dir")" = "$account_uid" ] || return 1
    else
      if mkdir "$ads_dir" 2>/dev/null; then
        chmod 700 "$ads_dir" 2>/dev/null || return 1
      else
        [ -d "$ads_dir" ] && [ ! -L "$ads_dir" ] && \
          [ "$(path_uid "$ads_dir")" = "$account_uid" ] || return 1
      fi
    fi
    # One decision function for "can a non-owner write here" — this used to
    # be an inline copy of the mode-bit test, which silently diverged once the
    # private-group rule landed and left the audit spool unwritable on every
    # user-private-group host (no events recorded, no error to the caller).
    path_mode_is_owner_controlled "$ads_dir" || return 1
    audit_path_acl_is_safe "$ads_dir" || return 1
  done
  chmod 700 "$ads_expected" 2>/dev/null || return 1
  [ "$(normalize_octal_mode "$(path_mode "$ads_expected" 2>/dev/null || true)" 2>/dev/null || true)" = 0700 ] || return 1
  return 0
}

emit_event() {
  command_exists jq || return 0
  ee_event=$1
  ee_outcome=$2
  ee_status=$3
  ee_exit=$4
  ee_origin=$5
  ee_account=$6
  ee_repo=$7
  ee_restore=$8
  ee_ids=$(finding_ids_json)
  ee_time=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)
  if ! audit_directory_is_safe; then
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  fi
  ee_dir=${audit_file%/*}
  ee_lock=$ee_dir/events.lock
  old_umask=$(umask)
  umask 077
  if [ -e "$ee_lock" ] || [ -L "$ee_lock" ]; then
    [ -f "$ee_lock" ] && [ ! -L "$ee_lock" ] && \
      [ "$(path_uid "$ee_lock")" = "$account_uid" ] && \
      [ "$(path_links "$ee_lock")" = 1 ] || {
        umask "$old_umask"
        printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
        return 1
      }
  else
    if ! (set -C; : >"$ee_lock") 2>/dev/null; then
      [ -f "$ee_lock" ] && [ ! -L "$ee_lock" ] && \
        [ "$(path_uid "$ee_lock")" = "$account_uid" ] && \
        [ "$(path_links "$ee_lock")" = 1 ] || {
          umask "$old_umask"
          printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
          return 1
        }
    fi
  fi
  chmod 600 "$ee_lock" 2>/dev/null || {
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  }
  audit_path_acl_is_safe "$ee_lock" || {
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  }
  if [ -e "$audit_file" ] || [ -L "$audit_file" ]; then
    [ -f "$audit_file" ] && [ ! -L "$audit_file" ] && \
      [ "$(path_uid "$audit_file")" = "$account_uid" ] && \
      [ "$(path_links "$audit_file")" = 1 ] && \
      audit_path_acl_is_safe "$audit_file" || {
        umask "$old_umask"
        printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
        return 1
      }
  fi
  ee_rotation=1
  while [ "$ee_rotation" -le 5 ]; do
    ee_rotated_file=$audit_file.$ee_rotation
    if [ -e "$ee_rotated_file" ] || [ -L "$ee_rotated_file" ]; then
      [ -f "$ee_rotated_file" ] && [ ! -L "$ee_rotated_file" ] && \
        [ "$(path_uid "$ee_rotated_file")" = "$account_uid" ] && \
        [ "$(path_links "$ee_rotated_file")" = 1 ] && \
        audit_path_acl_is_safe "$ee_rotated_file" || {
          umask "$old_umask"
          printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
          return 1
        }
    fi
    ee_rotation=$((ee_rotation + 1))
  done
  ee_line=$(mktemp "$ee_dir/.event.XXXXXX") || {
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  }
  chmod 600 "$ee_line" 2>/dev/null || { rm -f "$ee_line" 2>/dev/null || true; umask "$old_umask"; return 1; }
  ee_remote=false
  case "$ee_event" in gh.exec.completed|git.exec.completed) ee_remote=true ;; esac
  ee_repo_present=false
  [ -z "$ee_repo" ] || ee_repo_present=true
  if ! jq -cn \
    --arg schema gh-account.audit.v1 \
    --arg timestamp "$ee_time" \
    --arg event "$ee_event" \
    --arg outcome "$ee_outcome" \
    --arg status "$ee_status" \
    --arg host "$host" \
    --arg account "$ee_account" \
    --arg exit_origin "$ee_origin" \
    --arg restoration "$ee_restore" \
    --argjson repository_present "$ee_repo_present" \
    --argjson remote_command_executed "$ee_remote" \
    --argjson exit_code "$ee_exit" \
    --argjson mutation_performed "$mutation_performed" \
    --argjson finding_ids "$ee_ids" '
      {
        schema:$schema,
        timestamp:$timestamp,
        event:$event,
        outcome:$outcome,
        status:$status,
        host:$host,
        account:$account,
        repository_present:$repository_present,
        exit_code:$exit_code,
        exit_origin:$exit_origin,
        finding_ids:$finding_ids,
        mutation_performed:$mutation_performed,
        remote_command_executed:$remote_command_executed,
        restoration:$restoration
      }' >"$ee_line"; then
    rm -f "$ee_line" 2>/dev/null || true
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  fi
  ee_writer_file=$(mktemp "$ee_dir/.writer.XXXXXX") || {
    rm -f "$ee_line" 2>/dev/null || true
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  }
  if ! cat >"$ee_writer_file" <<'AUDIT_WRITER'
#!/bin/sh
    target=$1
    line=$2
    owner_uid=$3
    stat_style=$4
    path_uid() {
      case "$stat_style" in
        bsd) stat -f "%u" "$1" 2>/dev/null ;;
        gnu) stat -c "%u" "$1" 2>/dev/null ;;
        *) return 1 ;;
      esac
    }
    path_links() {
      case "$stat_style" in
        bsd) stat -f "%l" "$1" 2>/dev/null ;;
        gnu) stat -c "%h" "$1" 2>/dev/null ;;
        *) return 1 ;;
      esac
    }
    if [ -e "$target" ] || [ -L "$target" ]; then
      [ -f "$target" ] && [ ! -L "$target" ] || exit 1
      [ "$(path_uid "$target")" = "$owner_uid" ] && [ "$(path_links "$target")" = 1 ] || exit 1
    else
      (set -C; : >"$target") 2>/dev/null || exit 1
      chmod 600 "$target" 2>/dev/null || exit 1
    fi
    size=$(wc -c <"$target" 2>/dev/null | tr -d '[:space:]' || printf 0)
    case "$size" in ""|*[!0-9]*) exit 1 ;; esac
    if [ "$size" -gt 5242880 ]; then
      for rotation in 1 2 3 4 5; do
        rotated="$target.$rotation"
        if [ -e "$rotated" ] || [ -L "$rotated" ]; then
          [ -f "$rotated" ] && [ ! -L "$rotated" ] || exit 1
          [ "$(path_uid "$rotated")" = "$owner_uid" ] && \
            [ "$(path_links "$rotated")" = 1 ] || exit 1
        fi
      done
      rm -f "$target.5" 2>/dev/null || exit 1
      [ ! -e "$target.4" ] || mv "$target.4" "$target.5" 2>/dev/null || exit 1
      [ ! -e "$target.3" ] || mv "$target.3" "$target.4" 2>/dev/null || exit 1
      [ ! -e "$target.2" ] || mv "$target.2" "$target.3" 2>/dev/null || exit 1
      [ ! -e "$target.1" ] || mv "$target.1" "$target.2" 2>/dev/null || exit 1
      mv "$target" "$target.1" 2>/dev/null || exit 1
      (set -C; : >"$target") 2>/dev/null || exit 1
      chmod 600 "$target" 2>/dev/null || exit 1
    fi
    cat "$line" >>"$target" 2>/dev/null || exit 1
    chmod 600 "$target" 2>/dev/null || exit 1
AUDIT_WRITER
  then
    rm -f "$ee_line" "$ee_writer_file" 2>/dev/null || true
    umask "$old_umask"
    printf '%s: warning: audit event could not be recorded safely\n' "$program" >&2
    return 1
  fi
  chmod 700 "$ee_writer_file" 2>/dev/null || {
    rm -f "$ee_line" "$ee_writer_file" 2>/dev/null || true
    umask "$old_umask"
    return 1
  }
  ee_write_status=1
  if command_exists lockf; then
    lockf -k -s -t 2 "$ee_lock" /bin/sh "$ee_writer_file" \
      "$audit_file" "$ee_line" "$account_uid" "$stat_style"
    ee_write_status=$?
  elif command_exists flock; then
    flock -w 2 "$ee_lock" /bin/sh "$ee_writer_file" \
      "$audit_file" "$ee_line" "$account_uid" "$stat_style"
    ee_write_status=$?
  fi
  rm -f "$ee_line" "$ee_writer_file" 2>/dev/null || true
  umask "$old_umask"
  if [ "$ee_write_status" -ne 0 ]; then
    printf '%s: warning: audit event could not be recorded safely (writer status %s)\n' \
      "$program" "$ee_write_status" >&2
    return 1
  fi
  return 0
}

lease_process_matches() {
  lpm_pid=$1
  lpm_birth=$2
  case "$lpm_pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -n "$lpm_birth" ] || return 1
  kill -0 "$lpm_pid" 2>/dev/null || return 1
  # A zombie still answers kill -0 and still reports its original lstart, but
  # it has exited and can never release anything. It stays a zombie only when
  # its parent died and PID 1 does not reap orphans — a container started
  # without --init, exactly where agents run this tool. Treat it as gone so a
  # crashed operation's lease can be reclaimed there too.
  lpm_state=$(LC_ALL=C ps -o stat= -p "$lpm_pid" 2>/dev/null | tr -d '[:space:]')
  case "$lpm_state" in Z*) return 1 ;; esac
  lpm_current=$(process_birth "$lpm_pid" 2>/dev/null || true)
  [ -z "$lpm_current" ] || [ "$lpm_current" = "$lpm_birth" ]
}

create_operation_lease() {
  [ ! -e "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  col_tmp="${lock_dir}.new.${lock_nonce}"
  [ ! -e "$col_tmp" ] && [ ! -L "$col_tmp" ] || return 1
  mkdir "$col_tmp" 2>/dev/null || return 1
  chmod 700 "$col_tmp" 2>/dev/null || return 1
  audit_path_acl_is_safe "$col_tmp" || return 1
  printf '%s\n' "$$" >"$col_tmp/owner.pid" || return 1
  printf '%s\n' "$lock_nonce" >"$col_tmp/owner.nonce" || return 1
  printf '%s\n' "$lock_birth" >"$col_tmp/owner.birth" || return 1
  chmod 600 "$col_tmp/owner.pid" "$col_tmp/owner.nonce" "$col_tmp/owner.birth" 2>/dev/null || return 1
  audit_path_acl_is_safe "$col_tmp/owner.pid" && \
    audit_path_acl_is_safe "$col_tmp/owner.nonce" && \
    audit_path_acl_is_safe "$col_tmp/owner.birth" || return 1
  mv "$col_tmp" "$lock_dir" 2>/dev/null || return 1
}

append_config_guard_manifest() {
  acgm_lock_path=$1
  acgm_owner_path=$2
  [ "$lock_held" = true ] && [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  printf '%s%s' "$acgm_lock_path" "$acgm_owner_path" | \
    LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  acgm_manifest=$lock_dir/config.guards
  if [ -e "$acgm_manifest" ] || [ -L "$acgm_manifest" ]; then
    config_regular_file_is_safe "$acgm_manifest" || return 1
  fi
  acgm_tmp=$lock_dir/.config.guards.$lock_nonce
  [ ! -e "$acgm_tmp" ] && [ ! -L "$acgm_tmp" ] || return 1
  (set -C; : >"$acgm_tmp") 2>/dev/null || return 1
  chmod 600 "$acgm_tmp" 2>/dev/null || { rm -f "$acgm_tmp" 2>/dev/null || true; return 1; }
  if [ -e "$acgm_manifest" ]; then
    cat "$acgm_manifest" >"$acgm_tmp" 2>/dev/null || { rm -f "$acgm_tmp" 2>/dev/null || true; return 1; }
  fi
  printf '%s\t%s\n' "$acgm_lock_path" "$acgm_owner_path" >>"$acgm_tmp" || {
    rm -f "$acgm_tmp" 2>/dev/null || true
    return 1
  }
  make_temp || { rm -f "$acgm_tmp" 2>/dev/null || true; return 1; }
  acgm_expected=$new_temp_path
  cp -p "$acgm_tmp" "$acgm_expected" 2>/dev/null || {
    rm -f "$acgm_tmp" "$acgm_expected" 2>/dev/null || true
    return 1
  }
  config_regular_file_is_safe "$acgm_expected" || {
    rm -f "$acgm_tmp" "$acgm_expected" 2>/dev/null || true
    return 1
  }
  run_tracked mv "$acgm_tmp" "$acgm_manifest" 2>/dev/null
  acgm_status=$?
  if ! config_regular_file_is_safe "$acgm_manifest" || \
     ! cmp -s "$acgm_expected" "$acgm_manifest"; then
    rm -f "$acgm_tmp" "$acgm_expected" 2>/dev/null || true
    return 1
  fi
  # Destination identity and exact bytes are the commit boundary. Failure to
  # remove the private verifier copy must not reverse that proven outcome;
  # cleanup_temps will make another best-effort pass during final cleanup.
  rm -f "$acgm_expected" 2>/dev/null || true
  # A nonzero tracked status is an ambiguous transport outcome. Exact bytes in
  # a safe, single-link destination prove that the atomic rename did commit.
  [ "$acgm_status" -eq 0 ] || return 0
  return 0
}

manifest_contains_config_guard() {
  mccg_lock=$1
  mccg_owner=$2
  mccg_manifest=$lock_dir/config.guards
  config_regular_file_is_safe "$mccg_manifest" || return 1
  mccg_tab=$(printf '\t')
  while IFS="$mccg_tab" read -r mccg_row_lock mccg_row_owner mccg_extra; do
    [ -z "$mccg_extra" ] || continue
    [ "$mccg_row_lock" = "$mccg_lock" ] && \
      [ "$mccg_row_owner" = "$mccg_owner" ] && return 0
  done <"$mccg_manifest"
  return 1
}

same_file_identity() {
  sfi_left=$1
  sfi_right=$2
  sfi_left_device=$(path_device "$sfi_left" 2>/dev/null || true)
  sfi_right_device=$(path_device "$sfi_right" 2>/dev/null || true)
  sfi_left_inode=$(path_inode "$sfi_left" 2>/dev/null || true)
  sfi_right_inode=$(path_inode "$sfi_right" 2>/dev/null || true)
  [ -n "$sfi_left_device" ] && [ -n "$sfi_left_inode" ] && \
    [ "$sfi_left_device" = "$sfi_right_device" ] && \
    [ "$sfi_left_inode" = "$sfi_right_inode" ]
}

config_guard_pair_is_safe() {
  cgp_owner=$1
  cgp_lock=$2
  [ -f "$cgp_owner" ] && [ ! -L "$cgp_owner" ] && \
    [ -f "$cgp_lock" ] && [ ! -L "$cgp_lock" ] || return 1
  [ "$(path_uid "$cgp_owner" 2>/dev/null || true)" = "$account_uid" ] && \
    [ "$(path_uid "$cgp_lock" 2>/dev/null || true)" = "$account_uid" ] && \
    [ "$(path_links "$cgp_owner" 2>/dev/null || true)" = 2 ] && \
    [ "$(path_links "$cgp_lock" 2>/dev/null || true)" = 2 ] && \
    path_mode_is_owner_controlled "$cgp_owner" && \
    path_mode_is_owner_controlled "$cgp_lock" && \
    audit_path_acl_is_safe "$cgp_owner" && \
    audit_path_acl_is_safe "$cgp_lock" && \
    same_file_identity "$cgp_owner" "$cgp_lock"
}

acquire_registered_config_lock() {
  arcl_target=$1
  arcl_root=$2
  secure_config_path_under "$arcl_target" "$arcl_root" || return 1
  arcl_parent=${arcl_target%/*}
  [ -d "$arcl_parent" ] && [ ! -L "$arcl_parent" ] || return 1
  registered_config_lock=$arcl_target.lock
  secure_config_path_under "$registered_config_lock" "$arcl_root" || return 1
  [ ! -e "$registered_config_lock" ] && [ ! -L "$registered_config_lock" ] || return 1
  registered_config_owner=$(mktemp "$arcl_parent/.gh-account-owner.$lock_nonce.XXXXXX") || return 1
  printf 'gh-account-lock-v1 %s\n' "$lock_nonce" >"$registered_config_owner" || {
    rm -f "$registered_config_owner" 2>/dev/null || true
    return 1
  }
  chmod 600 "$registered_config_owner" 2>/dev/null || { rm -f "$registered_config_owner" 2>/dev/null || true; return 1; }
  config_regular_file_is_safe "$registered_config_owner" || { rm -f "$registered_config_owner" 2>/dev/null || true; return 1; }
  append_config_guard_manifest "$registered_config_lock" "$registered_config_owner" || {
    # If the installed manifest contains this exact row, the owner file is the
    # only proof that a later hard-link outcome belongs to us. Preserve it.
    manifest_contains_config_guard "$registered_config_lock" "$registered_config_owner" || \
      rm -f "$registered_config_owner" 2>/dev/null || true
    return 1
  }
  run_tracked ln "$registered_config_owner" "$registered_config_lock" 2>/dev/null
  arcl_link_status=$?
  if config_guard_pair_is_safe "$registered_config_owner" "$registered_config_lock"; then
    # The exact two-link inode identity reconciles a nonzero supervisor result.
    [ "$arcl_link_status" -eq 0 ] || return 0
    return 0
  fi
  # Never unlink the owner proof here. Serialized cleanup can remove a proven
  # pair later; an ambiguous foreign lock stays fail-closed.
  return 1
}

registered_config_lock_for_target() {
  rclft_target=$1
  rclft_root=$2
  secure_config_path_under "$rclft_target" "$rclft_root" || return 1
  rclft_manifest=$lock_dir/config.guards
  config_regular_file_is_safe "$rclft_manifest" || return 1
  rclft_tab=$(printf '\t')
  while IFS="$rclft_tab" read -r rclft_lock rclft_owner rclft_extra; do
    [ -z "$rclft_extra" ] || return 1
    [ "$rclft_lock" = "$rclft_target.lock" ] || continue
    rclft_parent=${rclft_lock%/*}
    case "$rclft_owner" in "$rclft_parent/.gh-account-owner.$lock_nonce."*) ;; *) return 1 ;; esac
    [ -f "$rclft_lock" ] && [ ! -L "$rclft_lock" ] && \
      [ -f "$rclft_owner" ] && [ ! -L "$rclft_owner" ] || return 1
    [ "$(path_uid "$rclft_lock")" = "$account_uid" ] && \
      [ "$(path_uid "$rclft_owner")" = "$account_uid" ] && \
      [ "$(path_links "$rclft_lock")" = 2 ] && \
      [ "$(path_links "$rclft_owner")" = 2 ] && \
      path_mode_is_owner_controlled "$rclft_lock" && \
      path_mode_is_owner_controlled "$rclft_owner" && \
      audit_path_acl_is_safe "$rclft_lock" && \
      audit_path_acl_is_safe "$rclft_owner" && \
      same_file_identity "$rclft_lock" "$rclft_owner" || return 1
    registered_config_lock=$rclft_lock
    registered_config_owner=$rclft_owner
    return 0
  done <"$rclft_manifest"
  return 1
}

resume_incomplete_config_guard() {
  ricg_target=$1
  ricg_root=$2
  secure_config_path_under "$ricg_target" "$ricg_root" || return 2
  ricg_lock=$ricg_target.lock
  ricg_parent=${ricg_lock%/*}
  secure_config_path_under "$ricg_lock" "$ricg_root" || return 2
  ricg_manifest=$lock_dir/config.guards
  [ -e "$ricg_manifest" ] || [ -L "$ricg_manifest" ] || return 1
  config_regular_file_is_safe "$ricg_manifest" || return 2
  ricg_tab=$(printf '\t')
  ricg_matches=0
  ricg_owner=
  while IFS="$ricg_tab" read -r ricg_row_lock ricg_row_owner ricg_extra; do
    [ -n "$ricg_row_lock" ] && [ -n "$ricg_row_owner" ] && \
      [ -z "$ricg_extra" ] || return 2
    [ "$ricg_row_lock" = "$ricg_lock" ] || continue
    ricg_matches=$((ricg_matches + 1))
    [ "$ricg_matches" -eq 1 ] || return 2
    case "$ricg_row_owner" in
      "$ricg_parent/.gh-account-owner.$lock_nonce."*) ;;
      *) return 2 ;;
    esac
    ricg_owner=$ricg_row_owner
  done <"$ricg_manifest"
  [ "$ricg_matches" -eq 1 ] || return 1

  if config_guard_pair_is_safe "$ricg_owner" "$ricg_lock"; then
    registered_config_lock=$ricg_lock
    registered_config_owner=$ricg_owner
    return 0
  fi
  # Only a definitively absent canonical lock is resumable. Any directory
  # entry, including a dangling symlink, preserves the manifest and owner as
  # fail-closed evidence rather than risking a link to an attacker path.
  [ ! -e "$ricg_lock" ] && [ ! -L "$ricg_lock" ] || return 2
  config_regular_file_is_safe "$ricg_owner" || return 2
  [ "$(path_links "$ricg_owner" 2>/dev/null || true)" = 1 ] || return 2
  run_tracked ln "$ricg_owner" "$ricg_lock" 2>/dev/null
  ricg_link_status=$?
  config_guard_pair_is_safe "$ricg_owner" "$ricg_lock" || return 2
  registered_config_lock=$ricg_lock
  registered_config_owner=$ricg_owner
  # Exact inode identity reconciles an ambiguous retry result just as it does
  # for the initial link attempt.
  [ "$ricg_link_status" -eq 0 ] || return 0
  return 0
}

ensure_registered_config_lock() {
  ercl_target=$1
  ercl_root=$2
  registered_config_lock_for_target "$ercl_target" "$ercl_root" && return 0
  resume_incomplete_config_guard "$ercl_target" "$ercl_root"
  ercl_resume_status=$?
  case "$ercl_resume_status" in
    0) return 0 ;;
    1) acquire_registered_config_lock "$ercl_target" "$ercl_root" ;;
    *) return 1 ;;
  esac
}

cleanup_registered_config_locks() {
  crcl_lease_dir=$1
  crcl_nonce=$2
  crcl_manifest=$crcl_lease_dir/config.guards
  [ -e "$crcl_manifest" ] || [ -L "$crcl_manifest" ] || return 0
  config_regular_file_is_safe "$crcl_manifest" || return 1
  crcl_tab=$(printf '\t')
  while IFS="$crcl_tab" read -r crcl_lock crcl_owner crcl_extra; do
    [ -n "$crcl_lock" ] && [ -n "$crcl_owner" ] && [ -z "$crcl_extra" ] || return 1
    case "$crcl_lock" in /*.lock) ;; *) return 1 ;; esac
    crcl_parent=${crcl_lock%/*}
    case "$crcl_owner" in "$crcl_parent/.gh-account-owner.$crcl_nonce."*) ;; *) return 1 ;; esac
    if [ -e "$crcl_owner" ] || [ -L "$crcl_owner" ]; then
      config_regular_file_is_safe "$crcl_owner" || {
        [ "$(path_links "$crcl_owner" 2>/dev/null || true)" = 2 ] && \
          [ -f "$crcl_owner" ] && [ ! -L "$crcl_owner" ] && \
          [ "$(path_uid "$crcl_owner")" = "$account_uid" ] && \
          path_mode_is_owner_controlled "$crcl_owner" && \
          audit_path_acl_is_safe "$crcl_owner" || return 1
      }
      crcl_links=$(path_links "$crcl_owner" 2>/dev/null || true)
      case "$crcl_links" in 1|2) ;; *) return 1 ;; esac
      if [ -e "$crcl_lock" ] || [ -L "$crcl_lock" ]; then
        [ -f "$crcl_lock" ] && [ ! -L "$crcl_lock" ] && \
          same_file_identity "$crcl_owner" "$crcl_lock" || return 1
        run_tracked rm -f "$crcl_lock" 2>/dev/null || return 1
      elif [ "$crcl_links" -ne 1 ]; then
        return 1
      fi
      run_tracked rm -f "$crcl_owner" 2>/dev/null || return 1
    elif [ -e "$crcl_lock" ] || [ -L "$crcl_lock" ]; then
      return 1
    fi
  done <"$crcl_manifest"
  run_tracked rm -f "$crcl_manifest" 2>/dev/null
}

retire_operation_lease() {
  rol_nonce=$1
  case "$rol_nonce" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
  rol_tombstone="$lock_dir.retired.$rol_nonce"
  [ ! -e "$rol_tombstone" ] && [ ! -L "$rol_tombstone" ] || return 1
  mv "$lock_dir" "$rol_tombstone" 2>/dev/null || return 1
  [ ! -e "$lock_dir" ] && [ ! -L "$lock_dir" ] && \
    [ -d "$rol_tombstone" ] && [ ! -L "$rol_tombstone" ] || return 1
  # Canonical retirement is the atomic unlock/reclaim point. Cleanup is
  # best-effort so a crash cannot leave a partially deleted canonical lease.
  rm -f "$rol_tombstone/owner.pid" "$rol_tombstone/owner.nonce" \
    "$rol_tombstone/owner.birth" "$rol_tombstone/child.owner" \
    "$rol_tombstone/.child.ready.$rol_nonce" \
    "$rol_tombstone/.child.owner.$rol_nonce" \
    "$rol_tombstone/.child.ready.tmp.$rol_nonce" \
    "$rol_tombstone"/.child.ready."$rol_nonce".* \
    "$rol_tombstone"/.child.owner."$rol_nonce".* \
    "$rol_tombstone"/.child.ready.tmp."$rol_nonce".* 2>/dev/null || true
  rmdir "$rol_tombstone" 2>/dev/null || true
  return 0
}

claim_operation_lease() {
  create_operation_lease && return 0
  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  [ "$(path_uid "$lock_dir")" = "$account_uid" ] || return 1
  audit_path_acl_is_safe "$lock_dir" || return 1
  for col_file in owner.pid owner.nonce owner.birth; do
    [ -f "$lock_dir/$col_file" ] && [ ! -L "$lock_dir/$col_file" ] || return 2
    [ "$(path_uid "$lock_dir/$col_file")" = "$account_uid" ] && \
      [ "$(path_links "$lock_dir/$col_file")" = 1 ] || return 2
    audit_path_acl_is_safe "$lock_dir/$col_file" || return 2
  done
  col_pid=$(sed -n '1p' "$lock_dir/owner.pid" 2>/dev/null || true)
  col_nonce=$(sed -n '1p' "$lock_dir/owner.nonce" 2>/dev/null || true)
  col_birth=$(sed -n '1p' "$lock_dir/owner.birth" 2>/dev/null || true)
  case "$col_nonce" in ''|*[!A-Za-z0-9._-]*) return 2 ;; esac
  lease_process_matches "$col_pid" "$col_birth" && return 2
  if [ -e "$lock_dir/child.owner" ] || [ -L "$lock_dir/child.owner" ]; then
    [ -f "$lock_dir/child.owner" ] && [ ! -L "$lock_dir/child.owner" ] || return 2
    [ "$(path_uid "$lock_dir/child.owner")" = "$account_uid" ] && \
      [ "$(path_links "$lock_dir/child.owner")" = 1 ] || return 2
    col_child_pid=$(sed -n '1p' "$lock_dir/child.owner" 2>/dev/null || true)
    col_child_birth=$(sed -n '2p' "$lock_dir/child.owner" 2>/dev/null || true)
    lease_process_matches "$col_child_pid" "$col_child_birth" && return 2
  fi
  cleanup_registered_config_locks "$lock_dir" "$col_nonce" || return 1
  retire_operation_lease "$col_nonce" || return 1
  create_operation_lease
}

remove_operation_lease() {
  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  [ "$(sed -n '1p' "$lock_dir/owner.pid" 2>/dev/null || true)" = "$$" ] || return 1
  [ "$(sed -n '1p' "$lock_dir/owner.nonce" 2>/dev/null || true)" = "$lock_nonce" ] || return 1
  [ "$(sed -n '1p' "$lock_dir/owner.birth" 2>/dev/null || true)" = "$lock_birth" ] || return 1
  cleanup_registered_config_locks "$lock_dir" "$lock_nonce" || return 1
  retire_operation_lease "$lock_nonce"
}

acquire_lock() {
  case "$lock_attempts" in ''|*[!0-9]*) return 1 ;; esac
  case "$lock_sleep" in ''|*[!0-9.]*|.*.*) return 1 ;; esac
  case "$account_uid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$lock_parent" != "$lock_dir" ] || return 1
  [ "$lock_parent" = "$lock_root" ] || return 1
  [ ! -L "$lock_root" ] && [ ! -L "$state_root" ] && [ ! -L "$lock_gate" ] && [ ! -L "$lock_dir" ] || return 1
  old_umask=$(umask)
  umask 077
  if ! mkdir "$lock_parent" 2>/dev/null; then
    [ -d "$lock_parent" ] && [ ! -L "$lock_parent" ] || { umask "$old_umask"; return 1; }
  fi
  chmod 700 "$lock_parent" 2>/dev/null || { umask "$old_umask"; return 1; }
  [ -d "$lock_parent" ] && [ "$(path_uid "$lock_parent")" = "$account_uid" ] || { umask "$old_umask"; return 1; }
  audit_path_acl_is_safe "$lock_parent" || { umask "$old_umask"; return 1; }
  if ! mkdir "$state_root" 2>/dev/null; then
    [ -d "$state_root" ] && [ ! -L "$state_root" ] || { umask "$old_umask"; return 1; }
  fi
  chmod 700 "$state_root" 2>/dev/null || { umask "$old_umask"; return 1; }
  [ "$(path_uid "$state_root")" = "$account_uid" ] || { umask "$old_umask"; return 1; }
  audit_path_acl_is_safe "$state_root" || { umask "$old_umask"; return 1; }
  if [ ! -e "$lock_gate" ]; then
    (set -C; : >"$lock_gate") 2>/dev/null || [ -e "$lock_gate" ] || { umask "$old_umask"; return 1; }
  fi
  [ -f "$lock_gate" ] && [ ! -L "$lock_gate" ] || { umask "$old_umask"; return 1; }
  [ "$(path_uid "$lock_gate")" = "$account_uid" ] && [ "$(path_links "$lock_gate")" = 1 ] || { umask "$old_umask"; return 1; }
  chmod 600 "$lock_gate" 2>/dev/null || { umask "$old_umask"; return 1; }
  audit_path_acl_is_safe "$lock_gate" || { umask "$old_umask"; return 1; }
  if command_exists lockf; then
    lock_backend=lockf_lease
  elif command_exists flock; then
    lock_backend=flock_fd
  else
    umask "$old_umask"
    return 3
  fi
  make_temp || { umask "$old_umask"; return 1; }
  lock_nonce="$$.$(basename "$new_temp_path")"
  # A stable process-birth identifier is required by the crash-reclaim lease.
  # Darwin and the supported Linux/BSD userlands expose ps(1) lstart. Treat a
  # missing capability as a dependency failure, not unsafe lock metadata.
  lock_birth=$(process_birth "$$") || { umask "$old_umask"; return 3; }
  al_attempt=0
  if command_exists lockf; then
    exec 9>>"$lock_gate" || { umask "$old_umask"; return 1; }
    while :; do
      lockf -s -t 0 9 2>/dev/null
      al_status=$?
      if [ "$al_status" -eq 0 ]; then
        lock_backend=lockf_fd
        break
      fi
      if [ "$al_status" -eq "$EXIT_USAGE" ]; then
        exec 9>&-
        lock_backend=lockf_lease
        break
      fi
      al_attempt=$((al_attempt + 1))
      if [ "$al_attempt" -ge "$lock_attempts" ]; then
        exec 9>&-
        umask "$old_umask"
        return 2
      fi
      sleep "$lock_sleep"
    done
  elif command_exists flock; then
    exec 9>>"$lock_gate" || { umask "$old_umask"; return 1; }
    while ! flock -n 9; do
      al_attempt=$((al_attempt + 1))
      if [ "$al_attempt" -ge "$lock_attempts" ]; then
        exec 9>&-
        umask "$old_umask"
        return 2
      fi
      sleep "$lock_sleep"
    done
    lock_backend=flock_fd
  fi
  if [ "$lock_backend" = lockf_fd ] || [ "$lock_backend" = flock_fd ]; then
    claim_operation_lease
    al_status=$?
    if [ "$al_status" -ne 0 ]; then
      [ "$lock_backend" != flock_fd ] || flock -u 9 2>/dev/null || true
      exec 9>&-
      umask "$old_umask"
      [ "$al_status" -eq 2 ] && return 2
      return 1
    fi
    lock_held=true
    umask "$old_umask"
    return 0
  fi
  al_gate_script='
    lock_path=$1
    owner_pid=$2
    owner_nonce=$3
    owner_uid=$4
    owner_birth=$5
    stat_style=$6
    umask 077
    birth_of() {
      LC_ALL=C TZ=UTC ps -o lstart= -p "$1" 2>/dev/null |
        sed "s/^[[:space:]]*//;s/[[:space:]]*$//" |
        awk "NF == 5 { print; exit }"
    }
    file_uid() {
      case "$stat_style" in bsd) stat -f "%u" "$1" 2>/dev/null ;; gnu) stat -c "%u" "$1" 2>/dev/null ;; *) return 1 ;; esac
    }
    file_links() {
      case "$stat_style" in bsd) stat -f "%l" "$1" 2>/dev/null ;; gnu) stat -c "%h" "$1" 2>/dev/null ;; *) return 1 ;; esac
    }
    file_device() {
      case "$stat_style" in bsd) stat -f "%d" "$1" 2>/dev/null ;; gnu) stat -c "%d" "$1" 2>/dev/null ;; *) return 1 ;; esac
    }
    file_inode() {
      case "$stat_style" in bsd) stat -f "%i" "$1" 2>/dev/null ;; gnu) stat -c "%i" "$1" 2>/dev/null ;; *) return 1 ;; esac
    }
    same_file() {
      left_device=$(file_device "$1") || return 1
      right_device=$(file_device "$2") || return 1
      left_inode=$(file_inode "$1") || return 1
      right_inode=$(file_inode "$2") || return 1
      [ "$left_device" = "$right_device" ] && [ "$left_inode" = "$right_inode" ]
    }
    cleanup_guards() {
      guard_manifest=$lock_path/config.guards
      [ -e "$guard_manifest" ] || [ -L "$guard_manifest" ] || return 0
      [ -f "$guard_manifest" ] && [ ! -L "$guard_manifest" ] || return 1
      [ "$(file_uid "$guard_manifest")" = "$owner_uid" ] && \
        [ "$(file_links "$guard_manifest")" = 1 ] || return 1
      guard_tab=$(printf "\t")
      while IFS="$guard_tab" read -r guard_lock guard_owner guard_extra; do
        [ -n "$guard_lock" ] && [ -n "$guard_owner" ] && [ -z "$guard_extra" ] || return 1
        case "$guard_lock" in /*.lock) ;; *) return 1 ;; esac
        guard_parent=${guard_lock%/*}
        case "$guard_owner" in "$guard_parent/.gh-account-owner.$prior_nonce."*) ;; *) return 1 ;; esac
        if [ -e "$guard_owner" ] || [ -L "$guard_owner" ]; then
          [ -f "$guard_owner" ] && [ ! -L "$guard_owner" ] && \
            [ "$(file_uid "$guard_owner")" = "$owner_uid" ] || return 1
          guard_links=$(file_links "$guard_owner") || return 1
          case "$guard_links" in 1|2) ;; *) return 1 ;; esac
          if [ -e "$guard_lock" ] || [ -L "$guard_lock" ]; then
            [ -f "$guard_lock" ] && [ ! -L "$guard_lock" ] && \
              same_file "$guard_owner" "$guard_lock" || return 1
            rm -f "$guard_lock" 2>/dev/null || return 1
          elif [ "$guard_links" -ne 1 ]; then
            return 1
          fi
          rm -f "$guard_owner" 2>/dev/null || return 1
        elif [ -e "$guard_lock" ] || [ -L "$guard_lock" ]; then
          return 1
        fi
      done <"$guard_manifest"
      rm -f "$guard_manifest" 2>/dev/null
    }
    create_owner() {
      [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ] || return 1
      owner_tmp="${lock_path}.new.${owner_nonce}"
      [ ! -e "$owner_tmp" ] && [ ! -L "$owner_tmp" ] || return 1
      mkdir "$owner_tmp" 2>/dev/null || return 1
      chmod 700 "$owner_tmp" 2>/dev/null || return 1
      printf "%s\n" "$owner_pid" >"$owner_tmp/owner.pid" || return 1
      printf "%s\n" "$owner_nonce" >"$owner_tmp/owner.nonce" || return 1
      printf "%s\n" "$owner_birth" >"$owner_tmp/owner.birth" || return 1
      chmod 600 "$owner_tmp/owner.pid" "$owner_tmp/owner.nonce" "$owner_tmp/owner.birth" 2>/dev/null || return 1
      mv "$owner_tmp" "$lock_path" 2>/dev/null || return 1
    }
    if create_owner; then exit 0; fi
    [ -d "$lock_path" ] && [ ! -L "$lock_path" ] || exit 74
    lock_uid=$(file_uid "$lock_path") || exit 74
    [ "$lock_uid" = "$owner_uid" ] || exit 74
    for owner_file in owner.pid owner.nonce owner.birth; do
      [ -f "$lock_path/$owner_file" ] && [ ! -L "$lock_path/$owner_file" ] || exit 75
      owner_file_uid=$(file_uid "$lock_path/$owner_file") || exit 75
      owner_file_links=$(file_links "$lock_path/$owner_file") || exit 75
      [ "$owner_file_uid" = "$owner_uid" ] && [ "$owner_file_links" = 1 ] || exit 75
    done
    prior_pid=$(sed -n "1p" "$lock_path/owner.pid" 2>/dev/null || true)
    prior_nonce=$(sed -n "1p" "$lock_path/owner.nonce" 2>/dev/null || true)
    prior_birth=$(sed -n "1p" "$lock_path/owner.birth" 2>/dev/null || true)
    case "$prior_pid" in ""|*[!0-9]*) exit 75 ;; esac
    case "$prior_nonce" in ""|*[!A-Za-z0-9._-]*) exit 75 ;; esac
    [ -n "$prior_birth" ] || exit 75
    if kill -0 "$prior_pid" 2>/dev/null; then
      current_birth=$(birth_of "$prior_pid")
      [ -n "$current_birth" ] || exit 75
      [ "$current_birth" != "$prior_birth" ] || exit 75
    fi
    if [ -e "$lock_path/child.owner" ] || [ -L "$lock_path/child.owner" ]; then
      [ -f "$lock_path/child.owner" ] && [ ! -L "$lock_path/child.owner" ] || exit 75
      child_uid=$(file_uid "$lock_path/child.owner") || exit 75
      child_links=$(file_links "$lock_path/child.owner") || exit 75
      [ "$child_uid" = "$owner_uid" ] && [ "$child_links" = 1 ] || exit 75
      child_pid=$(sed -n "1p" "$lock_path/child.owner" 2>/dev/null || true)
      child_birth=$(sed -n "2p" "$lock_path/child.owner" 2>/dev/null || true)
      case "$child_pid" in ""|*[!0-9]*) exit 75 ;; esac
      [ -n "$child_birth" ] || exit 75
      if kill -0 "$child_pid" 2>/dev/null; then
        current_child_birth=$(birth_of "$child_pid")
        [ -n "$current_child_birth" ] || exit 75
        [ "$current_child_birth" != "$child_birth" ] || exit 75
      fi
    fi
    cleanup_guards || exit 74
    retired="${lock_path}.retired.${prior_nonce}"
    [ ! -e "$retired" ] && [ ! -L "$retired" ] || exit 74
    mv "$lock_path" "$retired" 2>/dev/null || exit 74
    [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ] || exit 74
    rm -f "$retired/owner.pid" "$retired/owner.nonce" "$retired/owner.birth" \
      "$retired/child.owner" "$retired/.child.ready.$prior_nonce" \
      "$retired/.child.owner.$prior_nonce" "$retired/.child.ready.tmp.$prior_nonce" \
      "$retired"/.child.ready."$prior_nonce".* \
      "$retired"/.child.owner."$prior_nonce".* \
      "$retired"/.child.ready.tmp."$prior_nonce".* \
      2>/dev/null || true
    rmdir "$retired" 2>/dev/null || true
    create_owner || exit 74
  '
  al_attempt=0
  while :; do
    if [ "$lock_backend" = lockf_lease ]; then
      lockf -k -s -t 0 "$lock_gate" /bin/sh -c "$al_gate_script" sh \
        "$lock_dir" "$$" "$lock_nonce" "$account_uid" "$lock_birth" "$stat_style"
      al_status=$?
    else
      flock -n "$lock_gate" /bin/sh -c "$al_gate_script" sh \
        "$lock_dir" "$$" "$lock_nonce" "$account_uid" "$lock_birth" "$stat_style"
      al_status=$?
    fi
    if [ "$al_status" -eq 0 ] && [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] && \
       [ "$(sed -n '1p' "$lock_dir/owner.pid" 2>/dev/null || true)" = "$$" ] && \
       [ "$(sed -n '1p' "$lock_dir/owner.nonce" 2>/dev/null || true)" = "$lock_nonce" ] && \
       [ "$(sed -n '1p' "$lock_dir/owner.birth" 2>/dev/null || true)" = "$lock_birth" ]; then
      lock_held=true
      umask "$old_umask"
      return 0
    fi
    al_attempt=$((al_attempt + 1))
    if [ "$al_attempt" -ge "$lock_attempts" ]; then
      umask "$old_umask"
      [ "$al_status" -eq 75 ] && return 2
      [ "$al_status" -eq 69 ] && return 3
      [ "$al_status" -eq 0 ] || return 2
      return 2
    fi
    sleep "$lock_sleep"
  done
}

release_lock() {
  [ "$lock_held" = true ] || return 0
  # A live configuration transaction owns registered Git locks and recovery
  # snapshots. Never remove that exclusion boundary before the transaction is
  # finalized or explicitly handed off as transaction_mode=none with its WAL.
  [ "$transaction_mode" = none ] || return 1
  cleanup_registered_config_locks "$lock_dir" "$lock_nonce" || return 1
  if [ "$lock_backend" = lockf_fd ] || [ "$lock_backend" = flock_fd ]; then
    remove_operation_lease || return 1
    [ "$lock_backend" != flock_fd ] || flock -u 9 2>/dev/null || return 1
    exec 9>&-
    lock_held=false
    lock_backend=
    lock_nonce=
    lock_birth=
    return 0
  fi
  rl_attempt=0
  while :; do
    if [ "$lock_backend" = lockf_lease ]; then
      lockf -k -s -t 0 "$lock_gate" /bin/sh -c '
        lock_path=$1
        owner_pid=$2
        owner_nonce=$3
        owner_birth=$4
        [ -d "$lock_path" ] && [ ! -L "$lock_path" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.pid" 2>/dev/null || true)" = "$owner_pid" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.nonce" 2>/dev/null || true)" = "$owner_nonce" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.birth" 2>/dev/null || true)" = "$owner_birth" ] || exit 1
        retired="${lock_path}.retired.${owner_nonce}"
        [ ! -e "$retired" ] && [ ! -L "$retired" ] || exit 1
        mv "$lock_path" "$retired" 2>/dev/null || exit 1
        [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ] || exit 1
        rm -f "$retired/owner.pid" "$retired/owner.nonce" "$retired/owner.birth" \
          "$retired/child.owner" "$retired/.child.ready.$owner_nonce" \
          "$retired/.child.owner.$owner_nonce" "$retired/.child.ready.tmp.$owner_nonce" \
          "$retired"/.child.ready."$owner_nonce".* \
          "$retired"/.child.owner."$owner_nonce".* \
          "$retired"/.child.ready.tmp."$owner_nonce".* \
          2>/dev/null || true
        rmdir "$retired" 2>/dev/null || true
      ' sh "$lock_dir" "$$" "$lock_nonce" "$lock_birth"
      rl_status=$?
    elif [ "$lock_backend" = flock ]; then
      flock -n "$lock_gate" /bin/sh -c '
        lock_path=$1
        owner_pid=$2
        owner_nonce=$3
        owner_birth=$4
        [ -d "$lock_path" ] && [ ! -L "$lock_path" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.pid" 2>/dev/null || true)" = "$owner_pid" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.nonce" 2>/dev/null || true)" = "$owner_nonce" ] || exit 1
        [ "$(sed -n "1p" "$lock_path/owner.birth" 2>/dev/null || true)" = "$owner_birth" ] || exit 1
        retired="${lock_path}.retired.${owner_nonce}"
        [ ! -e "$retired" ] && [ ! -L "$retired" ] || exit 1
        mv "$lock_path" "$retired" 2>/dev/null || exit 1
        [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ] || exit 1
        rm -f "$retired/owner.pid" "$retired/owner.nonce" "$retired/owner.birth" \
          "$retired/child.owner" "$retired/.child.ready.$owner_nonce" \
          "$retired/.child.owner.$owner_nonce" "$retired/.child.ready.tmp.$owner_nonce" \
          "$retired"/.child.ready."$owner_nonce".* \
          "$retired"/.child.owner."$owner_nonce".* \
          "$retired"/.child.ready.tmp."$owner_nonce".* \
          2>/dev/null || true
        rmdir "$retired" 2>/dev/null || true
      ' sh "$lock_dir" "$$" "$lock_nonce" "$lock_birth"
      rl_status=$?
    else
      return 1
    fi
    if [ "$rl_status" -eq 0 ]; then
      lock_held=false
      lock_backend=
      lock_nonce=
      lock_birth=
      return 0
    fi
    rl_attempt=$((rl_attempt + 1))
    [ "$rl_attempt" -lt "$lock_attempts" ] || return 1
    sleep "$lock_sleep"
  done
}

switch_account_config() {
  sac_user=$1
  stored_account "$sac_user" || return 4
  run_tracked gh auth switch --hostname "$host" --user "$sac_user" >/dev/null 2>&1 || return 1
  refresh_accounts || return 1
  sac_active=$(active_account)
  [ "$(printf '%s' "$sac_active" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$sac_user" | tr '[:upper:]' '[:lower:]')" ]
}

restore_quarantine_target() {
  [ -e "$restore_failure_file" ] || [ -L "$restore_failure_file" ] || return 1
  [ -f "$restore_failure_file" ] && [ ! -L "$restore_failure_file" ] || return 2
  [ "$(path_uid "$restore_failure_file")" = "$account_uid" ] && \
    [ "$(path_links "$restore_failure_file")" = 1 ] || return 2
  rqt_target=$(sed -n '1p' "$restore_failure_file" 2>/dev/null || true)
  validate_login "$rqt_target" || return 2
  printf '%s\n' "$rqt_target"
}

write_restore_quarantine() {
  wrq_target=$1
  validate_login "$wrq_target" || return 1
  [ -d "$state_root" ] && [ ! -L "$state_root" ] && \
    [ "$(path_uid "$state_root")" = "$account_uid" ] || return 1
  wrq_tmp="$state_root/.restore.failed.$lock_nonce"
  [ ! -e "$wrq_tmp" ] && [ ! -L "$wrq_tmp" ] || return 1
  (set -C; printf '%s\n' "$wrq_target" >"$wrq_tmp") 2>/dev/null || return 1
  chmod 600 "$wrq_tmp" 2>/dev/null || return 1
  run_tracked mv "$wrq_tmp" "$restore_failure_file" 2>/dev/null
}

clear_restore_quarantine() {
  [ -e "$restore_failure_file" ] || return 0
  [ -f "$restore_failure_file" ] && [ ! -L "$restore_failure_file" ] || return 1
  [ "$(path_uid "$restore_failure_file")" = "$account_uid" ] && \
    [ "$(path_links "$restore_failure_file")" = 1 ] || return 1
  run_tracked rm -f "$restore_failure_file" 2>/dev/null
}

operation_in_progress() {
  [ "$lock_held" = false ] || return 1
  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  [ "$(path_uid "$lock_dir")" = "$account_uid" ] || return 1
  for oip_file in owner.pid owner.birth; do
    [ -f "$lock_dir/$oip_file" ] && [ ! -L "$lock_dir/$oip_file" ] || return 1
    [ "$(path_uid "$lock_dir/$oip_file")" = "$account_uid" ] && \
      [ "$(path_links "$lock_dir/$oip_file")" = 1 ] || return 1
  done
  oip_pid=$(sed -n '1p' "$lock_dir/owner.pid" 2>/dev/null || true)
  oip_birth=$(sed -n '1p' "$lock_dir/owner.birth" 2>/dev/null || true)
  lease_process_matches "$oip_pid" "$oip_birth"
}

classify_network_error() {
  cne_file=$1
  last_network_failure=
  [ -f "$cne_file" ] && [ ! -L "$cne_file" ] || return 1
  if grep -Eqi 'timed? ?out|timeout|deadline exceeded' "$cne_file"; then
    last_network_failure=NETWORK.TIMEOUT
  elif grep -Eqi 'could not resolve|name or service not known|no such host|temporary failure in name resolution' "$cne_file"; then
    last_network_failure=NETWORK.DNS
  elif grep -Eqi 'proxy|http 407' "$cne_file"; then
    last_network_failure=NETWORK.PROXY
  elif grep -Eqi 'tls|ssl|x509|certificate|certificate verify' "$cne_file"; then
    last_network_failure=NETWORK.TLS
  elif grep -Eqi '(^|[^0-9])429([^0-9]|$)|rate[ -]?limit|secondary rate limit|too many requests' "$cne_file"; then
    last_network_failure=NETWORK.RATE_LIMIT
  elif grep -Eqi '(^|[^0-9])(500|502|503|504)([^0-9]|$)|service unavailable|bad gateway|gateway timeout|internal server error' "$cne_file"; then
    last_network_failure=NETWORK.SERVICE_UNAVAILABLE
  elif grep -Eqi 'failed to connect|connection (refused|reset|closed|aborted)|network is unreachable|unexpected eof|empty reply from server' "$cne_file"; then
    last_network_failure=NETWORK.TRANSPORT
  else
    return 1
  fi
}

add_last_network_finding() {
  case "$last_network_failure" in
    NETWORK.TIMEOUT) add_finding NETWORK.TIMEOUT error "GitHub API request timed out; credential invalidity is not proven" false false true ;;
    NETWORK.DNS) add_finding NETWORK.DNS error "GitHub API hostname resolution failed; credential invalidity is not proven" false false true ;;
    NETWORK.PROXY) add_finding NETWORK.PROXY error "GitHub API proxy negotiation failed; credential invalidity is not proven" false false true ;;
    NETWORK.TLS) add_finding NETWORK.TLS error "GitHub API TLS verification failed; credential invalidity is not proven" false false true ;;
    NETWORK.RATE_LIMIT) add_finding NETWORK.RATE_LIMIT error "GitHub API rate limiting prevented authoritative verification; credential invalidity is not proven" false false true ;;
    NETWORK.SERVICE_UNAVAILABLE) add_finding NETWORK.SERVICE_UNAVAILABLE error "GitHub API service availability prevented authoritative verification; credential invalidity is not proven" false false true ;;
    NETWORK.TRANSPORT) add_finding NETWORK.TRANSPORT error "GitHub API transport failed; credential invalidity is not proven" false false true ;;
    *) return 1 ;;
  esac
}

verify_effective_identity() {
  vei_user=$1
  last_network_failure=
  make_temp || return 1
  vei_error=$new_temp_path
  make_temp || return 1
  vei_output=$new_temp_path
  if [ "$lock_held" = true ]; then
    run_tracked gh api user --hostname "$host" >"$vei_output" 2>"$vei_error"
  else
    gh api user --hostname "$host" >"$vei_output" 2>"$vei_error"
  fi
  vei_status=$?
  if [ "$vei_status" -ne 0 ]; then
    classify_network_error "$vei_error" || true
    return 1
  fi
  vei_profile=$(cat "$vei_output") || return 1
  vei_login=$(printf '%s\n' "$vei_profile" | jq -r '.login // empty' 2>/dev/null) || return 1
  [ "$(printf '%s' "$vei_login" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$vei_user" | tr '[:upper:]' '[:lower:]')" ]
}

begin_operation() {
  bo_user=$1
  bo_allow_unhealthy=$2
  bo_allow_no_active=${3:-false}
  assert_no_token_override
  acquire_lock
  bo_lock_status=$?
  if [ "$bo_lock_status" -ne 0 ]; then
    [ "$bo_lock_status" -ne 1 ] || return 8
    return "$bo_lock_status"
  fi
  if ! recover_pending_transaction; then
    transaction_mode=none
    release_lock || true
    return 6
  fi
  if ! refresh_accounts; then
    release_lock || true
    return 1
  fi
  if ! stored_account "$bo_user"; then
    release_lock || true
    return 4
  fi
  if [ "$bo_allow_unhealthy" != true ] && ! usable_account "$bo_user"; then
    release_lock || true
    return 4
  fi
  bo_quarantine=$(restore_quarantine_target 2>/dev/null)
  bo_quarantine_status=$?
  if [ "$bo_quarantine_status" -eq 0 ]; then
    bo_requested=$(printf '%s' "$bo_user" | tr '[:upper:]' '[:lower:]')
    bo_recovery=$(printf '%s' "$bo_quarantine" | tr '[:upper:]' '[:lower:]')
    if [ "$bo_requested" != "$bo_recovery" ]; then
      release_lock || true
      return 5
    fi
    recovery_pending=true
    restore_required=false
    restore_account=
    switch_account_config "$bo_quarantine" || { release_lock || true; return 5; }
    if [ "$bo_allow_unhealthy" != true ]; then
      verify_effective_identity "$bo_quarantine" || { release_lock || true; return 5; }
      clear_restore_quarantine || { release_lock || true; return 5; }
      recovery_pending=false
      restoration_status=recovered
    fi
    return 0
  elif [ "$bo_quarantine_status" -eq 2 ]; then
    release_lock || true
    return 5
  fi
  bo_active_count=$(active_count)
  if [ "$bo_active_count" -ne 1 ]; then
    if [ "$bo_active_count" -ne 0 ] || [ "$bo_allow_no_active" != true ]; then
      release_lock || true
      return 7
    fi
  fi
  restore_account=$(active_account)
  if [ "$(printf '%s' "$restore_account" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$bo_user" | tr '[:upper:]' '[:lower:]')" ]; then
    if [ -n "$restore_account" ]; then
      restore_required=true
      if ! write_restore_quarantine "$restore_account"; then
        restore_required=false
        release_lock || true
        return 1
      fi
    fi
    switch_account_config "$bo_user"
    bo_switch_status=$?
    if [ "$bo_switch_status" -ne 0 ]; then
      bo_cleanup_failed=false
      [ "$restore_required" = false ] || restore_previous || bo_cleanup_failed=true
      release_lock || bo_cleanup_failed=true
      [ "$bo_cleanup_failed" = false ] || return 5
      return "$bo_switch_status"
    fi
  fi
  return 0
}

restore_previous() {
  [ "$restore_required" = true ] || { restoration_status=not-required; return 0; }
  rp_target=$restore_account
  [ -n "$rp_target" ] || { restoration_status=failed; return 1; }
  rp_attempt=0
  while [ "$rp_attempt" -lt 3 ]; do
    if run_tracked gh auth switch --hostname "$host" --user "$rp_target" >/dev/null 2>&1 && refresh_accounts; then
      rp_active=$(active_account)
      if [ "$(printf '%s' "$rp_active" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$rp_target" | tr '[:upper:]' '[:lower:]')" ]; then
        if clear_restore_quarantine; then
          restore_required=false
          restoration_status=restored
          return 0
        fi
        break
      fi
    fi
    rp_attempt=$((rp_attempt + 1))
  done
  write_restore_quarantine "$rp_target" || true
  restore_required=false
  restoration_status=failed
  printf '%s: critical: failed to restore previous account %s\n' "$program" "$rp_target" >&2
  return 1
}

finalize_transaction_before_unlock() {
  [ "$transaction_mode" != none ] || return 0
  [ "$lock_held" = true ] || return 1
  ftbu_failed=false
  case "$transaction_mode" in
    binding)
      rollback_binding_transaction || ftbu_failed=true
      ;;
    repair)
      rollback_binding_transaction || ftbu_failed=true
      rollback_repair_global || ftbu_failed=true
      ;;
    binding_committed)
      # The committed WAL makes the persistent account and repository binding
      # one outcome. Complete only its metadata cleanup; never restore one half.
      restore_required=false
      restoration_status=not-required
      clear_restore_quarantine || ftbu_failed=true
      ;;
    *) ftbu_failed=true ;;
  esac
  if [ "$ftbu_failed" = false ]; then
    clear_transaction_journal || ftbu_failed=true
  fi
  if [ "$ftbu_failed" = false ]; then
    transaction_mode=none
    clear_binding_transaction_state
    return 0
  fi
  printf '%s: critical: Git configuration transaction could not be finalized while locked; recovery metadata was preserved\n' \
    "$program" >&2
  return 1
}

finish_operation() {
  fo_status=$1
  last_finish_lock_failed=false
  fo_transaction_failed=false
  fo_restore_failed=false
  fo_release_failed=false
  finalize_transaction_before_unlock || fo_transaction_failed=true
  restore_previous || fo_restore_failed=true
  release_lock || {
    fo_release_failed=true
  }
  if [ "$fo_transaction_failed" = true ] || [ "$fo_restore_failed" = true ] || \
     [ "$fo_release_failed" = true ]; then
    last_finish_lock_failed=$fo_release_failed
    printf '%s: critical: routed-operation cleanup failed; recovery is required before retrying\n' \
      "$program" >&2
    fo_status=$EXIT_TEMPFAIL
  fi
  return "$fo_status"
}

select_terminal_handoff_backend() {
  terminal_handoff_backend=
  if [ -x /usr/bin/perl ]; then
    terminal_handoff_backend=perl
  elif [ -x /usr/bin/python3 ]; then
    terminal_handoff_backend=python3
  elif command_exists perl; then
    terminal_handoff_backend=perl-path
  elif command_exists python3; then
    terminal_handoff_backend=python3-path
  else
    return 1
  fi
  return 0
}

terminal_set_foreground_group() {
  tsfg_group=$1
  case "$tsfg_group" in ''|*[!0-9]*) return 1 ;; esac
  case "$terminal_handoff_backend" in
    perl)
      /usr/bin/perl -MPOSIX -e '
        $group = int($ARGV[0]);
        $result = POSIX::tcsetpgrp(0, $group);
        exit((defined($result) && $result == 0) ? 0 : 1);
      ' "$tsfg_group"
      ;;
    perl-path)
      perl -MPOSIX -e '
        $group = int($ARGV[0]);
        $result = POSIX::tcsetpgrp(0, $group);
        exit((defined($result) && $result == 0) ? 0 : 1);
      ' "$tsfg_group"
      ;;
    python3)
      /usr/bin/python3 -c \
        'import os, sys; os.tcsetpgrp(0, int(sys.argv[1]))' "$tsfg_group"
      ;;
    python3-path)
      python3 -c \
        'import os, sys; os.tcsetpgrp(0, int(sys.argv[1]))' "$tsfg_group"
      ;;
    *) return 1 ;;
  esac
}

restore_terminal_foreground() {
  [ "$terminal_handoff_active" = true ] || return 0
  rtf_group=$terminal_parent_group
  terminal_handoff_active=false
  terminal_parent_group=
  trap '' TTOU
  terminal_set_foreground_group "$rtf_group"
  rtf_status=$?
  trap - TTOU
  return "$rtf_status"
}

run_tracked() {
  rt_parent_pid=$$
  rt_interactive=$tracked_interactive_mode
  rt_handoff=false
  if [ "$rt_interactive" = true ] && [ -t 0 ]; then
    select_terminal_handoff_backend || return "$EXIT_UNAVAILABLE"
    rt_handoff=true
  fi
  make_temp || return "$EXIT_TEMPFAIL"
  rt_invocation=$(basename "$new_temp_path")
  if [ "$lock_held" = true ] && [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ]; then
    rt_ready="$lock_dir/.child.ready.$lock_nonce.$rt_invocation"
    rt_owner_tmp="$lock_dir/.child.owner.$lock_nonce.$rt_invocation"
    rt_ready_tmp="$lock_dir/.child.ready.tmp.$lock_nonce.$rt_invocation"
  else
    rt_ready="$temp_root/.child.ready.$rt_invocation"
    rt_owner_tmp=
    rt_ready_tmp="$temp_root/.child.ready.tmp.$rt_invocation"
  fi
  # A private job-control process group keeps the supervisor alive as a stable
  # identity while the command and every ordinary descendant are running. The
  # supervisor does not exit until the group is empty, so account restoration
  # and lock release cannot race a surviving Git/gh helper process.
  child_registration_in_progress=true
  pending_child_signal=
  set -m 2>/dev/null || {
    child_registration_in_progress=false
    rt_pending_signal=$pending_child_signal
    pending_child_signal=
    [ -z "$rt_pending_signal" ] || handle_signal "$rt_pending_signal"
    return "$EXIT_UNAVAILABLE"
  }
  "$supervisor_shell" -c '
    ready=$1
    parent_pid=$2
    tempfail=$3
    grace_seconds=$4
    interactive=$5
    shift 5

    # An interactive supervisor becomes a stopped, command-free process-group
    # anchor before it can observe the start gate. The parent validates this
    # exact state and performs tcsetpgrp before publishing readiness.
    [ "$interactive" != true ] || kill -STOP "$$"

    if [ -n "$ready" ]; then
      ready_attempt=0
      while [ ! -f "$ready" ] || [ -L "$ready" ]; do
        kill -0 "$parent_pid" 2>/dev/null || exit "$tempfail"
        ready_attempt=$((ready_attempt + 1))
        [ "$ready_attempt" -lt 1000 ] || exit "$tempfail"
        sleep 0.01
      done
    fi

    set +m 2>/dev/null || true
    supervisor_signal=
    trap "supervisor_signal=HUP; trap \"\" HUP INT TERM; kill -HUP \"$parent_pid\" 2>/dev/null || true" HUP
    trap "supervisor_signal=INT; trap \"\" HUP INT TERM; kill -TERM -- \"-$$\" 2>/dev/null || true; kill -INT \"$parent_pid\" 2>/dev/null || true" INT
    trap "supervisor_signal=TERM; trap \"\" HUP INT TERM; kill -TERM \"$parent_pid\" 2>/dev/null || true" TERM
    "$@" <&3 &
    command_pid=$!
    while kill -0 "$command_pid" 2>/dev/null; do
      wait "$command_pid" 2>/dev/null
      command_status=$?
    done
    wait "$command_pid" 2>/dev/null
    final_wait_status=$?
    case "${command_status-}" in ""|127) command_status=$final_wait_status ;; esac

    trap "" HUP INT TERM
    refresh_group_members() {
      group_failure_reason=ps-snapshot
      # stat= is included so exited-but-unreaped members (state Z) are not
      # counted as live: a zombie still answers kill -0 and still lists its
      # pgid, but can never run again. Without this, any host whose PID 1
      # does not reap orphans (a container started without --init) pins the
      # group forever after the parent dies, and the stale lease can never be
      # reclaimed.
      group_processes=$(ps -axo pid=,pgid=,stat= 2>/dev/null) || return 2
      group_failure_reason=ps-shape
      group_candidates=$(printf "%s\n" "$group_processes" | awk -v group="$$" \
        "
          NF != 3 || \$1 !~ /^[0-9]+$/ || \$2 !~ /^[0-9]+$/ { malformed = 1 }
          \$1 == group && \$2 == group { self_rows++ }
          \$2 == group && \$1 != group && \$3 !~ /^Z/ { print \$1 }
          END { if (malformed || self_rows != 1) exit 2 }
        ") || return 2
      remaining=
      for candidate_pid in $group_candidates; do
        kill -0 "$candidate_pid" 2>/dev/null || continue
        group_failure_reason=member-query
        candidate_group=$(ps -o pgid= -p "$candidate_pid" 2>/dev/null | tr -d "[:space:]") || {
          kill -0 "$candidate_pid" 2>/dev/null && return 2
          continue
        }
        # procps answers `ps -p <pid>` for a process that exits between the
        # snapshot and this query with exit 0 and NO output (found in the
        # /proc scan, gone before its stat could be read); BSD ps does not.
        # A member that has vanished is not a member: re-confirm with kill -0
        # and drop it. Only a still-live process that cannot be classified is
        # a real inspection failure worth failing closed on.
        if [ -z "$candidate_group" ]; then
          kill -0 "$candidate_pid" 2>/dev/null || continue
          candidate_group=$(ps -o pgid= -p "$candidate_pid" 2>/dev/null | tr -d "[:space:]") || {
            kill -0 "$candidate_pid" 2>/dev/null && return 2
            continue
          }
          [ -n "$candidate_group" ] || { kill -0 "$candidate_pid" 2>/dev/null && return 2; continue; }
        fi
        case "$candidate_group" in *[!0-9]*) return 2 ;; esac
        [ "$candidate_group" = "$$" ] || continue
        if [ -n "$remaining" ]; then
          remaining="$remaining $candidate_pid"
        else
          remaining=$candidate_pid
        fi
      done
      group_failure_reason=
    }
    fail_closed_group_cleanup() {
      trap "" HUP INT TERM
      printf "gh-account: tracked process-group inspection failed safely (%s)\n" \
        "${group_failure_reason:-unknown}" >&2
      kill -KILL -- "-$$" 2>/dev/null || exit "$tempfail"
      exit "$tempfail"
    }
    # A single empty process-table snapshot is not a stable boundary: a child
    # observed in that snapshot can fork while it exits. Require two complete,
    # validated empty snapshots with a scheduling interval between them, and
    # restart cleanup if a late group member appears during that interval.
    cleanup_started=false
    cleanup_attempt=0
    grace_attempts=$((grace_seconds * 10))
    empty_snapshots=0
    while :; do
      refresh_group_members || fail_closed_group_cleanup
      if [ -z "$remaining" ]; then
        empty_snapshots=$((empty_snapshots + 1))
        [ "$empty_snapshots" -ge 2 ] && break
        sleep 0.1
        continue
      fi
      empty_snapshots=0
      if [ "$cleanup_started" = false ]; then
        kill -TERM -- "-$$" 2>/dev/null || true
        cleanup_started=true
      fi
      if [ "$cleanup_attempt" -lt "$grace_attempts" ]; then
        cleanup_attempt=$((cleanup_attempt + 1))
      else
        for member_pid in $remaining; do
          member_group=$(ps -o pgid= -p "$member_pid" 2>/dev/null | tr -d "[:space:]")
          [ "$member_group" = "$$" ] || continue
          kill -KILL "$member_pid" 2>/dev/null || true
        done
      fi
      sleep 0.1
    done
    exit "$command_status"
  ' gh-account-supervisor "$rt_ready" "$rt_parent_pid" "$EXIT_TEMPFAIL" \
    "$signal_grace" "$rt_handoff" "$@" 3<&0 &
  active_child_pid=$!
  active_child_birth=$(process_birth "$active_child_pid" 2>/dev/null || true)
  rt_group=$(LC_ALL=C ps -o pgid= -p "$active_child_pid" 2>/dev/null | \
    tr -d '[:space:]')
  if [ -z "$active_child_birth" ] || [ "$rt_group" != "$active_child_pid" ]; then
    kill -KILL "$active_child_pid" 2>/dev/null || true
    wait "$active_child_pid" 2>/dev/null || true
    active_child_pid=
    active_child_birth=
    child_registration_in_progress=false
    rt_pending_signal=$pending_child_signal
    pending_child_signal=
    set +m 2>/dev/null || true
    [ -z "$rt_pending_signal" ] || handle_signal "$rt_pending_signal"
    return "$EXIT_UNAVAILABLE"
  fi
  rt_registration_failed=false
  rt_failure_status=$EXIT_TEMPFAIL
  if [ "$lock_held" = true ]; then
    if ! (set -C; printf '%s\n%s\n' "$active_child_pid" "$active_child_birth" >"$rt_owner_tmp") 2>/dev/null || \
       ! chmod 600 "$rt_owner_tmp" 2>/dev/null || \
       ! mv "$rt_owner_tmp" "$lock_dir/child.owner" 2>/dev/null; then
      rt_registration_failed=true
    fi
  fi
  if [ "$rt_registration_failed" = false ]; then
    if ! (set -C; : >"$rt_ready_tmp") 2>/dev/null || \
       ! chmod 600 "$rt_ready_tmp" 2>/dev/null; then
      rt_registration_failed=true
    fi
  fi
  if [ "$rt_registration_failed" = false ] && [ "$rt_handoff" = true ]; then
    rt_stop_attempt=0
    while :; do
      if [ -n "$pending_child_signal" ]; then
        rt_registration_failed=true
        break
      fi
      rt_current_birth=$(process_birth "$active_child_pid" 2>/dev/null || true)
      rt_state=$(LC_ALL=C ps -o stat= -p "$active_child_pid" 2>/dev/null | \
        tr -d '[:space:]')
      if [ "$rt_current_birth" != "$active_child_birth" ] || [ -z "$rt_state" ]; then
        rt_registration_failed=true
        rt_failure_status=$EXIT_UNAVAILABLE
        break
      fi
      case "$rt_state" in *T*) break ;; esac
      rt_stop_attempt=$((rt_stop_attempt + 1))
      if [ "$rt_stop_attempt" -ge 1000 ]; then
        rt_registration_failed=true
        rt_failure_status=$EXIT_UNAVAILABLE
        break
      fi
      sleep 0.01
    done
  fi
  if [ "$rt_registration_failed" = false ] && [ "$rt_handoff" = true ]; then
    rt_parent_group=$(LC_ALL=C ps -o pgid= -p "$$" 2>/dev/null | tr -d '[:space:]')
    rt_terminal_group=$(LC_ALL=C ps -o tpgid= -p "$$" 2>/dev/null | tr -d '[:space:]')
    case "$rt_parent_group:$rt_terminal_group" in
      *[!0-9:]*|:|*:)
        rt_registration_failed=true
        rt_failure_status=$EXIT_UNAVAILABLE
        ;;
      *)
        if [ "$rt_parent_group" != "$rt_terminal_group" ]; then
          rt_registration_failed=true
          rt_failure_status=$EXIT_UNAVAILABLE
        fi
        ;;
    esac
  fi
  if [ "$rt_registration_failed" = false ] && [ "$rt_handoff" = true ]; then
    set +m 2>/dev/null || true
    trap '' TTOU
    if terminal_set_foreground_group "$active_child_pid"; then
      terminal_parent_group=$rt_parent_group
      terminal_handoff_active=true
      rt_child_terminal_group=$(LC_ALL=C ps -o tpgid= -p "$active_child_pid" \
        2>/dev/null | tr -d '[:space:]')
      if [ "$rt_child_terminal_group" != "$active_child_pid" ]; then
        rt_registration_failed=true
        rt_failure_status=$EXIT_UNAVAILABLE
      fi
    else
      rt_registration_failed=true
      rt_failure_status=$EXIT_UNAVAILABLE
    fi
    trap - TTOU
  fi
  if [ "$rt_registration_failed" = true ]; then
    child_registration_in_progress=false
    rt_pending_signal=$pending_child_signal
    pending_child_signal=
    kill -KILL -- "-$active_child_pid" 2>/dev/null || true
    wait "$active_child_pid" 2>/dev/null || true
    restore_terminal_foreground 2>/dev/null || true
    [ -z "$rt_owner_tmp" ] || rm -f "$rt_owner_tmp" 2>/dev/null || true
    rm -f "$rt_ready_tmp" "$rt_ready" "$lock_dir/child.owner" 2>/dev/null || true
    active_child_pid=
    active_child_birth=
    set +m 2>/dev/null || true
    [ -z "$rt_pending_signal" ] || handle_signal "$rt_pending_signal"
    return "$rt_failure_status"
  fi
  # Once registration and any terminal handoff are complete, signal handling
  # may safely target the verified supervisor group. A deferred signal is
  # honored before the unique start gate can release the command.
  child_registration_in_progress=false
  rt_pending_signal=$pending_child_signal
  pending_child_signal=
  if [ -n "$rt_pending_signal" ]; then
    rm -f "$rt_ready_tmp" 2>/dev/null || true
    handle_signal "$rt_pending_signal"
  fi
  if ! mv "$rt_ready_tmp" "$rt_ready" 2>/dev/null; then
    kill -KILL -- "-$active_child_pid" 2>/dev/null || true
    wait "$active_child_pid" 2>/dev/null || true
    restore_terminal_foreground 2>/dev/null || true
    [ -z "$rt_owner_tmp" ] || rm -f "$rt_owner_tmp" 2>/dev/null || true
    rm -f "$rt_ready_tmp" "$rt_ready" "$lock_dir/child.owner" 2>/dev/null || true
    active_child_pid=
    active_child_birth=
    set +m 2>/dev/null || true
    return "$EXIT_TEMPFAIL"
  fi
  if [ "$rt_handoff" = true ]; then
    kill -CONT -- "-$active_child_pid" 2>/dev/null || {
      kill -KILL -- "-$active_child_pid" 2>/dev/null || true
      wait "$active_child_pid" 2>/dev/null || true
      restore_terminal_foreground 2>/dev/null || true
      active_child_pid=
      active_child_birth=
      return "$EXIT_TEMPFAIL"
    }
  fi
  set +m 2>/dev/null || true
  wait "$active_child_pid"
  rt_status=$?
  if ! restore_terminal_foreground; then
    rt_status=$EXIT_TEMPFAIL
  fi
  if [ "$lock_held" = true ] && [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ]; then
    rm -f "$rt_ready" "$lock_dir/child.owner" 2>/dev/null || true
  else
    rm -f "$rt_ready" 2>/dev/null || true
  fi
  active_child_pid=
  active_child_birth=
  return "$rt_status"
}

run_tracked_interactive() {
  rti_saved_mode=$tracked_interactive_mode
  tracked_interactive_mode=true
  run_tracked "$@"
  rti_status=$?
  tracked_interactive_mode=$rti_saved_mode
  return "$rti_status"
}

terminate_active_child() {
  tac_signal=$1
  case "$active_child_pid" in ''|*[!0-9]*) return 0 ;; esac
  [ -n "$active_child_birth" ] || return 0
  tac_pid=$active_child_pid
  tac_birth=$active_child_birth
  tac_current_birth=$(process_birth "$tac_pid" 2>/dev/null || true)
  if [ "$tac_current_birth" = "$tac_birth" ]; then
    kill -"$tac_signal" -- "-$tac_pid" 2>/dev/null || true
    # A registered interactive supervisor may still be in its pre-start STOP.
    # Resume the group only after the terminating signal is pending; the
    # unpublished ready gate still prevents the native auth command starting.
    [ "$terminal_handoff_active" != true ] || \
      kill -CONT -- "-$tac_pid" 2>/dev/null || true
    tac_cancel=
    if make_temp; then
      tac_cancel=$new_temp_path
      : >"$tac_cancel" 2>/dev/null || tac_cancel=
    fi
    (
      # Cancellation uses a private marker rather than a signal disposition:
      # ignored signals may remain ignored across a fork/exec boundary. Before
      # escalation, prove the anchored group leader still has the same birth.
      tac_watch_attempt=0
      tac_watch_limit=$((signal_grace * 10))
      while [ "$tac_watch_attempt" -lt "$tac_watch_limit" ]; do
        [ -n "$tac_cancel" ] && [ -s "$tac_cancel" ] && exit 0
        sleep 0.1
        tac_watch_attempt=$((tac_watch_attempt + 1))
      done
      tac_watch_birth=$(process_birth "$tac_pid" 2>/dev/null || true)
      [ "$tac_watch_birth" = "$tac_birth" ] || exit 0
      kill -KILL -- "-$tac_pid" 2>/dev/null || true
    ) &
    tac_watchdog=$!
  else
    tac_watchdog=
  fi
  wait "$tac_pid" 2>/dev/null || true
  if [ -n "$tac_watchdog" ]; then
    [ -z "$tac_cancel" ] || printf 'cancelled\n' >"$tac_cancel" 2>/dev/null || true
    wait "$tac_watchdog" 2>/dev/null || true
    [ -z "$tac_cancel" ] || rm -f "$tac_cancel" 2>/dev/null || true
  fi
  active_child_pid=
  active_child_birth=
}

handle_signal() {
  hs_signal=$1
  # A signal may arrive after the supervisor was forked but before its PID,
  # birth identity, ownership record, and invocation-unique ready gate were
  # published. Defer it until registration has either completed or failed;
  # the waiting supervisor cannot start the command before that point.
  if [ "$child_registration_in_progress" = true ]; then
    pending_child_signal=$hs_signal
    return 0
  fi
  # Ignore repeated termination signals until the child has stopped and the
  # EXIT trap has restored config/account state and released the operation lock.
  trap '' HUP INT TERM
  hs_child_signal=$hs_signal
  # POSIX async commands may inherit SIGINT as ignored. Translate interactive
  # cancellation to TERM for the verified supervisor group so native auth and
  # its ordinary descendants stop immediately instead of gaining a watchdog
  # window in which credentials or configuration could still mutate.
  [ "$hs_child_signal" != INT ] || hs_child_signal=TERM
  terminate_active_child "$hs_child_signal"
  restore_terminal_foreground 2>/dev/null || true
  exit 2
}

final_cleanup() {
  fc_status=$?
  trap '' HUP INT TERM
  trap - 0
  restore_terminal_foreground 2>/dev/null || true
  fc_transaction_failed=false
  fc_had_transaction=false
  case "$transaction_mode" in
    repair)
      fc_had_transaction=true
      rollback_binding_transaction || fc_transaction_failed=true
      rollback_repair_global || fc_transaction_failed=true
      ;;
    binding)
      fc_had_transaction=true
      rollback_binding_transaction || fc_transaction_failed=true
      ;;
    binding_committed)
      # The durable commit marker makes the selected account and binding one
      # logical outcome. Never restore one half after that point.
      restore_required=false
      restoration_status=not-required
      if clear_restore_quarantine; then
        clear_transaction_journal || fc_transaction_failed=true
      else
        fc_transaction_failed=true
      fi
      if [ "$fc_transaction_failed" = false ]; then
        transaction_mode=none
        clear_binding_transaction_state
      fi
      ;;
  esac
  if [ "$fc_had_transaction" = true ] && [ "$fc_transaction_failed" = false ]; then
    clear_transaction_journal || fc_transaction_failed=true
  fi
  if [ "$fc_transaction_failed" = true ]; then
    printf '%s: critical: Git configuration cleanup was incomplete; recovery metadata was preserved\n' \
      "$program" >&2
    fc_status=$EXIT_TEMPFAIL
  fi
  if [ "$restore_required" = true ]; then
    if ! restore_previous; then
      printf '%s: critical: account restoration failed during cleanup\n' "$program" >&2
      fc_status=$EXIT_TEMPFAIL
    fi
  fi
  if [ "$lock_held" = true ]; then
    if ! release_lock; then
      printf '%s: critical: operation lock release failed during cleanup\n' "$program" >&2
      fc_status=$EXIT_TEMPFAIL
    fi
  fi
  # Recovery snapshots are the write-ahead log's payload. Never delete them
  # while a journal remains after a failed or interrupted rollback.
  if [ ! -e "$transaction_journal" ] && [ ! -L "$transaction_journal" ]; then
    cleanup_temps
  fi
  exit "$fc_status"
}

resolve_active_identity() {
  rai_user=$1
  last_network_failure=
  make_temp || return 1
  rai_error=$new_temp_path
  make_temp || return 1
  rai_output=$new_temp_path
  if [ "$lock_held" = true ]; then
    run_tracked gh api user --hostname "$host" >"$rai_output" 2>"$rai_error"
  else
    gh api user --hostname "$host" >"$rai_output" 2>"$rai_error"
  fi
  rai_status=$?
  if [ "$rai_status" -ne 0 ]; then
    classify_network_error "$rai_error" || true
    return 1
  fi
  rai_profile=$(cat "$rai_output") || return 1
  identity_login=$(printf '%s\n' "$rai_profile" | jq -r '.login // empty')
  # Sanitize the profile display name only: strip control characters, trim
  # surrounding whitespace, and collapse a blank result to the empty string so
  # the login fallback below can take over. The POSIX [[:cntrl:]] class is used
  # deliberately: the \uXXXX bracket-escape form matches EVERY character under
  # jq-1.7.1-apple's Oniguruma engine, which silently rewrote real names to
  # runs of spaces and produced an unusable whitespace-only user.name.
  identity_name=$(printf '%s\n' "$rai_profile" | jq -r '(.name // "") | gsub("[[:cntrl:]]"; " ") | sub("^\\s+"; "") | sub("\\s+$"; "") | if test("^\\s*$") then "" else . end')
  identity_id=$(printf '%s\n' "$rai_profile" | jq -r '.id // empty')
  validate_login "$identity_login" || return 1
  [ "$(printf '%s' "$identity_login" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$rai_user" | tr '[:upper:]' '[:lower:]')" ] || return 1
  case "$identity_id" in ''|*[!0-9]*) return 1 ;; esac
  # Never write an empty or whitespace-only commit name: fall back to the
  # account login, which validate_login has already confirmed is well-formed.
  case $identity_name in
    *[![:space:]]*) ;;
    *) identity_name=$identity_login ;;
  esac
  if [ "$host" = github.com ]; then
    identity_email="${identity_id}+${identity_login}@users.noreply.github.com"
  else
    identity_email="${identity_id}+${identity_login}@users.noreply.${host}"
  fi
}

snapshot_local_key() {
  slk_repo=$1
  slk_key=$2
  make_temp || return 1
  slk_values=$new_temp_path
  make_temp || return 1
  config_snapshot_file=$new_temp_path
  git -C "$slk_repo" config --local --get-all "$slk_key" >"$slk_values" 2>/dev/null
  slk_status=$?
  case "$slk_status" in
    0) printf 'true\n' >"$config_snapshot_file"; cat "$slk_values" >>"$config_snapshot_file" ;;
    1) printf 'false\n' >"$config_snapshot_file" ;;
    *) return 1 ;;
  esac
}

restore_local_snapshot() {
  rls_repo=$1
  rls_key=$2
  rls_snapshot=$3
  rls_present=$(sed -n '1p' "$rls_snapshot")
  git -C "$rls_repo" config --local --unset-all "$rls_key" >/dev/null 2>&1
  rls_unset=$?
  [ "$rls_unset" -eq 0 ] || [ "$rls_unset" -eq 5 ] || return 1
  if [ "$rls_present" = true ]; then
    rls_first=true
    while IFS= read -r rls_value; do
      if [ "$rls_first" = true ]; then
        rls_first=false
        continue
      fi
      git -C "$rls_repo" config --local --add "$rls_key" "$rls_value" >/dev/null 2>&1 || return 1
    done <"$rls_snapshot"
  fi
  make_temp || return 1
  rls_actual=$new_temp_path
  git -C "$rls_repo" config --local --get-all "$rls_key" >"$rls_actual" 2>/dev/null
  rls_status=$?
  if [ "$rls_present" = false ]; then
    [ "$rls_status" -eq 1 ]
  else
    [ "$rls_status" -eq 0 ] || return 1
    make_temp || return 1
    rls_expected=$new_temp_path
    sed -n '2,$p' "$rls_snapshot" >"$rls_expected"
    cmp -s "$rls_expected" "$rls_actual"
  fi
}

rollback_binding_transaction() {
  [ -n "$binding_config_path" ] || return 0
  config_file_matches_original_or_expectation "$binding_config_path" \
    "$binding_config_state" "$binding_config_snapshot" \
    "$binding_expected_state" "$binding_expected_snapshot" \
    "$binding_config_root" || return 1
  restore_config_file "$binding_config_path" "$binding_config_state" "$binding_config_snapshot" \
    "$binding_config_root" "$binding_expected_state" "$binding_expected_snapshot" || return 1
  binding_config_path=
  binding_config_root=
  binding_config_state=
  binding_config_snapshot=
  binding_expected_state=
  binding_expected_snapshot=
  [ "$transaction_mode" != binding ] || transaction_mode=none
}

secure_config_path_under() {
  sgcp_path=$1
  sgcp_root=$2
  case "$sgcp_path" in "$sgcp_root"/*) ;; *) return 1 ;; esac
  [ -d "$sgcp_root" ] && [ ! -L "$sgcp_root" ] && \
    [ "$(path_uid "$sgcp_root")" = "$account_uid" ] && \
    path_mode_is_owner_controlled "$sgcp_root" && \
    audit_path_acl_is_safe "$sgcp_root" || return 1
  sgcp_current=${sgcp_path%/*}
  while [ "$sgcp_current" != "$sgcp_root" ]; do
    if [ -e "$sgcp_current" ] || [ -L "$sgcp_current" ]; then
      [ -d "$sgcp_current" ] && [ ! -L "$sgcp_current" ] && \
        [ "$(path_uid "$sgcp_current")" = "$account_uid" ] && \
        path_mode_is_owner_controlled "$sgcp_current" && \
        audit_path_acl_is_safe "$sgcp_current" || return 1
    fi
    sgcp_next=${sgcp_current%/*}
    [ "$sgcp_next" != "$sgcp_current" ] || return 1
    sgcp_current=$sgcp_next
  done
}

config_path_is_safe_or_absent() {
  cpisoa_path=$1
  cpisoa_root=$2
  secure_config_path_under "$cpisoa_path" "$cpisoa_root" || return 1
  if [ -e "$cpisoa_path" ] || [ -L "$cpisoa_path" ]; then
    config_regular_file_is_safe "$cpisoa_path"
  fi
}

gh_config_posture_is_safe() {
  # gh reads authentication state from this directory after the router pins
  # GH_CONFIG_DIR. Protect the directory chain and every current entry so a
  # different local principal cannot replace hosts.yml between verification
  # and a routed command. Absence is allowed for first-account onboarding.
  secure_config_path_under "$trusted_gh_config_dir/hosts.yml" "$HOME" || return 1
  if [ ! -e "$trusted_gh_config_dir" ] && [ ! -L "$trusted_gh_config_dir" ]; then
    return 0
  fi
  [ -d "$trusted_gh_config_dir" ] && [ ! -L "$trusted_gh_config_dir" ] || return 1
  for gcps_entry in "$trusted_gh_config_dir"/* "$trusted_gh_config_dir"/.[!.]* "$trusted_gh_config_dir"/..?*; do
    [ -e "$gcps_entry" ] || [ -L "$gcps_entry" ] || continue
    config_regular_file_is_safe "$gcps_entry" || return 1
  done
  return 0
}

git_program_config_is_trusted() {
  gpct_path=$1
  gpct_exec=$(git --exec-path 2>/dev/null || true)
  case "$gpct_exec" in
    */usr/libexec/git-core)
      gpct_root=${gpct_exec%/usr/libexec/git-core}
      gpct_expected=$gpct_root/usr/share/git-core/gitconfig
      ;;
    *) return 1 ;;
  esac
  gpct_parent=${gpct_expected%/*}
  gpct_base=${gpct_expected##*/}
  gpct_parent=$(cd "$gpct_parent" 2>/dev/null && pwd -P) || return 1
  [ "$gpct_path" = "$gpct_parent/$gpct_base" ]
}

config_origin_file_is_safe() {
  cofis_path=$1
  cofis_scope=${2:-}
  case "$cofis_path" in /*) ;; *) return 1 ;; esac
  printf '%s' "$cofis_path" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  cofis_parent=${cofis_path%/*}
  cofis_base=${cofis_path##*/}
  cofis_parent=$(cd "$cofis_parent" 2>/dev/null && pwd -P) || return 1
  cofis_path=$cofis_parent/$cofis_base
  cofis_program_config=false
  git_program_config_is_trusted "$cofis_path" && cofis_program_config=true
  # System-scope config is administrator-managed: its file must still be
  # root/owner-owned and not group- or world-writable, but its ancestry may
  # be admin-group-writable (Homebrew's /opt/homebrew, /usr/local) exactly as
  # Apple Git's bundled config already may. Only the reported scope grants
  # this; a user-controlled include that merely lives under /opt does not.
  [ "$cofis_scope" = system ] && cofis_program_config=true
  [ -f "$cofis_path" ] && [ ! -L "$cofis_path" ] || return 1
  cofis_uid=$(path_uid "$cofis_path" 2>/dev/null || true)
  { [ "$cofis_uid" = "$account_uid" ] || [ "$cofis_uid" = 0 ]; } && \
    [ "$(path_links "$cofis_path")" = 1 ] && \
    path_mode_is_owner_controlled "$cofis_path" && \
    audit_path_acl_is_safe "$cofis_path" || return 1
  cofis_current=${cofis_path%/*}
  [ -n "$cofis_current" ] || cofis_current=/
  while :; do
    [ -d "$cofis_current" ] && [ ! -L "$cofis_current" ] || return 1
    cofis_uid=$(path_uid "$cofis_current" 2>/dev/null || true)
    if [ "$cofis_uid" = "$account_uid" ]; then
      if path_mode_is_owner_controlled "$cofis_current"; then
        :
      elif [ "$cofis_program_config" = true ]; then
        # Same admin-managed tolerance as the root-owned branch below: a
        # packaged git's prefix may be owned by the installing user with an
        # admin group write bit (Homebrew's /opt/homebrew is runner:admin 775
        # on hosted CI). Still never world-writable.
        path_mode_is_not_world_writable "$cofis_current" || return 1
      else
        return 1
      fi
    elif [ "$cofis_uid" = 0 ]; then
      if path_mode_is_owner_controlled "$cofis_current"; then
        :
      elif [ "$cofis_program_config" = true ]; then
        # Apple Git ships a program config inside the selected Xcode toolchain,
        # whose root-owned /Applications ancestor is conventionally admin-group
        # writable. Only that exact git --exec-path-derived config gets this
        # narrow exception; arbitrary root-owned include ancestry does not.
        path_mode_is_not_world_writable "$cofis_current" || return 1
      elif dir_mode_has_sticky_bit "$cofis_current"; then
        # A root-owned, world-writable directory with the sticky bit set
        # (the standard /tmp, /var/tmp convention on every POSIX system) is
        # safe: the sticky bit stops any principal other than a file's own
        # owner, the directory's owner, or root from renaming or removing
        # that file, which is exactly the tampering this ancestor walk
        # defends against. A world-writable directory WITHOUT the sticky
        # bit gets no such exception.
        :
      else
        return 1
      fi
    else
      return 1
    fi
    audit_path_acl_is_safe "$cofis_current" || return 1
    [ "$cofis_current" = / ] && break
    cofis_current=${cofis_current%/*}
    [ -n "$cofis_current" ] || cofis_current=/
  done
  return 0
}

config_origin_path_is_safe_or_absent() {
  copisoa_path=$1
  if [ -e "$copisoa_path" ] || [ -L "$copisoa_path" ]; then
    config_origin_file_is_safe "$copisoa_path"
    return
  fi
  case "$copisoa_path" in /*) ;; *) return 1 ;; esac
  printf '%s' "$copisoa_path" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  copisoa_parent=${copisoa_path%/*}
  copisoa_base=${copisoa_path##*/}
  [ -n "$copisoa_base" ] || return 1
  copisoa_parent=$(cd "$copisoa_parent" 2>/dev/null && pwd -P) || return 1
  copisoa_current=$copisoa_parent
  while :; do
    [ -d "$copisoa_current" ] && [ ! -L "$copisoa_current" ] || return 1
    copisoa_uid=$(path_uid "$copisoa_current" 2>/dev/null || true)
    { [ "$copisoa_uid" = "$account_uid" ] || [ "$copisoa_uid" = 0 ]; } || return 1
    if [ "$copisoa_uid" = 0 ]; then
      # See config_origin_file_is_safe: a root-owned, world-writable
      # directory is safe when the sticky bit is set (/tmp, /var/tmp).
      path_mode_is_owner_controlled "$copisoa_current" || \
        dir_mode_has_sticky_bit "$copisoa_current" || return 1
    else
      path_mode_is_owner_controlled "$copisoa_current" || return 1
    fi
    audit_path_acl_is_safe "$copisoa_current" || return 1
    [ "$copisoa_current" = / ] && break
    copisoa_current=${copisoa_current%/*}
    [ -n "$copisoa_current" ] || copisoa_current=/
  done
  printf '%s/%s\n' "$copisoa_parent" "$copisoa_base"
}

append_declared_config_includes() {
  adci_config=$1
  adci_output=$2
  make_temp || return 1
  adci_lines=$new_temp_path
  git config --file "$adci_config" --no-includes --get-regexp \
    '^(include\.path|include[Ii]f\..*\.path)$' >"$adci_lines" 2>/dev/null
  adci_status=$?
  case "$adci_status" in 0) ;; 1) return 0 ;; *) return 1 ;; esac
  while IFS= read -r adci_line; do
    case "$adci_line" in
      *' '*) adci_value=${adci_line#* } ;;
      *) return 1 ;;
    esac
    [ -n "$adci_value" ] || return 1
    printf '%s' "$adci_value" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
    case "$adci_value" in
      /*) adci_path=$adci_value ;;
      \~/*) adci_path=$HOME/${adci_value#??} ;;
      \~|\~*) return 1 ;;
      *) adci_path=${adci_config%/*}/$adci_value ;;
    esac
    adci_parent=${adci_path%/*}
    adci_base=${adci_path##*/}
    [ -n "$adci_base" ] || return 1
    adci_parent=$(cd "$adci_parent" 2>/dev/null && pwd -P) || return 1
    adci_path=$adci_parent/$adci_base
    config_origin_path_is_safe_or_absent "$adci_path" >/dev/null || return 1
    printf '%s\n' "$adci_path" >>"$adci_output" || return 1
  done <"$adci_lines"
}

git_config_origins_are_safe() {
  gco_repo=${1:-}
  gco_path_list=${2:-}
  [ -z "$gco_path_list" ] || : >"$gco_path_list" || return 1
  make_temp || return 1
  gco_origins=$new_temp_path
  # --show-scope prefixes each line with system|global|local|worktree|command.
  # System-scope origins are administrator-managed by definition, so their
  # ancestry gets the same "not world-writable" tolerance Apple Git's bundled
  # config already had — a packaged git's prefix (Homebrew's group-writable
  # /opt/homebrew, a distro's /etc) must not make every repository unusable.
  if [ -n "$gco_repo" ]; then
    git -C "$gco_repo" config --includes --show-scope --show-origin --name-only --list \
      >"$gco_origins" 2>/dev/null || return 1
  else
    if [ ! -e "$HOME/.gitconfig" ] && [ ! -L "$HOME/.gitconfig" ] && \
       [ ! -e "$trusted_xdg_config_home/git/config" ] && \
       [ ! -L "$trusted_xdg_config_home/git/config" ]; then
      return 0
    fi
    git config --global --includes --show-scope --show-origin --name-only --list \
      >"$gco_origins" 2>/dev/null || return 1
  fi
  gco_tab=$(printf '\t')
  gco_previous_origin=
  while IFS="$gco_tab" read -r gco_scope gco_origin gco_key gco_extra; do
    [ -n "$gco_scope" ] && [ -n "$gco_origin" ] && [ -n "$gco_key" ] && [ -z "$gco_extra" ] || return 1
    # Apple Git labels its bundled toolchain config `unknown` rather than
    # `system`; it is admitted as a scope value but gets no scope-based
    # tolerance (git_program_config_is_trusted already covers that file).
    case "$gco_scope" in system|global|local|worktree|command|unknown) ;; *) return 1 ;; esac
    if [ "$gco_origin" = "$gco_previous_origin" ]; then
      continue
    fi
    gco_previous_origin=$gco_origin
    case "$gco_origin" in
      file:/*) gco_path=${gco_origin#file:} ;;
      file:*)
        [ -n "$gco_repo" ] || return 1
        gco_relative=${gco_origin#file:}
        printf '%s' "$gco_relative" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
        case "$gco_relative" in
          .git/config)
            gco_common=$(git -C "$gco_repo" rev-parse --git-common-dir 2>/dev/null) || return 1
            case "$gco_common" in
              /*) gco_path=$gco_common/config ;;
              *) gco_parent=$(cd "$gco_repo/$gco_common" 2>/dev/null && pwd -P) || return 1; gco_path=$gco_parent/config ;;
            esac
            ;;
          .git/config.worktree)
            gco_parent=$(git -C "$gco_repo" rev-parse --absolute-git-dir 2>/dev/null) || return 1
            gco_path=$gco_parent/config.worktree
            ;;
          *)
            gco_parent=${gco_relative%/*}
            gco_base=${gco_relative##*/}
            [ "$gco_parent" != "$gco_relative" ] || gco_parent=.
            gco_parent=$(cd "$gco_repo/$gco_parent" 2>/dev/null && pwd -P) || return 1
            gco_path=$gco_parent/$gco_base
            ;;
        esac
        ;;
      *) return 1 ;;
    esac
    config_origin_file_is_safe "$gco_path" "$gco_scope" || return 1
    if [ -n "$gco_path_list" ]; then
      printf '%s\n' "$gco_path" >>"$gco_path_list" || return 1
      append_declared_config_includes "$gco_path" "$gco_path_list" || return 1
    else
      make_temp || return 1
      gco_declared=$new_temp_path
      append_declared_config_includes "$gco_path" "$gco_declared" || return 1
    fi
  done <"$gco_origins"
  return 0
}

config_guard_is_registered() {
  cgir_target=$1
  cgir_root=$2
  registered_config_lock_for_target "$cgir_target" "$cgir_root"
}

acquire_git_exec_config_guard() {
  agecg_path=$1
  agecg_root=$2
  if [ -e "$agecg_path" ] || [ -L "$agecg_path" ]; then
    config_regular_file_is_safe "$agecg_path" || return 1
    [ "$(path_uid "$agecg_path")" = "$account_uid" ] || return 0
  else
    agecg_parent=${agecg_path%/*}
    if [ ! -e "$agecg_parent" ] && [ ! -L "$agecg_parent" ]; then
      agecg_grandparent=${agecg_parent%/*}
      secure_config_path_under "$agecg_parent/directory-check" "$agecg_root" || return 1
      [ -d "$agecg_grandparent" ] && [ ! -L "$agecg_grandparent" ] || return 1
      mkdir "$agecg_parent" 2>/dev/null || return 1
      chmod 700 "$agecg_parent" 2>/dev/null || return 1
    fi
    [ -d "$agecg_parent" ] && [ ! -L "$agecg_parent" ] && \
      [ "$(path_uid "$agecg_parent")" = "$account_uid" ] && \
      path_mode_is_owner_controlled "$agecg_parent" && \
      audit_path_acl_is_safe "$agecg_parent" || return 1
  fi
  config_guard_is_registered "$agecg_path" "$agecg_root" && return 0
  acquire_registered_config_lock "$agecg_path" "$agecg_root"
}

append_git_exec_guard_candidate() {
  agegcc_path=$1
  agegcc_root=$2
  agegcc_output=$3
  printf '%s%s' "$agegcc_path" "$agegcc_root" | \
    LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  agegcc_tab=$(printf '\t')
  while IFS="$agegcc_tab" read -r agegcc_existing _; do
    [ "$agegcc_existing" != "$agegcc_path" ] || return 0
  done <"$agegcc_output"
  printf '%s\t%s\n' "$agegcc_path" "$agegcc_root" >>"$agegcc_output"
}

prepare_git_exec_config_guards() {
  pgecg_repo=$1
  pgecg_origins_before=$2
  git_exec_guard_snapshot_manifest=
  pgecg_common_raw=$(git -C "$pgecg_repo" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$pgecg_common_raw" in
    /*) pgecg_common=$pgecg_common_raw ;;
    *) pgecg_common=$(cd "$pgecg_repo/$pgecg_common_raw" 2>/dev/null && pwd -P) || return 1 ;;
  esac
  pgecg_git_dir=$(git -C "$pgecg_repo" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  make_temp || return 1
  pgecg_worktree_value=$new_temp_path
  git -C "$pgecg_repo" config --local --get extensions.worktreeConfig \
    >"$pgecg_worktree_value" 2>/dev/null
  pgecg_worktree_status=$?
  case "$pgecg_worktree_status" in
    0) pgecg_worktree=$(sed -n '1p' "$pgecg_worktree_value") ;;
    1) pgecg_worktree=false ;;
    *) return 1 ;;
  esac

  config_regular_file_is_safe "$pgecg_origins_before" || return 1
  make_temp || return 1
  pgecg_origins_before_sorted=$new_temp_path
  LC_ALL=C sort -u "$pgecg_origins_before" >"$pgecg_origins_before_sorted" || return 1

  make_temp || return 1
  pgecg_candidates=$new_temp_path
  : >"$pgecg_candidates" || return 1
  append_git_exec_guard_candidate "$HOME/.gitconfig" "$HOME" "$pgecg_candidates" || return 1
  append_git_exec_guard_candidate "$trusted_xdg_config_home/git/config" "$HOME" \
    "$pgecg_candidates" || return 1
  append_git_exec_guard_candidate "$pgecg_common/config" "$pgecg_common" \
    "$pgecg_candidates" || return 1
  append_git_exec_guard_candidate "$pgecg_git_dir/HEAD" "$pgecg_common" \
    "$pgecg_candidates" || return 1
  if [ "$pgecg_worktree" = true ]; then
    append_git_exec_guard_candidate "$pgecg_git_dir/config.worktree" "$pgecg_common" \
      "$pgecg_candidates" || return 1
  fi
  while IFS= read -r pgecg_origin; do
    [ -n "$pgecg_origin" ] || continue
    if [ "$(path_uid "$pgecg_origin" 2>/dev/null || true)" = "$account_uid" ]; then
      pgecg_parent=${pgecg_origin%/*}
      append_git_exec_guard_candidate "$pgecg_origin" "$pgecg_parent" \
        "$pgecg_candidates" || return 1
    elif [ ! -e "$pgecg_origin" ] && [ ! -L "$pgecg_origin" ]; then
      pgecg_parent=${pgecg_origin%/*}
      if [ "$(path_uid "$pgecg_parent" 2>/dev/null || true)" = "$account_uid" ]; then
        append_git_exec_guard_candidate "$pgecg_origin" "$pgecg_parent" \
          "$pgecg_candidates" || return 1
      fi
    fi
  done <"$pgecg_origins_before_sorted"

  make_temp || return 1
  git_exec_guard_snapshot_manifest=$new_temp_path
  : >"$git_exec_guard_snapshot_manifest" || return 1
  pgecg_tab=$(printf '\t')
  while IFS="$pgecg_tab" read -r pgecg_path pgecg_root pgecg_extra; do
    [ -n "$pgecg_path" ] && [ -n "$pgecg_root" ] && [ -z "$pgecg_extra" ] || return 1
    snapshot_config_file "$pgecg_path" "$pgecg_root" || return 1
    printf '%s\t%s\t%s\t%s\n' "$pgecg_path" "$pgecg_root" \
      "$config_file_state" "$config_file_snapshot" \
      >>"$git_exec_guard_snapshot_manifest" || return 1
  done <"$pgecg_candidates"

  make_temp || return 1
  pgecg_origins_after=$new_temp_path
  git_config_origins_are_safe "$pgecg_repo" "$pgecg_origins_after" || return 1
  make_temp || return 1
  pgecg_origins_after_sorted=$new_temp_path
  LC_ALL=C sort -u "$pgecg_origins_after" >"$pgecg_origins_after_sorted" || return 1
  cmp -s "$pgecg_origins_before_sorted" "$pgecg_origins_after_sorted" || return 1

  config_regular_file_is_safe "$git_exec_guard_snapshot_manifest"
}

git_exec_guard_snapshots_match() {
  [ -n "$git_exec_guard_snapshot_manifest" ] || return 1
  config_regular_file_is_safe "$git_exec_guard_snapshot_manifest" || return 1
  gegsm_tab=$(printf '\t')
  while IFS="$gegsm_tab" read -r gegsm_path gegsm_root gegsm_state \
    gegsm_snapshot gegsm_extra; do
    [ -n "$gegsm_path" ] && [ -n "$gegsm_root" ] && [ -n "$gegsm_state" ] && \
      [ -z "$gegsm_extra" ] || return 1
    config_file_matches_expectation "$gegsm_path" "$gegsm_state" \
      "$gegsm_snapshot" "$gegsm_root" || return 1
  done <"$git_exec_guard_snapshot_manifest"
  return 0
}

acquire_git_exec_config_guards() {
  git_exec_guard_snapshots_match || return 1
  agec_tab=$(printf '\t')
  while IFS="$agec_tab" read -r agec_path agec_root agec_state \
    agec_snapshot agec_extra; do
    [ -n "$agec_path" ] && [ -n "$agec_root" ] && [ -n "$agec_state" ] && \
      [ -z "$agec_extra" ] || return 1
    case "$agec_state" in
      absent) [ -z "$agec_snapshot" ] || return 1 ;;
      present) [ -n "$agec_snapshot" ] || return 1 ;;
      *) return 1 ;;
    esac
    acquire_git_exec_config_guard "$agec_path" "$agec_root" || return 1
  done <"$git_exec_guard_snapshot_manifest"
  git_exec_guard_snapshots_match
}

git_config_posture_is_safe() {
  gcps_repo=${1:-}
  gcps_path_list=${2:-}
  config_path_is_safe_or_absent "$HOME/.gitconfig" "$HOME" || return 1
  config_path_is_safe_or_absent "$trusted_xdg_config_home/git/config" "$HOME" || return 1
  if [ -z "$gcps_repo" ]; then
    git_config_origins_are_safe "" "$gcps_path_list" || return 1
    return 0
  fi

  gcps_common_raw=$(git -C "$gcps_repo" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$gcps_common_raw" in
    /*) gcps_common_dir=$gcps_common_raw ;;
    *) gcps_common_dir=$(cd "$gcps_repo/$gcps_common_raw" 2>/dev/null && pwd -P) || return 1 ;;
  esac
  [ -d "$gcps_common_dir" ] && [ ! -L "$gcps_common_dir" ] && \
    [ "$(path_uid "$gcps_common_dir")" = "$account_uid" ] && \
    path_mode_is_owner_controlled "$gcps_common_dir" && \
    audit_path_acl_is_safe "$gcps_common_dir" || return 1
  config_path_is_safe_or_absent "$gcps_common_dir/config" "$gcps_common_dir" || return 1

  if [ "$(git -C "$gcps_repo" config --local --get extensions.worktreeConfig 2>/dev/null || true)" = true ]; then
    gcps_git_dir=$(git -C "$gcps_repo" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    case "$gcps_git_dir" in "$gcps_common_dir"|"$gcps_common_dir"/*) ;; *) return 1 ;; esac
    if [ "$gcps_git_dir" != "$gcps_common_dir" ]; then
      [ -d "$gcps_git_dir" ] && [ ! -L "$gcps_git_dir" ] && \
        [ "$(path_uid "$gcps_git_dir")" = "$account_uid" ] && \
        path_mode_is_owner_controlled "$gcps_git_dir" && \
        audit_path_acl_is_safe "$gcps_git_dir" || return 1
    fi
    config_path_is_safe_or_absent "$gcps_git_dir/config.worktree" "$gcps_common_dir" || return 1
  fi
  git_config_origins_are_safe "$gcps_repo" "$gcps_path_list"
}

snapshot_config_file() {
  scf_path=$1
  scf_root=${2:-$HOME}
  secure_config_path_under "$scf_path" "$scf_root" || return 1
  if [ -e "$scf_path" ] || [ -L "$scf_path" ]; then
    config_regular_file_is_safe "$scf_path" || return 1
    make_temp || return 1
    config_file_snapshot=$new_temp_path
    cp -p "$scf_path" "$config_file_snapshot" 2>/dev/null || return 1
    config_file_state=present
  else
    config_file_snapshot=
    config_file_state=absent
  fi
}

install_config_bytes_under_lock() {
  icbul_path=$1
  icbul_snapshot=$2
  icbul_root=$3
  secure_config_path_under "$icbul_path" "$icbul_root" || return 1
  config_regular_file_is_safe "$icbul_snapshot" || return 1
  icbul_parent=${icbul_path%/*}
  [ -d "$icbul_parent" ] && [ ! -L "$icbul_parent" ] || return 1
  registered_config_lock_for_target "$icbul_path" "$icbul_root" || return 1
  icbul_tmp=$(mktemp "$icbul_parent/.gh-account-stage.$lock_nonce.XXXXXX") || return 1
  cp -p "$icbul_snapshot" "$icbul_tmp" 2>/dev/null || {
    rm -f "$icbul_tmp" 2>/dev/null || true
    return 1
  }
  config_regular_file_is_safe "$icbul_tmp" || {
    rm -f "$icbul_tmp" 2>/dev/null || true
    return 1
  }
  run_tracked mv "$icbul_tmp" "$icbul_path" 2>/dev/null || {
    rm -f "$icbul_tmp" 2>/dev/null || true
    return 1
  }
  config_regular_file_is_safe "$icbul_path" && cmp -s "$icbul_snapshot" "$icbul_path"
}

restore_config_file() {
  rcf_path=$1
  rcf_state=$2
  rcf_snapshot=$3
  rcf_root=${4:-$HOME}
  rcf_expected_state=${5:-$rcf_state}
  rcf_expected_snapshot=${6:-$rcf_snapshot}
  secure_config_path_under "$rcf_path" "$rcf_root" || return 1
  # An absent original that is still absent is already rolled back. Do not
  # create its missing parent merely to acquire a guard for a no-op; doing so
  # can turn a recoverable journal-unlink failure into stranded WAL/lease data.
  if [ "$rcf_state" = absent ] && [ ! -e "$rcf_path" ] && [ ! -L "$rcf_path" ]; then
    return 0
  fi
  rcf_parent=${rcf_path%/*}
  [ -d "$rcf_parent" ] && [ ! -L "$rcf_parent" ] || return 1
  if [ "$rcf_state" = present ]; then
    config_regular_file_is_safe "$rcf_snapshot" || return 1
  fi
  ensure_registered_config_lock "$rcf_path" "$rcf_root" || return 1
  if ! config_file_matches_original_or_expectation "$rcf_path" "$rcf_state" "$rcf_snapshot" \
    "$rcf_expected_state" "$rcf_expected_snapshot" "$rcf_root"; then
    return 1
  fi
  if [ "$rcf_state" = absent ]; then
    if [ -e "$rcf_path" ] || [ -L "$rcf_path" ]; then
      config_regular_file_is_safe "$rcf_path" || return 1
      run_tracked rm -f "$rcf_path" 2>/dev/null || return 1
    fi
    [ ! -e "$rcf_path" ] && [ ! -L "$rcf_path" ]
    return
  fi
  install_config_bytes_under_lock "$rcf_path" "$rcf_snapshot" "$rcf_root"
}

config_file_matches_expectation() {
  cfme_path=$1
  cfme_state=$2
  cfme_snapshot=$3
  cfme_root=$4
  secure_config_path_under "$cfme_path" "$cfme_root" || return 1
  case "$cfme_state" in
    absent) [ ! -e "$cfme_path" ] && [ ! -L "$cfme_path" ] ;;
    present)
      config_regular_file_is_safe "$cfme_path" || return 1
      config_regular_file_is_safe "$cfme_snapshot" || return 1
      cmp -s "$cfme_snapshot" "$cfme_path"
      ;;
    *) return 1 ;;
  esac
}

config_file_matches_original_or_expectation() {
  cfmoe_path=$1
  cfmoe_original_state=$2
  cfmoe_original_snapshot=$3
  cfmoe_expected_state=$4
  cfmoe_expected_snapshot=$5
  cfmoe_root=$6
  config_file_matches_expectation "$cfmoe_path" "$cfmoe_original_state" \
    "$cfmoe_original_snapshot" "$cfmoe_root" && return 0
  config_file_matches_expectation "$cfmoe_path" "$cfmoe_expected_state" \
    "$cfmoe_expected_snapshot" "$cfmoe_root"
}

prepare_config_stage() {
  pcs_original_state=$1
  pcs_original_snapshot=$2
  make_temp || return 1
  staged_config_snapshot=$new_temp_path
  if [ "$pcs_original_state" = present ]; then
    cp -p "$pcs_original_snapshot" "$staged_config_snapshot" 2>/dev/null || return 1
  else
    : >"$staged_config_snapshot" || return 1
    chmod 600 "$staged_config_snapshot" 2>/dev/null || return 1
  fi
  config_regular_file_is_safe "$staged_config_snapshot"
}

install_config_snapshot() {
  ics_path=$1
  ics_original_state=$2
  ics_original_snapshot=$3
  ics_expected_snapshot=$4
  ics_root=$5
  secure_config_path_under "$ics_path" "$ics_root" || return 1
  config_regular_file_is_safe "$ics_expected_snapshot" || return 1
  ics_parent=${ics_path%/*}
  [ -d "$ics_parent" ] && [ ! -L "$ics_parent" ] || return 1
  ensure_registered_config_lock "$ics_path" "$ics_root" || return 1
  if ! config_file_matches_expectation "$ics_path" "$ics_original_state" \
    "$ics_original_snapshot" "$ics_root"; then
    return 1
  fi
  install_config_bytes_under_lock "$ics_path" "$ics_expected_snapshot" "$ics_root"
}

transaction_journal_status() {
  [ -e "$transaction_journal" ] || [ -L "$transaction_journal" ] || return 1
  config_regular_file_is_safe "$transaction_journal" || return 2
  jq -e '
    def safe_string:
      type == "string" and (length <= 4096) and (test("[\u0000-\u001f\u007f]") | not);
    def state_ok($state; $snapshot):
      ($state == "present" and ($snapshot | safe_string) and ($snapshot | length) > 0) or
      ($state == "absent" and $snapshot == "");
    .schema == "gh-account.config-transaction.v1" and
    (.mode == "binding" or .mode == "binding_committed" or .mode == "repair") and
    (.binding.path | safe_string) and (.binding.root | safe_string) and
    (.binding.state | type == "string") and (.binding.snapshot | type == "string") and
    (.binding.expected_state | type == "string") and (.binding.expected_snapshot | type == "string") and
    (.global.home.path | safe_string) and (.global.home.state | type == "string") and
    (.global.home.snapshot | type == "string") and (.global.home.expected_state | type == "string") and
    (.global.home.expected_snapshot | type == "string") and
    (.global.xdg.path | safe_string) and (.global.xdg.state | type == "string") and
    (.global.xdg.snapshot | type == "string") and (.global.xdg.expected_state | type == "string") and
    (.global.xdg.expected_snapshot | type == "string") and
    (if .binding.path == "" then
       .binding.root == "" and .binding.state == "" and .binding.snapshot == "" and
       .binding.expected_state == "" and .binding.expected_snapshot == ""
     else
       (.binding.root | length) > 0 and state_ok(.binding.state; .binding.snapshot) and
       state_ok(.binding.expected_state; .binding.expected_snapshot)
     end) and
    (if .mode == "repair" then
       (.global.home.path | length) > 0 and state_ok(.global.home.state; .global.home.snapshot) and
       state_ok(.global.home.expected_state; .global.home.expected_snapshot) and
       (.global.xdg.path | length) > 0 and state_ok(.global.xdg.state; .global.xdg.snapshot) and
       state_ok(.global.xdg.expected_state; .global.xdg.expected_snapshot)
     else
       .global.home.path == "" and .global.home.state == "" and .global.home.snapshot == "" and
       .global.home.expected_state == "" and .global.home.expected_snapshot == "" and
       .global.xdg.path == "" and .global.xdg.state == "" and .global.xdg.snapshot == "" and
       .global.xdg.expected_state == "" and .global.xdg.expected_snapshot == ""
     end)
  ' "$transaction_journal" >/dev/null 2>&1 || return 2
  return 0
}

write_transaction_journal() {
  wtj_mode=${1:-$transaction_mode}
  [ "$lock_held" = true ] || return 1
  [ "$wtj_mode" = binding ] || [ "$wtj_mode" = binding_committed ] || \
    [ "$wtj_mode" = repair ] || return 1
  [ -d "$lock_root" ] && [ ! -L "$lock_root" ] && \
    [ "$(path_uid "$lock_root")" = "$account_uid" ] && \
    path_mode_is_owner_controlled "$lock_root" && \
    audit_path_acl_is_safe "$lock_root" || return 1
  if [ -e "$transaction_journal" ] || [ -L "$transaction_journal" ]; then
    config_regular_file_is_safe "$transaction_journal" || return 1
  fi
  wtj_tmp=$(mktemp "$lock_root/.config.pending.XXXXXX") || return 1
  chmod 600 "$wtj_tmp" 2>/dev/null || { rm -f "$wtj_tmp" 2>/dev/null || true; return 1; }
  config_regular_file_is_safe "$wtj_tmp" || { rm -f "$wtj_tmp" 2>/dev/null || true; return 1; }
  if ! jq -n \
    --arg schema gh-account.config-transaction.v1 \
    --arg mode "$wtj_mode" \
    --arg binding_path "$binding_config_path" \
    --arg binding_root "$binding_config_root" \
    --arg binding_state "$binding_config_state" \
    --arg binding_snapshot "$binding_config_snapshot" \
    --arg binding_expected_state "$binding_expected_state" \
    --arg binding_expected_snapshot "$binding_expected_snapshot" \
    --arg home_path "$rr_home_config_path" \
    --arg home_state "$rr_home_config_state" \
    --arg home_snapshot "$rr_home_config_snapshot" \
    --arg home_expected_state "$rr_home_expected_state" \
    --arg home_expected_snapshot "$rr_home_expected_snapshot" \
    --arg xdg_path "$rr_xdg_config_path" \
    --arg xdg_state "$rr_xdg_config_state" \
    --arg xdg_snapshot "$rr_xdg_config_snapshot" \
    --arg xdg_expected_state "$rr_xdg_expected_state" \
    --arg xdg_expected_snapshot "$rr_xdg_expected_snapshot" '
      {
        schema:$schema,
        mode:$mode,
        binding:{
          path:$binding_path,root:$binding_root,state:$binding_state,snapshot:$binding_snapshot,
          expected_state:$binding_expected_state,expected_snapshot:$binding_expected_snapshot
        },
        global:{
          home:{
            path:$home_path,state:$home_state,snapshot:$home_snapshot,
            expected_state:$home_expected_state,expected_snapshot:$home_expected_snapshot
          },
          xdg:{
            path:$xdg_path,state:$xdg_state,snapshot:$xdg_snapshot,
            expected_state:$xdg_expected_state,expected_snapshot:$xdg_expected_snapshot
          }
        }
      }
    ' >"$wtj_tmp"; then
    rm -f "$wtj_tmp" 2>/dev/null || true
    return 1
  fi
  make_temp || { rm -f "$wtj_tmp" 2>/dev/null || true; return 1; }
  wtj_expected=$new_temp_path
  cp -p "$wtj_tmp" "$wtj_expected" 2>/dev/null || {
    rm -f "$wtj_tmp" "$wtj_expected" 2>/dev/null || true
    return 1
  }
  config_regular_file_is_safe "$wtj_expected" || {
    rm -f "$wtj_tmp" "$wtj_expected" 2>/dev/null || true
    return 1
  }
  run_tracked mv "$wtj_tmp" "$transaction_journal" 2>/dev/null
  wtj_move_status=$?
  if ! config_regular_file_is_safe "$transaction_journal" || \
     ! cmp -s "$wtj_expected" "$transaction_journal"; then
    rm -f "$wtj_tmp" "$wtj_expected" 2>/dev/null || true
    return 1
  fi
  # The exact durable WAL bytes are already proven. Treat verifier cleanup as
  # best-effort so a harmless temp unlink failure cannot desynchronize the
  # in-memory transaction state from its committed journal.
  rm -f "$wtj_expected" 2>/dev/null || true
  transaction_journal_status || return 1
  # Exact serialized bytes, not merely schema/mode validity, reconcile a
  # nonzero supervisor result and keep in-memory transaction_mode aligned.
  [ "$wtj_move_status" -eq 0 ] || return 0
  return 0
}

clear_transaction_journal() {
  [ -e "$transaction_journal" ] || [ -L "$transaction_journal" ] || return 0
  config_regular_file_is_safe "$transaction_journal" || return 1
  run_tracked rm -f "$transaction_journal" 2>/dev/null
  ctj_status=$?
  # Unlink has committed only when no directory entry remains. A dangling
  # symlink has -e false but -L true and must remain a hard failure.
  [ ! -e "$transaction_journal" ] && [ ! -L "$transaction_journal" ] || return 1
  [ "$ctj_status" -eq 0 ] || return 0
  return 0
}

load_transaction_journal() {
  transaction_journal_status || return $?
  transaction_mode=$(jq -r '.mode' "$transaction_journal") || return 2
  binding_config_path=$(jq -r '.binding.path' "$transaction_journal") || return 2
  binding_config_root=$(jq -r '.binding.root' "$transaction_journal") || return 2
  binding_config_state=$(jq -r '.binding.state' "$transaction_journal") || return 2
  binding_config_snapshot=$(jq -r '.binding.snapshot' "$transaction_journal") || return 2
  binding_expected_state=$(jq -r '.binding.expected_state' "$transaction_journal") || return 2
  binding_expected_snapshot=$(jq -r '.binding.expected_snapshot' "$transaction_journal") || return 2
  rr_home_config_path=$(jq -r '.global.home.path' "$transaction_journal") || return 2
  rr_home_config_state=$(jq -r '.global.home.state' "$transaction_journal") || return 2
  rr_home_config_snapshot=$(jq -r '.global.home.snapshot' "$transaction_journal") || return 2
  rr_home_expected_state=$(jq -r '.global.home.expected_state' "$transaction_journal") || return 2
  rr_home_expected_snapshot=$(jq -r '.global.home.expected_snapshot' "$transaction_journal") || return 2
  rr_xdg_config_path=$(jq -r '.global.xdg.path' "$transaction_journal") || return 2
  rr_xdg_config_state=$(jq -r '.global.xdg.state' "$transaction_journal") || return 2
  rr_xdg_config_snapshot=$(jq -r '.global.xdg.snapshot' "$transaction_journal") || return 2
  rr_xdg_expected_state=$(jq -r '.global.xdg.expected_state' "$transaction_journal") || return 2
  rr_xdg_expected_snapshot=$(jq -r '.global.xdg.expected_snapshot' "$transaction_journal") || return 2
}

cleanup_recovered_snapshot_parent() {
  crsp_snapshot=$1
  [ -n "$crsp_snapshot" ] || return 0
  crsp_parent=${crsp_snapshot%/*}
  case "$crsp_parent" in /tmp/gh-account.??????) ;; *) return 1 ;; esac
  [ -d "$crsp_parent" ] && [ ! -L "$crsp_parent" ] && \
    [ "$(path_uid "$crsp_parent")" = "$account_uid" ] && \
    path_mode_is_owner_controlled "$crsp_parent" && \
    audit_path_acl_is_safe "$crsp_parent" || return 1
  for crsp_item in "$crsp_parent"/*; do
    [ -e "$crsp_item" ] || [ -L "$crsp_item" ] || continue
    config_regular_file_is_safe "$crsp_item" || return 1
  done
  for crsp_item in "$crsp_parent"/*; do
    [ -e "$crsp_item" ] || continue
    rm -f "$crsp_item" 2>/dev/null || return 1
  done
  rmdir "$crsp_parent" 2>/dev/null
}

recover_pending_transaction() {
  transaction_journal_status
  rpt_status=$?
  [ "$rpt_status" -ne 1 ] || return 0
  [ "$rpt_status" -eq 0 ] || return 1
  load_transaction_journal || return 1
  rpt_binding_snapshot=$binding_config_snapshot
  rpt_home_snapshot=$rr_home_config_snapshot
  rpt_xdg_snapshot=$rr_xdg_config_snapshot
  rpt_failed=false
  case "$transaction_mode" in
    repair)
      if [ -n "$binding_config_path" ]; then
        config_file_matches_original_or_expectation "$binding_config_path" "$binding_config_state" \
          "$binding_config_snapshot" "$binding_expected_state" "$binding_expected_snapshot" \
          "$binding_config_root" || return 1
      fi
      config_file_matches_original_or_expectation "$rr_home_config_path" "$rr_home_config_state" \
        "$rr_home_config_snapshot" "$rr_home_expected_state" "$rr_home_expected_snapshot" \
        "$HOME" || return 1
      config_file_matches_original_or_expectation "$rr_xdg_config_path" "$rr_xdg_config_state" \
        "$rr_xdg_config_snapshot" "$rr_xdg_expected_state" "$rr_xdg_expected_snapshot" \
        "$HOME" || return 1
      rollback_binding_transaction || rpt_failed=true
      rollback_repair_global || rpt_failed=true
      ;;
    binding)
      config_file_matches_original_or_expectation "$binding_config_path" "$binding_config_state" \
        "$binding_config_snapshot" "$binding_expected_state" "$binding_expected_snapshot" \
        "$binding_config_root" || return 1
      rollback_binding_transaction || rpt_failed=true
      ;;
    binding_committed)
      config_file_matches_expectation "$binding_config_path" "$binding_expected_state" \
        "$binding_expected_snapshot" "$binding_config_root" || return 1
      clear_restore_quarantine || return 1
      ;;
    *) return 1 ;;
  esac
  [ "$rpt_failed" = false ] || return 1
  clear_transaction_journal || return 1
  cleanup_recovered_snapshot_parent "$rpt_binding_snapshot" || true
  cleanup_recovered_snapshot_parent "$rpt_home_snapshot" || true
  cleanup_recovered_snapshot_parent "$rpt_xdg_snapshot" || true
  transaction_mode=none
  return 0
}

rollback_repair_global() {
  [ "$transaction_mode" = repair ] || return 0
  config_file_matches_original_or_expectation "$rr_home_config_path" \
    "$rr_home_config_state" "$rr_home_config_snapshot" \
    "$rr_home_expected_state" "$rr_home_expected_snapshot" "$HOME" || return 1
  if [ "$rr_xdg_config_path" != "$rr_home_config_path" ]; then
    config_file_matches_original_or_expectation "$rr_xdg_config_path" \
      "$rr_xdg_config_state" "$rr_xdg_config_snapshot" \
      "$rr_xdg_expected_state" "$rr_xdg_expected_snapshot" "$HOME" || return 1
  fi
  rrg_failed=false
  restore_config_file "$rr_home_config_path" "$rr_home_config_state" "$rr_home_config_snapshot" \
    "$HOME" "$rr_home_expected_state" "$rr_home_expected_snapshot" || rrg_failed=true
  if [ "$rr_xdg_config_path" != "$rr_home_config_path" ]; then
    restore_config_file "$rr_xdg_config_path" "$rr_xdg_config_state" "$rr_xdg_config_snapshot" \
      "$HOME" "$rr_xdg_expected_state" "$rr_xdg_expected_snapshot" || rrg_failed=true
  fi
  [ "$rrg_failed" = false ] || return 1
  transaction_mode=none
}

clear_binding_transaction_state() {
  binding_config_path=
  binding_config_root=
  binding_config_state=
  binding_config_snapshot=
  binding_expected_state=
  binding_expected_snapshot=
}

prepare_binding_transaction() {
  pbt_user=$1
  pbt_repo=$2
  git_config_posture_is_safe "$pbt_repo" || return 1
  resolve_active_identity "$pbt_user" || return 1
  pbt_common_raw=$(git -C "$pbt_repo" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$pbt_common_raw" in
    /*) pbt_common_dir=$pbt_common_raw ;;
    *) pbt_common_dir=$(cd "$pbt_repo/$pbt_common_raw" 2>/dev/null && pwd -P) || return 1 ;;
  esac
  binding_config_root=$pbt_common_dir
  binding_config_path=$pbt_common_dir/config
  snapshot_config_file "$binding_config_path" "$binding_config_root" || return 1
  binding_config_state=$config_file_state
  binding_config_snapshot=$config_file_snapshot
  prepare_config_stage "$binding_config_state" "$binding_config_snapshot" || return 1
  binding_expected_state=present
  binding_expected_snapshot=$staged_config_snapshot
  git config --file "$binding_expected_snapshot" credential.username "$identity_login" || return 1
  git config --file "$binding_expected_snapshot" github.account "$identity_login" || return 1
  git config --file "$binding_expected_snapshot" user.name "$identity_name" || return 1
  git config --file "$binding_expected_snapshot" user.email "$identity_email" || return 1
  [ "$(git config --file "$binding_expected_snapshot" --get credential.username 2>/dev/null || true)" = "$identity_login" ] && \
    [ "$(git config --file "$binding_expected_snapshot" --get github.account 2>/dev/null || true)" = "$identity_login" ] && \
    [ "$(git config --file "$binding_expected_snapshot" --get user.name 2>/dev/null || true)" = "$identity_name" ] && \
    [ "$(git config --file "$binding_expected_snapshot" --get user.email 2>/dev/null || true)" = "$identity_email" ]
}

install_prepared_binding() {
  install_config_snapshot "$binding_config_path" "$binding_config_state" \
    "$binding_config_snapshot" "$binding_expected_snapshot" "$binding_config_root"
}

bind_account_transactional() {
  bat_user=$1
  bat_repo=$2
  bat_defer_commit=${3:-false}
  [ "$transaction_mode" = none ] || return 1
  prepare_binding_transaction "$bat_user" "$bat_repo" || return 1
  transaction_mode=binding
  if ! write_transaction_journal; then
    transaction_mode=none
    clear_binding_transaction_state
    return 1
  fi
  if ! install_prepared_binding; then
    # The live file no longer matches the predeclared original. Preserve the
    # WAL and refuse rather than overwrite an unrelated edit.
    return 1
  fi
  if [ "$bat_defer_commit" = true ]; then
    mutation_performed=true
    return 0
  fi
  if ! clear_transaction_journal; then
    rollback_binding_transaction || true
    return 1
  fi
  transaction_mode=none
  mutation_performed=true
  printf 'git-bound: %s (%s)\n' "$identity_login" "$bat_repo"
  printf 'git-author: %s <%s>\n' "$identity_name" "$identity_email"
  clear_binding_transaction_state
  return 0
}

commit_persistent_binding() {
  [ "$transaction_mode" = binding ] || return 1
  # Replacing the journal with binding_committed is the atomic logical commit
  # point. Recovery rolls back before it and preserves both effects after it.
  write_transaction_journal binding_committed || return 1
  transaction_mode=binding_committed
  restore_required=false
  restoration_status=not-required
  clear_restore_quarantine || return 2
  clear_transaction_journal || return 2
  transaction_mode=none
  printf 'git-bound: %s (%s)\n' "$identity_login" "$2"
  printf 'git-author: %s <%s>\n' "$identity_name" "$identity_email"
  clear_binding_transaction_state
  return 0
}

repository_has_worktree_identity_override() {
  rhw_repo=$1
  [ "$(git -C "$rhw_repo" config --local --get extensions.worktreeConfig 2>/dev/null || true)" = true ] || \
    return 1
  for rhw_key in github.account credential.username user.name user.email; do
    [ -z "$(git -C "$rhw_repo" config --worktree --get-all "$rhw_key" 2>/dev/null || true)" ] || return 0
  done
  return 1
}

check_required_scopes() {
  crs_user=$1
  crs_required=$2
  crs_have=$(account_scopes "$crs_user")
  crs_missing=
  old_ifs=$IFS
  IFS=,
  for crs_scope in $crs_required; do
    IFS=$old_ifs
    crs_scope=$(printf '%s' "$crs_scope" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$crs_scope" ] && { IFS=,; continue; }
    case ",$(printf '%s' "$crs_have" | tr -d ' ')," in
      *,"$crs_scope",*) ;;
      *) [ -n "$crs_missing" ] && crs_missing="$crs_missing,$crs_scope" || crs_missing=$crs_scope ;;
    esac
    IFS=,
  done
  IFS=$old_ifs
  [ -z "$crs_missing" ]
}

doctor_command() {
  dc_repo_arg=
  dc_account=
  dc_deep=false
  dc_json=false
  dc_dependency=false
  dc_safety=false
  dc_config=false
  dc_tempfail=false
  dc_git_safe=true
  dc_account_invalid=false
  dc_operation_reported=false
  dc_snapshot_locked=false
  dc_operation_busy=false
  dc_probe_disabled=false
  dc_lock_exit=$EXIT_TEMPFAIL
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --account) [ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--account requires USER"; dc_account=$2; shift 2 ;;
      --deep) dc_deep=true; shift ;;
      --json) dc_json=true; shift ;;
      --*) die_code "$EXIT_USAGE" "unknown doctor option '$1'" ;;
      *) [ -z "$dc_repo_arg" ] || die_code "$EXIT_USAGE" "doctor accepts only one repository"; dc_repo_arg=$1; shift ;;
    esac
  done
  if [ -n "$dc_account" ] && ! validate_login "$dc_account"; then
    dc_account_invalid=true
    dc_account=
  fi
  if ! command_exists jq; then
    if [ "$dc_json" = true ]; then
      dc_report_host=$host
      validate_host || dc_report_host=invalid-redacted
      printf '%s\n' "{\"schema\":\"gh-account.diagnostic.v1\",\"status\":\"error\",\"mutation_performed\":false,\"host\":\"$dc_report_host\",\"account\":\"\",\"repository\":\"\",\"channels\":{\"gh_keyring\":\"unchecked\",\"api\":\"unchecked\",\"git_https\":\"unchecked\",\"git_ssh\":\"unchecked\",\"connector\":\"unchecked\"},\"findings\":[{\"id\":\"DEPENDENCY.MISSING\",\"severity\":\"error\",\"summary\":\"required dependency jq is unavailable\",\"safe_to_automate\":false,\"requires_operator\":true,\"retryable\":false,\"remediation_argv\":[]}],\"exit_origin\":\"gh-account\"}"
    else
      printf 'error: DEPENDENCY.MISSING: required dependency jq is unavailable\n' >&2
    fi
    return "$EXIT_UNAVAILABLE"
  fi
  init_findings || return "$EXIT_FAILURE"
  [ "$dc_account_invalid" = false ] || add_finding ACCOUNT.INVALID error "requested account login is invalid and was redacted" false true false
  if [ -n "$gh_context_overrides" ]; then
    add_finding CONTEXT.GH_CONFIG_OVERRIDE error "GitHub CLI configuration overrides prevent authoritative account diagnostics" false true false
    dc_safety=true
    dc_probe_disabled=true
    dc_git_safe=false
    channel_gh=overridden
  fi
  dc_transport_overrides=$(gh_transport_override_names)
  if [ -n "$dc_transport_overrides" ]; then
    add_finding CONTEXT.GH_TRANSPORT_OVERRIDE error "GitHub transport or debug overrides prevent secret-safe authoritative diagnostics" false true false
    dc_safety=true
    dc_probe_disabled=true
    dc_git_safe=false
    channel_gh=overridden
  fi
  if ! validate_host; then
    host=invalid-redacted
    add_finding CONFIG.INVALID_HOST error "configured GitHub host is invalid and was redacted" false true false
    render_diagnostic "$dc_json" "$dc_account" "" gh-account
    emit_event doctor.completed failed action_required "$EXIT_CONFIG" gh-account "$dc_account" "" "$restoration_status"
    return "$EXIT_CONFIG"
  fi
  acquire_lock
  dc_lock_status=$?
  case "$dc_lock_status" in
    0) dc_snapshot_locked=true ;;
    2)
      add_finding LOCK.BUSY error "another account-routed operation is in progress; identity checks were skipped" false false true
      dc_operation_busy=true
      dc_tempfail=true
      ;;
    3)
      add_finding DEPENDENCY.MISSING error "no supported advisory lock backend is available" false true false
      dc_dependency=true
      dc_operation_busy=true
      dc_lock_exit=$EXIT_UNAVAILABLE
      ;;
    *)
      add_finding LOCK.UNSAFE error "the account-operation lock could not be validated safely" false true false
      dc_safety=true
      dc_operation_busy=true
      dc_lock_exit=$EXIT_NOPERM
      ;;
  esac
  transaction_journal_status
  dc_transaction_status=$?
  if [ "$dc_transaction_status" -eq 0 ]; then
    if operation_in_progress; then
      add_finding OPERATION.IN_PROGRESS warning "an account-routed configuration transaction is in progress" false false true
      dc_operation_reported=true
    else
      add_finding CONFIG.RECOVERY_PENDING critical "an interrupted Git configuration transaction requires automatic recovery" false false true
      dc_tempfail=true
    fi
  elif [ "$dc_transaction_status" -eq 2 ]; then
    add_finding CONFIG.RECOVERY_PENDING critical "Git configuration recovery metadata is unsafe or malformed" false true false
    dc_tempfail=true
  fi
  dc_quarantine=$(restore_quarantine_target 2>/dev/null)
  dc_quarantine_status=$?
  if [ "$dc_quarantine_status" -eq 0 ]; then
    if operation_in_progress; then
      if [ "$dc_operation_reported" = false ]; then
        add_finding OPERATION.IN_PROGRESS warning "an account-routed operation is in progress; restoration remains armed" false false true
        dc_operation_reported=true
      fi
    else
      add_finding RESTORE.QUARANTINED critical "a prior account restoration failed; only recovery of that prior account is allowed" false true true gh-account preflight "$dc_quarantine" --json
      dc_tempfail=true
    fi
  elif [ "$dc_quarantine_status" -eq 2 ]; then
    add_finding RESTORE.QUARANTINED critical "account restoration quarantine metadata is unsafe or malformed" false true false
    dc_tempfail=true
  fi
  if [ "$dc_operation_busy" = true ]; then
    render_diagnostic "$dc_json" "$dc_account" "" gh-account
    emit_event doctor.completed "$(event_outcome "$dc_lock_exit")" "$(diagnostic_status)" \
      "$dc_lock_exit" gh-account "$dc_account" "" "$restoration_status"
    return "$dc_lock_exit"
  fi
  dc_git_overrides=$(git_context_override_names)
  if [ -n "$dc_git_overrides" ]; then
    add_finding CONTEXT.GIT_ENV_OVERRIDE error "Git context overrides prevent authoritative repository diagnostics" false true false
    dc_safety=true
    dc_git_safe=false
  fi
  if ! validate_host; then
    add_finding CONFIG.INVALID_HOST error "configured GitHub host is invalid" false true false
  fi
  if ! command_exists gh; then
    add_finding DEPENDENCY.MISSING error "required dependency gh is unavailable" false true false
    dc_dependency=true
  fi
  if ! command_exists git; then
    add_finding DEPENDENCY.MISSING error "required dependency git is unavailable" false true false
    dc_dependency=true
  fi
  if ! gh_config_posture_is_safe; then
    add_finding CONFIG.UNSAFE_PERMISSIONS error "GitHub CLI configuration ownership, permissions, links, or ACLs are unsafe" false true false
    dc_safety=true
    dc_probe_disabled=true
    channel_gh=unsafe
  fi
  if command_exists git && [ "$dc_git_safe" = true ] && ! git_config_posture_is_safe; then
    add_finding CONFIG.UNSAFE_PERMISSIONS error "Git configuration ownership, permissions, or ACLs are unsafe" false true false
    dc_safety=true
    dc_git_safe=false
  fi
  dc_overrides=$(token_override_names)
  if [ -n "$dc_overrides" ]; then
    add_finding AUTH.ENV_OVERRIDE error "environment token override prevents stored-account routing ($dc_overrides)" false true false
    dc_safety=true
    dc_probe_disabled=true
    channel_gh=overridden
  fi
  [ -z "$original_gh_config_dir" ] || add_finding CONTEXT.CUSTOM_GH_CONFIG info "GH_CONFIG_DIR explicitly selects the trusted GitHub CLI state directory" false false false
  [ "${GH_HOST+x}" != x ] || add_finding CONTEXT.GH_HOST_OVERRIDE info "GH_HOST is overridden by the router's configured host" false false false
  if command_exists gh && validate_host && [ "$dc_operation_busy" = false ] && \
     [ "$dc_probe_disabled" = false ]; then
    refresh_accounts
    dc_accounts_status=$?
    if [ "$dc_accounts_status" -eq 1 ]; then
      if [ -n "$accounts_stderr_file" ] && grep -Eqi 'keychain|keyring|exit status 161|credential store' "$accounts_stderr_file"; then
        add_finding AUTH.KEYCHAIN_CONTEXT_UNAVAILABLE error "native keyring is unavailable in this execution context" false true true
      elif add_last_network_finding; then
        dc_tempfail=true
      else
        add_finding AUTH.STATUS_FAILED error "GitHub CLI authentication status failed" false false true gh-account doctor --json
      fi
      channel_gh=unavailable
    elif [ "$dc_accounts_status" -eq 2 ]; then
      add_finding AUTH.STATUS_MALFORMED error "GitHub CLI returned an unsupported authentication JSON shape" false false false
      channel_gh=unavailable
    else
      dc_active_count=$(active_count)
      [ "$dc_active_count" -eq 1 ] || add_finding AUTH.ACTIVE_COUNT error "GitHub CLI must have exactly one active account for this host" false true false
      if [ "$dc_account_invalid" = false ] && [ -z "$dc_account" ]; then
        dc_account=$(active_account)
      fi
      if [ -n "$dc_account" ]; then
        if ! stored_account "$dc_account"; then
          add_finding ACCOUNT.NOT_STORED error "requested account is not stored in GitHub CLI" false true false gh-account onboard "$dc_account"
          auth_action_required=true
          channel_gh=missing
        elif ! healthy_account "$dc_account"; then
          dc_state=$(account_state "$dc_account")
          if [ "$dc_state" = timeout ]; then
            add_finding NETWORK.TIMEOUT error "native GitHub authentication status timed out" false false true gh-account doctor --account "$dc_account" --deep --json
          else
            add_finding AUTH.STATUS_FAILED error "native GitHub authentication state is unavailable; credential invalidity is not proven" false false true gh-account doctor --account "$dc_account" --deep --json
          fi
          channel_gh=unavailable
        else
          dc_account=$(canonical_account "$dc_account")
          channel_gh=healthy
          dc_source=$(account_source "$dc_account")
          if [ "$dc_source" != keyring ]; then
            add_finding AUTH.PLAINTEXT_STORAGE error "credential is not stored in the native keyring" false true false gh-account reauth "$dc_account"
            auth_action_required=true
            channel_gh=invalid
          fi
        fi
      elif [ "$dc_account_invalid" = false ]; then
        add_finding ACCOUNT.NO_ACTIVE error "no active GitHub CLI account is configured" false true false
        auth_action_required=true
        channel_gh=missing
      fi
      make_temp || return "$EXIT_FAILURE"
      dc_unhealthy_file=$new_temp_path
      printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" '.hosts[$host][] | select(.state != "success") | [.login,.state] | @tsv' >"$dc_unhealthy_file"
      dc_tab=$(printf '\t')
      while IFS="$dc_tab" read -r dc_bad dc_bad_state; do
        [ -n "$dc_bad" ] || continue
        if [ "$(printf '%s' "$dc_bad" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$dc_account" | tr '[:upper:]' '[:lower:]')" ]; then
          if [ "$dc_bad_state" = timeout ]; then
            add_finding AUTH.UNRELATED_INVALID warning "another stored account has a transient authentication timeout" true false true gh-account doctor --account "$dc_bad" --deep --json
          else
            add_finding AUTH.UNRELATED_INVALID warning "another stored account is not healthy; credential invalidity is not proven" true false true gh-account doctor --account "$dc_bad" --deep --json
          fi
        fi
      done <"$dc_unhealthy_file"
    fi
  fi
  dc_repo=
  dc_bound=
  dc_name=
  dc_email=
  if [ -n "$dc_repo_arg" ] && command_exists git && [ "$dc_git_safe" = true ]; then
    dc_repo=$(repository_root "$dc_repo_arg" 2>/dev/null || true)
    if [ -z "$dc_repo" ]; then
      add_finding REPO.NOT_GIT error "repository path is not a Git worktree" false true false
    elif ! git_config_posture_is_safe "$dc_repo"; then
      add_finding CONFIG.UNSAFE_PERMISSIONS error "repository Git configuration ownership, permissions, or ACLs are unsafe" false true false
      dc_safety=true
      dc_git_safe=false
    else
      parse_remote "$dc_repo"
      dc_remote_status=$?
      case "$dc_remote_status" in
        0)
          [ "$remote_protocol" = https ] && channel_git_https=configured
          if [ "$remote_protocol" = ssh ]; then
            channel_git_ssh=unverified
            add_finding GIT.SSH_UNVERIFIED warning "SSH account identity is not proven; use an HTTPS origin with routed git-exec" false true false
          fi
          if [ "$remote_protocol" = mixed ]; then
            channel_git_https=configured
            channel_git_ssh=unverified
            add_finding GIT.SSH_UNVERIFIED warning "mixed HTTPS and SSH routing cannot prove one account identity" false true false
          fi
          if [ "$remote_protocol" = http ]; then
            add_finding GIT.INSECURE_REMOTE error "origin uses insecure HTTP" false true false gh-account repair "$dc_account" "$dc_repo"
            dc_config=true
          fi
          ;;
        1) add_finding REPO.NO_ORIGIN warning "repository has no origin remote" false true false ;;
        2)
          add_finding REPO.CREDENTIAL_URL error "origin URL contains embedded credential material" false true false
          dc_safety=true
          ;;
        4)
          add_finding REPO.REMOTE_MISMATCH error "origin fetch and push URLs target different repositories" false true false
          dc_safety=true
          ;;
        *) add_finding REPO.UNSUPPORTED_REMOTE warning "origin URL is not supported by account inference" false true false ;;
      esac
      dc_marker=$(git -C "$dc_repo" config --local --get github.account 2>/dev/null || true)
      dc_credential=$(git -C "$dc_repo" config --local --get credential.username 2>/dev/null || true)
      dc_binding_invalid=false
      [ -z "$dc_marker" ] || validate_login "$dc_marker" || dc_binding_invalid=true
      [ -z "$dc_credential" ] || validate_login "$dc_credential" || dc_binding_invalid=true
      if [ "$dc_binding_invalid" = true ]; then
        add_finding REPO.INVALID_BINDING error "repository account metadata is invalid and was redacted" false true false
        dc_safety=true
        dc_marker=
        dc_credential=
      fi
      dc_bound=${dc_marker:-$dc_credential}
      dc_name=$(git -C "$dc_repo" config --local --get user.name 2>/dev/null || true)
      dc_email=$(git -C "$dc_repo" config --local --get user.email 2>/dev/null || true)
      if [ -z "$dc_bound" ]; then
        if [ -n "${remote_owner:-}" ] && stored_account "$remote_owner" 2>/dev/null; then
          add_finding REPO.UNBOUND warning "repository is unbound; personal-owner inference is available" false true false gh-account repair "$remote_owner" "$dc_repo"
        else
          add_finding REPO.AMBIGUOUS_ACCOUNT error "repository account cannot be inferred safely" false true false
          dc_config=true
        fi
      elif [ -n "$dc_account" ] && [ "$(printf '%s' "$dc_bound" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$dc_account" | tr '[:upper:]' '[:lower:]')" ]; then
        add_finding REPO.BINDING_MISMATCH error "repository binding differs from the requested account" false true false gh-account repair "$dc_account" "$dc_repo"
        dc_config=true
      fi
      if [ -n "$dc_marker" ] && [ -n "$dc_credential" ] && [ "$(printf '%s' "$dc_marker" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$dc_credential" | tr '[:upper:]' '[:lower:]')" ]; then
        add_finding REPO.BINDING_MISMATCH error "repository account marker and HTTPS credential username disagree" false true false gh-account repair "$dc_marker" "$dc_repo"
        dc_config=true
      fi
      if [ -n "$dc_bound" ]; then
        dc_identity_ok=true
        [ "$dc_credential" = "$dc_bound" ] || dc_identity_ok=false
        commit_name_is_configured "$dc_name" || dc_identity_ok=false
        noreply_email_matches_login "$dc_bound" "$dc_email" || dc_identity_ok=false
        [ "$dc_identity_ok" = true ] || add_finding IDENTITY.MISMATCH error "repository credential and commit identity are inconsistent" false true false gh-account repair "$dc_bound" "$dc_repo"
      fi
      repository_transport_overrides "$dc_repo" || return "$EXIT_FAILURE"
      if [ "$repository_helper_override" = true ]; then
        add_finding GIT.CREDENTIAL_OVERRIDE error "an unscoped effective credential helper can bypass account routing" false true false
        dc_safety=true
      fi
      if [ "$repository_username_override" = true ]; then
        add_finding GIT.CREDENTIAL_OVERRIDE error "a URL-specific credential username conflicts with the repository binding" false true false
        dc_safety=true
      fi
      if [ "$repository_header_override" = true ]; then
        add_finding GIT.EXTRA_HEADER error "an effective Git HTTP authorization header bypasses native credential routing" false true false
        dc_safety=true
      fi
      if [ "$repository_tls_unsafe" = true ]; then
        add_finding GIT.TLS_OVERRIDE error "repository Git TLS settings weaken authoritative HTTPS routing" false true false
        dc_safety=true
      fi
      if [ "$repository_proxy_configured" = true ]; then
        add_finding NETWORK.PROXY_CONFIGURED warning "Git HTTPS uses an explicit proxy; diagnose it separately from credential health" false false true
      fi
      if [ "$repository_use_http_path_unsafe" = true ]; then
        add_finding GIT.USE_HTTP_PATH error "effective Git credential routing disables useHttpPath for this repository" false true false
        dc_safety=true
      fi
      if [ "$repository_use_config_only_unsafe" = true ]; then
        add_finding GIT.USE_CONFIG_ONLY error "effective Git identity routing disables user.useConfigOnly for this repository" false true false
        dc_safety=true
      fi
      if [ "$repository_url_rewrite" = true ]; then
        add_finding GIT.URL_REWRITE error "an effective Git URL rewrite prevents authoritative remote verification" false true false
        dc_safety=true
      fi
    fi
  fi
  if command_exists git && [ "$dc_git_safe" = true ]; then
    dc_use_path=$(git config --global --get "credential.https://$host.useHttpPath" 2>/dev/null || true)
    [ "$dc_use_path" = true ] || add_repair_remediation_finding GIT.USE_HTTP_PATH warning \
      "Git HTTPS account routing is not enabled globally" "$dc_account" "$dc_repo"
    dc_use_only=$(git config --global --get user.useConfigOnly 2>/dev/null || true)
    [ "$dc_use_only" = true ] || add_repair_remediation_finding GIT.USE_CONFIG_ONLY warning \
      "Git may synthesize an unintended commit identity" "$dc_account" "$dc_repo"
    if ! native_helper_configured "$host" "$dc_repo"; then
      add_repair_remediation_finding GIT.CREDENTIAL_HELPER error \
        "native GitHub CLI credential helper chain is missing or unexpected" "$dc_account" "$dc_repo"
      dc_config=true
    fi
  fi
  if [ "$channel_gh" = healthy ]; then
    dc_active=$(active_account)
    if [ "$(printf '%s' "$dc_active" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$dc_account" | tr '[:upper:]' '[:lower:]')" ]; then
      if resolve_active_identity "$dc_account"; then
        channel_api=healthy
        if [ -n "$dc_repo" ] && [ -n "$dc_bound" ] && [ "$dc_email" != "$identity_email" ]; then
          add_finding IDENTITY.MISMATCH error "repository commit email is not the canonical account noreply identity" false true false gh-account repair "$dc_account" "$dc_repo"
        fi
      else
        channel_api=failed
        if add_last_network_finding; then
          dc_tempfail=true
        else
          add_preflight_remediation_finding AUTH.IDENTITY_MISMATCH error \
            "API identity does not match the selected account" false true false "$dc_account" "$dc_repo"
          auth_action_required=true
        fi
      fi
    elif [ "$dc_deep" = true ]; then
      channel_api=skipped
      add_preflight_remediation_finding AUTH.DEEP_CHECK_SKIPPED warning \
        "deep API check requires preflight for an inactive account" false false false "$dc_account" "$dc_repo"
    else
      channel_api=skipped
    fi
  fi
  if [ "$dc_snapshot_locked" = true ] && ! release_lock; then
    add_finding LOCK.RELEASE_FAILED critical "the diagnostic snapshot lock could not be released" false true true
    dc_tempfail=true
  fi
  render_diagnostic "$dc_json" "$dc_account" "$dc_repo" gh-account
  dc_status=0
  if [ "$finding_errors" -gt 0 ]; then
    if [ "$dc_dependency" = true ]; then
      dc_status=$EXIT_UNAVAILABLE
    elif [ "$dc_tempfail" = true ]; then
      dc_status=$EXIT_TEMPFAIL
    elif [ "$dc_safety" = true ]; then
      dc_status=$EXIT_NOPERM
    elif [ "$auth_action_required" = true ]; then
      dc_status=$EXIT_AUTH
    elif [ "$dc_config" = true ]; then
      dc_status=$EXIT_CONFIG
    else
      dc_status=$EXIT_FAILURE
    fi
  fi
  emit_event doctor.completed "$(event_outcome "$dc_status")" "$(diagnostic_status)" "$dc_status" gh-account "$dc_account" "$dc_repo" "$restoration_status"
  return "$dc_status"
}

preflight_command() {
  [ "$#" -ge 1 ] || die_code "$EXIT_USAGE" "preflight requires USER"
  pf_user=$1
  shift
  validate_login "$pf_user" || die_code "$EXIT_USAGE" "invalid account login"
  pf_repo_arg=
  pf_scopes=
  pf_json=false
  pf_config_required=false
  pf_safety_required=false
  pf_tempfail_required=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --required-scopes) [ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--required-scopes requires LIST"; pf_scopes=$2; shift 2 ;;
      --json) pf_json=true; shift ;;
      --*) die_code "$EXIT_USAGE" "unknown preflight option '$1'" ;;
      *) [ -z "$pf_repo_arg" ] || die_code "$EXIT_USAGE" "preflight accepts only one repository"; pf_repo_arg=$1; shift ;;
    esac
  done
  if [ -n "$pf_scopes" ]; then
    pf_scopes=$(normalize_scope_list "$pf_scopes") || die_code "$EXIT_USAGE" "required scopes are invalid"
  fi
  if ! command_exists jq || ! command_exists gh || ! command_exists git; then
    die_code "$EXIT_UNAVAILABLE" "preflight requires gh, git, and jq"
  fi
  init_findings || return "$EXIT_FAILURE"
  pf_git_overrides=$(git_context_override_names)
  if [ -n "$pf_git_overrides" ]; then
    add_finding CONTEXT.GIT_ENV_OVERRIDE error "Git context overrides prevent authoritative preflight" false true false
    render_diagnostic "$pf_json" "$pf_user" "" gh-account
    emit_event preflight.completed refused action_required "$EXIT_NOPERM" gh-account "$pf_user" "" "$restoration_status"
    return "$EXIT_NOPERM"
  fi
  pf_repo=
  if [ -n "$pf_repo_arg" ]; then
    pf_repo=$(repository_root "$pf_repo_arg" 2>/dev/null || true)
    if [ -z "$pf_repo" ]; then
      add_finding REPO.NOT_GIT error "repository path is not a Git worktree" false true false
      pf_config_required=true
    fi
  fi
  if ! git_config_posture_is_safe "$pf_repo"; then
    add_finding CONFIG.UNSAFE_PERMISSIONS error "Git configuration ownership, permissions, or ACLs are unsafe" false true false
    render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
    emit_event preflight.completed refused action_required "$EXIT_NOPERM" gh-account "$pf_user" "$pf_repo" "$restoration_status"
    return "$EXIT_NOPERM"
  fi
  if [ -n "$(token_override_names)" ]; then
    add_finding AUTH.ENV_OVERRIDE error "environment token override prevents stored-account preflight" false true false
    channel_gh=overridden
    render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
    emit_event preflight.completed refused action_required "$EXIT_NOPERM" gh-account "$pf_user" "$pf_repo" "$restoration_status"
    return "$EXIT_NOPERM"
  fi
  refresh_accounts
  pf_accounts_status=$?
  if [ "$pf_accounts_status" -ne 0 ]; then
    pf_initial_status=$EXIT_FAILURE
    if [ "$pf_accounts_status" -eq 1 ] && add_last_network_finding; then
      pf_initial_status=$EXIT_TEMPFAIL
    else
      add_finding AUTH.STATUS_FAILED error "GitHub CLI authentication status failed" false false true gh-account doctor --json
    fi
    channel_gh=unavailable
    render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
    emit_event preflight.completed failed action_required "$pf_initial_status" gh-account "$pf_user" "$pf_repo" "$restoration_status"
    return "$pf_initial_status"
  fi
  if ! stored_account "$pf_user"; then
    add_finding ACCOUNT.NOT_STORED error "requested account is not stored in GitHub CLI" false true false gh-account onboard "$pf_user"
    auth_action_required=true
  elif ! healthy_account "$pf_user"; then
    pf_state=$(account_state "$pf_user")
    if [ "$pf_state" = timeout ]; then
      add_preflight_remediation_finding NETWORK.TIMEOUT error \
        "native GitHub authentication status timed out" false false true "$pf_user" "$pf_repo"
      pf_tempfail_required=true
    else
      add_finding AUTH.STATUS_FAILED error "native GitHub authentication state is unavailable; credential invalidity is not proven" false false true gh-account doctor --account "$pf_user" --deep --json
    fi
  elif ! keyring_account "$pf_user"; then
    add_finding AUTH.PLAINTEXT_STORAGE error "stored credential is not in the native keyring" false true false gh-account reauth "$pf_user"
    auth_action_required=true
  fi
  if [ "$finding_errors" -gt 0 ]; then
    pf_initial_status=$EXIT_FAILURE
    channel_gh=unavailable
    if [ "$auth_action_required" = true ]; then
      pf_initial_status=$EXIT_AUTH
      channel_gh=invalid
    elif [ "$pf_tempfail_required" = true ]; then
      pf_initial_status=$EXIT_TEMPFAIL
    fi
    render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
    emit_event preflight.completed failed action_required "$pf_initial_status" gh-account "$pf_user" "$pf_repo" "$restoration_status"
    return "$pf_initial_status"
  fi
  pf_user=$(canonical_account "$pf_user") || return "$EXIT_FAILURE"
  begin_operation "$pf_user" false false
  pf_begin=$?
  if [ "$pf_begin" -ne 0 ]; then
    if [ "$pf_begin" -eq 2 ]; then
      add_finding LOCK.BUSY error "another account operation holds the lock" false false true
    elif [ "$pf_begin" -eq 5 ]; then
      add_finding RESTORE.QUARANTINED critical "a prior restoration failure quarantines account switching until the previous account recovers" false true true
    elif [ "$pf_begin" -eq 6 ]; then
      add_finding CONFIG.RECOVERY_PENDING critical "an interrupted Git configuration transaction could not be recovered safely" false true true
    elif [ "$pf_begin" -eq 7 ]; then
      add_finding ACCOUNT.NO_ACTIVE error "temporary routing requires one previously active account that can be restored" false true false gh-account use "$pf_user"
    elif [ "$pf_begin" -eq 3 ]; then
      add_finding DEPENDENCY.MISSING error "no supported operation-lock backend is available" false true false
    elif [ "$pf_begin" -eq 8 ]; then
      add_finding LOCK.UNSAFE error "the account-operation lock could not be validated safely" false true false
    else
      add_finding AUTH.SWITCH_FAILED error "could not select the requested account" false true true
    fi
    pf_begin_exit=$EXIT_TEMPFAIL
    [ "$pf_begin" -ne 7 ] || pf_begin_exit=$EXIT_AUTH
    [ "$pf_begin" -ne 3 ] || pf_begin_exit=$EXIT_UNAVAILABLE
    [ "$pf_begin" -ne 8 ] || pf_begin_exit=$EXIT_NOPERM
    render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
    emit_event preflight.completed failed action_required "$pf_begin_exit" gh-account "$pf_user" "$pf_repo" "$restoration_status"
    return "$pf_begin_exit"
  fi
  channel_gh=healthy
  if resolve_active_identity "$pf_user"; then
    channel_api=healthy
  else
    channel_api=failed
    if add_last_network_finding; then
      pf_tempfail_required=true
    else
      add_finding AUTH.IDENTITY_MISMATCH error "API identity does not match the selected account" false true false gh-account reauth "$pf_user"
      auth_action_required=true
    fi
  fi
  if ! refresh_accounts; then
    if add_last_network_finding; then
      pf_tempfail_required=true
    else
      add_finding AUTH.STATUS_FAILED error "post-switch authentication status failed" false false true
    fi
  fi
  if [ -n "$pf_scopes" ] && ! check_required_scopes "$pf_user" "$pf_scopes"; then
    add_finding AUTH.SCOPE_MISSING error "selected account lacks one or more required scopes" false true false gh-account reauth "$pf_user" --scopes "$pf_scopes"
    auth_action_required=true
  fi
  if [ -n "$pf_repo" ]; then
    pf_marker=$(git -C "$pf_repo" config --local --get github.account 2>/dev/null || true)
    pf_credential=$(git -C "$pf_repo" config --local --get credential.username 2>/dev/null || true)
    pf_name=$(git -C "$pf_repo" config --local --get user.name 2>/dev/null || true)
    pf_email=$(git -C "$pf_repo" config --local --get user.email 2>/dev/null || true)
    pf_effective_marker=$(git -C "$pf_repo" config --get github.account 2>/dev/null || true)
    pf_effective_credential=$(git -C "$pf_repo" config --get credential.username 2>/dev/null || true)
    pf_effective_name=$(git -C "$pf_repo" config --get user.name 2>/dev/null || true)
    pf_effective_email=$(git -C "$pf_repo" config --get user.email 2>/dev/null || true)
    pf_expected=$(printf '%s' "$pf_user" | tr '[:upper:]' '[:lower:]')
    if [ -z "$pf_marker" ] || [ -z "$pf_credential" ] || \
       [ "$(printf '%s' "$pf_marker" | tr '[:upper:]' '[:lower:]')" != "$pf_expected" ] || \
       [ "$(printf '%s' "$pf_credential" | tr '[:upper:]' '[:lower:]')" != "$pf_expected" ]; then
      add_finding REPO.BINDING_MISMATCH error "repository is not bound to the selected account" false true false gh-account repair "$pf_user" "$pf_repo"
      pf_config_required=true
    fi
    if [ "$pf_effective_marker" != "$pf_marker" ] || \
       [ "$pf_effective_credential" != "$pf_credential" ] || \
       [ "$pf_effective_name" != "$pf_name" ] || \
       [ "$pf_effective_email" != "$pf_email" ]; then
      add_finding REPO.BINDING_MISMATCH error "effective Git identity overrides the required repository-local binding" false true false
      pf_safety_required=true
    fi
    if ! commit_name_is_configured "$pf_name"; then
      add_finding IDENTITY.MISMATCH error "repository commit author name is not configured" false true false gh-account repair "$pf_user" "$pf_repo"
      pf_config_required=true
    fi
    if [ "$channel_api" = healthy ] && [ "$pf_email" != "$identity_email" ]; then
      add_finding IDENTITY.MISMATCH error "repository commit email does not match the canonical selected-account identity" false true false gh-account repair "$pf_user" "$pf_repo"
      pf_config_required=true
    fi
    parse_remote "$pf_repo"
    pf_remote_status=$?
    case "$pf_remote_status" in
      0)
        [ "$remote_protocol" = https ] && channel_git_https=configured
        if [ "$remote_protocol" = ssh ]; then
          channel_git_ssh=unverified
          add_finding GIT.SSH_UNVERIFIED error "SSH account identity is not proven; use an HTTPS origin with routed git-exec" false true false
          pf_config_required=true
        fi
        if [ "$remote_protocol" = mixed ]; then
          channel_git_https=configured
          channel_git_ssh=unverified
          add_finding GIT.SSH_UNVERIFIED error "mixed HTTPS and SSH routing cannot prove one account identity" false true false
          pf_config_required=true
        fi
        if [ "$remote_protocol" = http ]; then
          add_finding GIT.INSECURE_REMOTE error "origin uses insecure HTTP" false true false gh-account repair "$pf_user" "$pf_repo"
          pf_config_required=true
        fi
        repository_transport_overrides "$pf_repo" || return "$EXIT_FAILURE"
        if [ "$repository_helper_override" = true ]; then
          add_finding GIT.CREDENTIAL_OVERRIDE error "the effective credential helper can bypass native account routing" false true false
          pf_safety_required=true
        fi
        if [ "$repository_username_override" = true ]; then
          add_finding GIT.CREDENTIAL_OVERRIDE error "a URL-specific credential username conflicts with the repository binding" false true false
          pf_safety_required=true
        fi
        if [ "$repository_header_override" = true ]; then
          add_finding GIT.EXTRA_HEADER error "an effective Git HTTP authorization header bypasses native credential routing" false true false
          pf_safety_required=true
        fi
        if [ "$repository_tls_unsafe" = true ]; then
          add_finding GIT.TLS_OVERRIDE error "repository Git TLS settings weaken authoritative HTTPS routing" false true false
          pf_safety_required=true
        fi
        if [ "$repository_proxy_configured" = true ]; then
          add_finding NETWORK.PROXY_CONFIGURED error "Git HTTPS uses an unreviewed proxy and routed Git is refused" false true false
          pf_safety_required=true
        fi
        if [ "$repository_use_http_path_unsafe" = true ]; then
          add_finding GIT.USE_HTTP_PATH error "effective Git credential routing disables useHttpPath for this repository" false true false
          pf_safety_required=true
        fi
        if [ "$repository_use_config_only_unsafe" = true ]; then
          add_finding GIT.USE_CONFIG_ONLY error "effective Git identity routing disables user.useConfigOnly for this repository" false true false
          pf_safety_required=true
        fi
        if [ "$repository_url_rewrite" = true ]; then
          add_finding GIT.URL_REWRITE error "an effective Git URL rewrite prevents authoritative remote verification" false true false
          pf_safety_required=true
        fi
        make_temp || return "$EXIT_FAILURE"
        pf_repo_error=$new_temp_path
        make_temp || return "$EXIT_FAILURE"
        pf_repo_output=$new_temp_path
        if run_tracked env GH_HOST="$host" gh repo view "$remote_owner/$remote_repo" \
          --json nameWithOwner >"$pf_repo_output" 2>"$pf_repo_error"; then
          :
        elif classify_network_error "$pf_repo_error" && add_last_network_finding; then
          pf_tempfail_required=true
        elif grep -Eqi '(^|[^0-9])401([^0-9]|$)|bad credentials|requires authentication|not logged in' "$pf_repo_error"; then
          add_finding AUTH.INVALID error "repository API request requires authentication" false true false gh-account reauth "$pf_user"
          auth_action_required=true
        else
          add_finding REPO.FORBIDDEN error "selected account cannot access the repository through the API" false true false
        fi
        ;;
      1)
        add_finding REPO.NO_ORIGIN error "repository has no origin remote to verify" false true false
        pf_config_required=true
        ;;
      2)
        add_finding REPO.CREDENTIAL_URL error "origin URL contains embedded credential material" false true false
        pf_safety_required=true
        ;;
      4)
        add_finding REPO.REMOTE_MISMATCH error "origin fetch and push URLs target different repositories" false true false
        pf_safety_required=true
        ;;
      *)
        add_finding REPO.UNSUPPORTED_REMOTE error "repository origin cannot be verified through GitHub CLI" false true false
        pf_config_required=true
        ;;
    esac
  fi
  pf_use_path=$(git config --global --get "credential.https://$host.useHttpPath" 2>/dev/null || true)
  if [ "$pf_use_path" != true ]; then
    add_repair_remediation_finding GIT.USE_HTTP_PATH error \
      "Git HTTPS account routing is not enabled globally" "$pf_user" "$pf_repo"
    pf_config_required=true
  fi
  pf_use_only=$(git config --global --get user.useConfigOnly 2>/dev/null || true)
  if [ "$pf_use_only" != true ]; then
    add_repair_remediation_finding GIT.USE_CONFIG_ONLY error \
      "Git may synthesize an unintended commit identity" "$pf_user" "$pf_repo"
    pf_config_required=true
  fi
  if ! native_helper_configured "$host" "$pf_repo"; then
    add_repair_remediation_finding GIT.CREDENTIAL_HELPER error \
      "native GitHub CLI credential helper chain is missing or unexpected" "$pf_user" "$pf_repo"
    pf_config_required=true
  fi
  pf_status=0
  if [ "$finding_errors" -ne 0 ]; then
    if [ "$pf_safety_required" = true ]; then
      pf_status=$EXIT_NOPERM
    elif [ "$pf_tempfail_required" = true ]; then
      pf_status=$EXIT_TEMPFAIL
    elif [ "$auth_action_required" = true ]; then
      pf_status=$EXIT_AUTH
    elif [ "$pf_config_required" = true ]; then
      pf_status=$EXIT_CONFIG
    else
      pf_status=$EXIT_FAILURE
    fi
  fi
  finish_operation "$pf_status"
  pf_status=$?
  if [ "$restoration_status" = failed ]; then
    add_finding RESTORE.FAILED critical "previous GitHub CLI account was not restored" false true true
    diagnostic_status_override=failed
  fi
  if [ "$last_finish_lock_failed" = true ]; then
    add_finding LOCK.RELEASE_FAILED critical "the account-operation lock could not be released safely" false true true
    diagnostic_status_override=failed
  fi
  render_diagnostic "$pf_json" "$pf_user" "$pf_repo" gh-account
  emit_event preflight.completed "$(event_outcome "$pf_status")" "$(diagnostic_status)" "$pf_status" gh-account "$pf_user" "$pf_repo" "$restoration_status"
  return "$pf_status"
}

perform_reauth() {
  pra_user=$1
  pra_scopes=$2
  pra_json=$3
  reauth_failure_id=
  begin_operation "$pra_user" true true
  pra_begin=$?
  if [ "$pra_begin" -ne 0 ]; then
    case "$pra_begin" in
      2) reauth_failure_id=LOCK.BUSY; return "$EXIT_TEMPFAIL" ;;
      3) reauth_failure_id=DEPENDENCY.MISSING; return "$EXIT_UNAVAILABLE" ;;
      5) reauth_failure_id=RESTORE.QUARANTINED; return "$EXIT_TEMPFAIL" ;;
      6) reauth_failure_id=CONFIG.RECOVERY_PENDING; return "$EXIT_TEMPFAIL" ;;
      8) reauth_failure_id=LOCK.UNSAFE; return "$EXIT_NOPERM" ;;
      *) reauth_failure_id=AUTH.SWITCH_FAILED ;;
    esac
    [ "$lock_held" != true ] || finish_operation "$EXIT_FAILURE" || true
    return "$EXIT_FAILURE"
  fi
  printf '%s: opening native GitHub authorization for %s\n' "$program" "$pra_user" >&2
  if [ -n "$pra_scopes" ]; then
    if [ "$pra_json" = true ]; then
      run_tracked_interactive gh auth refresh --hostname "$host" --scopes "$pra_scopes" 1>&2
    else
      run_tracked_interactive gh auth refresh --hostname "$host" --scopes "$pra_scopes"
    fi
  else
    if [ "$pra_json" = true ]; then
      run_tracked_interactive gh auth refresh --hostname "$host" 1>&2
    else
      run_tracked_interactive gh auth refresh --hostname "$host"
    fi
  fi
  pra_status=$?
  if [ "$pra_status" -eq 2 ]; then
    reauth_failure_id=AUTH.REPAIR_CANCELLED
  elif [ "$pra_status" -ne 0 ]; then
    reauth_failure_id=AUTH.REPAIR_FAILED
  else
    mutation_performed=true
    refresh_accounts
    pra_refresh_status=$?
    if [ "$pra_refresh_status" -ne 0 ]; then
      if [ "$pra_refresh_status" -eq 1 ] && [ -n "$last_network_failure" ]; then
        reauth_failure_id=$last_network_failure
        pra_status=$EXIT_TEMPFAIL
      else
        reauth_failure_id=AUTH.STATUS_FAILED
        pra_status=$EXIT_FAILURE
      fi
    elif ! healthy_account "$pra_user"; then
      reauth_failure_id=AUTH.INVALID
      pra_status=$EXIT_AUTH
    elif ! verify_effective_identity "$pra_user"; then
      if [ -n "$last_network_failure" ]; then
        reauth_failure_id=$last_network_failure
        pra_status=$EXIT_TEMPFAIL
      else
        reauth_failure_id=ACCOUNT.IDENTITY_MISMATCH
        pra_status=$EXIT_AUTH
      fi
    elif [ "$(account_source "$pra_user")" != keyring ]; then
      printf '%s: refreshed credential is not stored in the native keyring\n' "$program" >&2
      reauth_failure_id=AUTH.STORAGE_UNSAFE
      pra_status=$EXIT_FAILURE
    fi
  fi
  if [ "$pra_status" -eq 0 ] && [ "$recovery_pending" = true ]; then
    if clear_restore_quarantine; then
      recovery_pending=false
      restoration_status=recovered
    else
      pra_status=$EXIT_FAILURE
    fi
  fi
  finish_operation "$pra_status"
  pra_status=$?
  return "$pra_status"
}

reauth_command() {
  [ "$#" -ge 1 ] || die_code "$EXIT_USAGE" "reauth requires USER"
  rc_user=$1
  shift
  validate_login "$rc_user" || die_code "$EXIT_USAGE" "invalid account login"
  rc_scopes=
  rc_json=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --scopes) [ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--scopes requires LIST"; rc_scopes=$2; shift 2 ;;
      --json) rc_json=true; shift ;;
      *) die_code "$EXIT_USAGE" "unknown reauth option '$1'" ;;
    esac
  done
  if [ -n "$rc_scopes" ]; then
    rc_scopes=$(normalize_scope_list "$rc_scopes") || die_code "$EXIT_USAGE" "requested scopes are invalid"
  fi
  if ! command_exists gh || ! command_exists jq; then
    die_code "$EXIT_UNAVAILABLE" "reauth requires gh and jq"
  fi
  init_findings || return "$EXIT_FAILURE"
  if [ -n "$(token_override_names)" ]; then
    add_finding AUTH.ENV_OVERRIDE error "environment token override prevents stored-account repair" false true false
    channel_gh=overridden
    rc_status=$EXIT_NOPERM
    render_diagnostic "$rc_json" "$rc_user" "" gh-account
    emit_event auth.reauth.completed refused "$(diagnostic_status)" "$rc_status" gh-account "$rc_user" "" "$restoration_status"
    return "$rc_status"
  fi
  refresh_accounts
  rc_accounts_status=$?
  if [ "$rc_accounts_status" -ne 0 ]; then
    rc_status=$EXIT_FAILURE
    if [ "$rc_accounts_status" -eq 1 ] && add_last_network_finding; then
      rc_status=$EXIT_TEMPFAIL
    else
      add_finding AUTH.STATUS_FAILED error "GitHub CLI authentication status could not be read" false false true gh-account doctor --json
    fi
    channel_gh=unavailable
    render_diagnostic "$rc_json" "$rc_user" "" gh-account
    emit_event auth.reauth.completed failed "$(diagnostic_status)" "$rc_status" gh-account "$rc_user" "" "$restoration_status"
    return "$rc_status"
  fi
  if ! stored_account "$rc_user"; then
    add_finding ACCOUNT.NOT_STORED error "requested account is not stored in GitHub CLI" false true false gh-account onboard "$rc_user"
    channel_gh=missing
    rc_status=$EXIT_AUTH
    render_diagnostic "$rc_json" "$rc_user" "" gh-account
    emit_event auth.reauth.completed failed "$(diagnostic_status)" "$rc_status" gh-account "$rc_user" "" "$restoration_status"
    return "$rc_status"
  fi
  perform_reauth "$rc_user" "$rc_scopes" "$rc_json"
  rc_status=$?
  case "${reauth_failure_id:-}" in
    AUTH.REPAIR_CANCELLED)
      add_finding AUTH.REPAIR_CANCELLED error "native GitHub authorization was cancelled" false true true gh-account reauth "$rc_user"
      diagnostic_status_override=failed
      ;;
    AUTH.REPAIR_FAILED)
      add_finding AUTH.REPAIR_FAILED error "native GitHub authorization did not complete" false true true gh-account reauth "$rc_user"
      diagnostic_status_override=failed
      ;;
    ACCOUNT.IDENTITY_MISMATCH)
      add_finding ACCOUNT.IDENTITY_MISMATCH critical "refreshed credential resolved to a different GitHub identity" false true false gh-account doctor --account "$rc_user" --deep --json
      ;;
    AUTH.INVALID)
      add_finding AUTH.INVALID error "refreshed credential is still unhealthy" false true true gh-account reauth "$rc_user"
      ;;
    AUTH.STORAGE_UNSAFE)
      add_finding AUTH.STORAGE_UNSAFE error "refreshed credential is not stored in the native keyring" false true false
      ;;
    AUTH.STATUS_FAILED)
      add_finding AUTH.STATUS_FAILED error "refreshed native authentication status could not be verified" false false true gh-account doctor --json
      ;;
    LOCK.BUSY)
      add_finding LOCK.BUSY error "another account operation holds the lock" false false true
      ;;
    LOCK.UNSAFE)
      add_finding LOCK.UNSAFE error "the account-operation lock could not be validated safely" false true false
      ;;
    DEPENDENCY.MISSING)
      add_finding DEPENDENCY.MISSING error "no supported operation-lock backend is available" false true false
      ;;
    RESTORE.QUARANTINED)
      add_finding RESTORE.QUARANTINED critical "a prior account restoration requires recovery before reauthentication" false true true
      ;;
    CONFIG.RECOVERY_PENDING)
      add_finding CONFIG.RECOVERY_PENDING critical "an interrupted Git configuration transaction requires recovery" false true true
      ;;
    AUTH.SWITCH_FAILED)
      add_finding AUTH.SWITCH_FAILED error "could not select the requested account for native refresh" false true true
      ;;
    NETWORK.TIMEOUT|NETWORK.DNS|NETWORK.PROXY|NETWORK.TLS|NETWORK.RATE_LIMIT|NETWORK.SERVICE_UNAVAILABLE|NETWORK.TRANSPORT)
      last_network_failure=$reauth_failure_id
      add_last_network_finding || true
      ;;
  esac
  if [ "$restoration_status" = failed ]; then
    add_finding RESTORE.FAILED critical "previous GitHub CLI account was not restored" false true true
    diagnostic_status_override=failed
  fi
  if [ "$last_finish_lock_failed" = true ]; then
    add_finding LOCK.RELEASE_FAILED critical "the account-operation lock could not be released safely" false true true
    diagnostic_status_override=failed
  fi
  if [ "$rc_status" -eq 0 ]; then
    channel_gh=healthy
    channel_api=healthy
  else
    case "${reauth_failure_id:-}" in NETWORK.*) channel_gh=healthy ;; *) channel_gh=invalid ;; esac
    channel_api=failed
  fi
  render_diagnostic "$rc_json" "$rc_user" "" gh-account
  if [ "$rc_status" -eq 2 ]; then
    emit_event auth.reauth.cancelled cancelled "$(diagnostic_status)" "$rc_status" gh "$rc_user" "" "$restoration_status"
  else
    rc_outcome=failed
    [ "$rc_status" -ne 0 ] || rc_outcome=completed
    emit_event auth.reauth.completed "$rc_outcome" "$(diagnostic_status)" "$rc_status" gh "$rc_user" "" "$restoration_status"
  fi
  return "$rc_status"
}

onboard_command() {
  [ "$#" -ge 1 ] || die_code "$EXIT_USAGE" "onboard requires USER"
  oc_user=$1
  shift
  validate_login "$oc_user" || die_code "$EXIT_USAGE" "invalid account login"
  oc_repo_arg=
  oc_scopes=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --scopes) [ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "--scopes requires LIST"; oc_scopes=$2; shift 2 ;;
      --*) die_code "$EXIT_USAGE" "unknown onboard option '$1'" ;;
      *) [ -z "$oc_repo_arg" ] || die_code "$EXIT_USAGE" "onboard accepts only one repository"; oc_repo_arg=$1; shift ;;
    esac
  done
  if [ -n "$oc_scopes" ]; then
    oc_scopes=$(normalize_scope_list "$oc_scopes") || die_code "$EXIT_USAGE" "requested scopes are invalid"
  fi
  if ! command_exists gh || ! command_exists git || ! command_exists jq; then
    die_code "$EXIT_UNAVAILABLE" "onboard requires gh, git, and jq"
  fi
  assert_safe_git_context
  assert_no_token_override
  oc_repo=
  if [ -n "$oc_repo_arg" ]; then
    oc_repo=$(repository_root "$oc_repo_arg" 2>/dev/null || true)
    [ -n "$oc_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $oc_repo_arg"
    git_config_posture_is_safe "$oc_repo" || \
      die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  fi
  if ! refresh_accounts; then
    [ -z "$last_network_failure" ] || die_code "$EXIT_TEMPFAIL" "GitHub authentication inventory is temporarily unavailable"
    die_code "$EXIT_FAILURE" "could not inspect stored accounts"
  fi
  stored_account "$oc_user" && die_code "$EXIT_CONFIG" "account is already stored; use reauth"
  acquire_lock
  oc_lock=$?
  case "$oc_lock" in
    0) ;;
    2) die_code "$EXIT_TEMPFAIL" "another account operation holds the lock" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported operation-lock backend is available" ;;
    *) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
  esac
  if ! recover_pending_transaction; then
    transaction_mode=none
    die_code "$EXIT_TEMPFAIL" "an interrupted Git configuration transaction requires recovery"
  fi
  if ! refresh_accounts; then
    [ -z "$last_network_failure" ] || die_code "$EXIT_TEMPFAIL" "GitHub authentication inventory is temporarily unavailable"
    die_code "$EXIT_FAILURE" "could not refresh account inventory"
  fi
  stored_account "$oc_user" && die_code "$EXIT_CONFIG" "account was onboarded concurrently; no second login was started"
  restore_account=$(active_account)
  if [ -n "$restore_account" ]; then
    restore_required=true
    write_restore_quarantine "$restore_account" || die_code "$EXIT_FAILURE" "could not persist the account restoration journal"
  fi
  printf '%s: opening native GitHub onboarding for %s\n' "$program" "$oc_user"
  if [ -n "$oc_scopes" ]; then
    run_tracked_interactive gh auth login --hostname "$host" --git-protocol https --web --scopes "$oc_scopes"
  else
    run_tracked_interactive gh auth login --hostname "$host" --git-protocol https --web
  fi
  oc_status=$?
  if [ "$oc_status" -eq 0 ]; then
    mutation_performed=true
    refresh_accounts || oc_status=$EXIT_FAILURE
    if [ "$oc_status" -eq 0 ]; then
      oc_active=$(active_account)
      if [ "$(printf '%s' "$oc_active" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$oc_user" | tr '[:upper:]' '[:lower:]')" ] || ! verify_effective_identity "$oc_user"; then
        printf '%s: browser authorized a different account; leaving credentials intact and refusing binding\n' "$program" >&2
        oc_status=$EXIT_CONFIG
      elif [ "$(account_source "$oc_user")" != keyring ]; then
        printf '%s: onboarded credential is not stored in the native keyring\n' "$program" >&2
        oc_status=$EXIT_FAILURE
      elif [ -n "$oc_repo" ]; then
        bind_account_transactional "$oc_user" "$oc_repo" || oc_status=$EXIT_FAILURE
      fi
    fi
  fi
  finish_operation "$oc_status"
  oc_status=$?
  emit_event auth.onboard.completed "$(event_outcome "$oc_status")" "$( [ "$oc_status" -eq 0 ] && printf healthy || printf action_required )" "$oc_status" gh "$oc_user" "${oc_repo:-}" "$restoration_status"
  return "$oc_status"
}

repair_command() {
  [ "$#" -ge 1 ] || die_code "$EXIT_USAGE" "repair requires USER"
  rr_user=$1
  shift
  validate_login "$rr_user" || die_code "$EXIT_USAGE" "invalid account login"
  rr_repo_arg=
  rr_dry=false
  rr_interactive=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) rr_dry=true; shift ;;
      --interactive) rr_interactive=true; shift ;;
      --*) die_code "$EXIT_USAGE" "unknown repair option '$1'" ;;
      *) [ -z "$rr_repo_arg" ] || die_code "$EXIT_USAGE" "repair accepts only one repository"; rr_repo_arg=$1; shift ;;
    esac
  done
  if ! command_exists gh || ! command_exists git || ! command_exists jq; then
    die_code "$EXIT_UNAVAILABLE" "repair requires gh, git, and jq"
  fi
  assert_safe_git_context
  assert_no_token_override
  rr_repo=
  if [ -n "$rr_repo_arg" ]; then
    rr_repo=$(repository_root "$rr_repo_arg" 2>/dev/null || true)
    [ -n "$rr_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $rr_repo_arg"
  fi
  git_config_posture_is_safe "$rr_repo" || \
    die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: Git configuration ownership, permissions, or ACLs are unsafe"
  refresh_accounts || die_code "$EXIT_FAILURE" "could not inspect GitHub CLI accounts"
  stored_account "$rr_user" || die_code "$EXIT_AUTH" "account is not stored; run 'gh-account onboard $rr_user' explicitly"
  if [ "$rr_dry" = true ]; then
    if ! usable_account "$rr_user"; then
      printf 'would-run-interactively: gh auth refresh --hostname %s\n' "$host"
    fi
    printf 'would-run: gh auth setup-git --hostname %s\n' "$host"
    printf 'would-set: credential.https://%s.useHttpPath=true\n' "$host"
    printf 'would-set: user.useConfigOnly=true\n'
    [ -n "$rr_repo" ] && printf 'would-bind: %s (%s)\n' "$rr_user" "$rr_repo"
    emit_event auth.repair.requested dry_run warning 0 gh-account "$rr_user" "$rr_repo" "$restoration_status"
    return 0
  fi
  if ! usable_account "$rr_user"; then
    if [ "$rr_interactive" = true ]; then
      perform_reauth "$rr_user" "" false
      rr_auth_status=$?
      if [ "$rr_auth_status" -ne 0 ]; then
        if [ "$rr_auth_status" -eq 2 ]; then
          emit_event auth.repair.cancelled cancelled failed "$rr_auth_status" gh "$rr_user" "$rr_repo" "$restoration_status"
        else
          emit_event auth.repair.completed failed action_required "$rr_auth_status" gh "$rr_user" "$rr_repo" "$restoration_status"
        fi
        return "$rr_auth_status"
      fi
      refresh_accounts || return "$EXIT_FAILURE"
    else
      printf '%s: authentication requires operator action; run: gh-account repair %s%s --interactive\n' \
        "$program" "$rr_user" "${rr_repo_arg:+ $rr_repo_arg}" >&2
      emit_event auth.repair.awaiting_user awaiting_user action_required "$EXIT_AUTH" gh-account "$rr_user" "$rr_repo_arg" "$restoration_status"
      return "$EXIT_AUTH"
    fi
  fi
  begin_operation "$rr_user" false false
  rr_begin=$?
  case "$rr_begin" in
    0) ;;
    2|5|6) return "$EXIT_TEMPFAIL" ;;
    3) return "$EXIT_UNAVAILABLE" ;;
    7) return "$EXIT_AUTH" ;;
    8) return "$EXIT_NOPERM" ;;
    *) return "$EXIT_FAILURE" ;;
  esac
  if [ -n "$rr_repo" ]; then
    parse_remote "$rr_repo"
    rr_remote_status=$?
    case "$rr_remote_status" in
      0) [ "$remote_protocol" = https ] || {
           printf '%s: repository remote transport requires explicit manual review\n' "$program" >&2
           finish_operation "$EXIT_CONFIG" || true
           return "$EXIT_CONFIG"
         } ;;
      2|4)
        printf '%s: unsafe or divergent repository remote was refused\n' "$program" >&2
        finish_operation "$EXIT_NOPERM" || true
        return "$EXIT_NOPERM"
        ;;
      *)
        printf '%s: repository origin is missing or unsupported; repair cannot rewrite it safely\n' "$program" >&2
        finish_operation "$EXIT_CONFIG" || true
        return "$EXIT_CONFIG"
        ;;
    esac
    repository_transport_overrides "$rr_repo" || {
      finish_operation "$EXIT_FAILURE" || true
      return "$EXIT_FAILURE"
    }
    if [ "$repository_local_helper_override" = true ] || \
       [ "$repository_specific_helper_override" = true ] || \
       [ "$repository_username_override" = true ] || \
       [ "$repository_header_override" = true ] || \
       [ "$repository_tls_unsafe" = true ] || \
       [ "$repository_proxy_configured" = true ] || \
       [ "$repository_use_http_path_override" = true ] || \
       [ "$repository_use_config_only_override" = true ] || \
       [ "$repository_url_rewrite" = true ] || \
       repository_has_worktree_identity_override "$rr_repo"; then
      printf '%s: repository transport or worktree overrides require explicit manual review before repair\n' "$program" >&2
      finish_operation "$EXIT_CONFIG" || true
      return "$EXIT_CONFIG"
    fi
  fi
  rr_helper_key="credential.https://$host.helper"
  rr_home_config_path=$HOME/.gitconfig
  rr_xdg_config_path=${XDG_CONFIG_HOME:-$HOME/.config}/git/config
  if ! snapshot_config_file "$rr_home_config_path"; then
    finish_operation "$EXIT_FAILURE" || true
    return "$EXIT_FAILURE"
  fi
  rr_home_config_state=$config_file_state
  rr_home_config_snapshot=$config_file_snapshot
  if ! prepare_config_stage "$rr_home_config_state" "$rr_home_config_snapshot"; then
    finish_operation "$EXIT_FAILURE" || true
    return "$EXIT_FAILURE"
  fi
  rr_home_expected_state=present
  rr_home_expected_snapshot=$staged_config_snapshot
  if ! snapshot_config_file "$rr_xdg_config_path"; then
    finish_operation "$EXIT_FAILURE" || true
    return "$EXIT_FAILURE"
  fi
  rr_xdg_config_state=$config_file_state
  rr_xdg_config_snapshot=$config_file_snapshot
  rr_xdg_expected_state=$rr_xdg_config_state
  rr_xdg_expected_snapshot=$rr_xdg_config_snapshot
  rr_status=0
  run_tracked env GIT_CONFIG_GLOBAL="$rr_home_expected_snapshot" GIT_CONFIG_NOSYSTEM=1 \
    gh auth setup-git --hostname "$host" >/dev/null 2>&1 || rr_status=$EXIT_FAILURE
  if [ "$rr_status" -eq 0 ]; then
    git config --file "$rr_home_expected_snapshot" --replace-all "$rr_helper_key" '' || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    git config --file "$rr_home_expected_snapshot" --add "$rr_helper_key" '!gh auth git-credential' || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    git config --file "$rr_home_expected_snapshot" "credential.https://$host.useHttpPath" true || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    git config --file "$rr_home_expected_snapshot" user.useConfigOnly true || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ] && [ -n "$rr_repo" ]; then
    prepare_binding_transaction "$rr_user" "$rr_repo" || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    transaction_mode=repair
    write_transaction_journal || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    config_file_matches_expectation "$rr_xdg_config_path" "$rr_xdg_config_state" \
      "$rr_xdg_config_snapshot" "$HOME" || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ] && [ -n "$binding_config_path" ]; then
    config_file_matches_expectation "$binding_config_path" "$binding_config_state" \
      "$binding_config_snapshot" "$binding_config_root" || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    install_config_snapshot "$rr_home_config_path" "$rr_home_config_state" \
      "$rr_home_config_snapshot" "$rr_home_expected_snapshot" "$HOME" || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ] && [ -n "$binding_config_path" ]; then
    install_prepared_binding || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ]; then
    if [ -n "$rr_repo" ]; then
      rr_use_path=$(git -C "$rr_repo" config --get "credential.https://$host.useHttpPath" 2>/dev/null || true)
      rr_use_only=$(git -C "$rr_repo" config --get user.useConfigOnly 2>/dev/null || true)
    else
      rr_use_path=$(git config --global --get "credential.https://$host.useHttpPath" 2>/dev/null || true)
      rr_use_only=$(git config --global --get user.useConfigOnly 2>/dev/null || true)
    fi
    [ "$rr_use_path" = true ] || rr_status=$EXIT_FAILURE
    [ "$rr_use_only" = true ] || rr_status=$EXIT_FAILURE
    native_helper_configured "$host" "$rr_repo" || rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -eq 0 ] && ! clear_transaction_journal; then
    rr_status=$EXIT_FAILURE
  fi
  if [ "$rr_status" -ne 0 ]; then
    rr_rollback_failed=false
    if ! rollback_binding_transaction; then
      printf '%s: critical: repair failed and repository identity rollback was incomplete\n' "$program" >&2
      mutation_performed=true
      rr_rollback_failed=true
    fi
    if ! rollback_repair_global; then
      printf '%s: critical: repair failed and global Git configuration rollback was incomplete\n' "$program" >&2
      mutation_performed=true
      rr_rollback_failed=true
    fi
    [ "$rr_rollback_failed" = true ] || clear_transaction_journal || rr_rollback_failed=true
  else
    transaction_mode=none
    clear_binding_transaction_state
    rr_home_expected_state=
    rr_home_expected_snapshot=
    rr_xdg_expected_state=
    rr_xdg_expected_snapshot=
    mutation_performed=true
  fi
  finish_operation "$rr_status"
  rr_status=$?
  emit_event auth.repair.completed "$(event_outcome "$rr_status")" "$( [ "$rr_status" -eq 0 ] && printf healthy || printf action_required )" "$rr_status" gh-account "$rr_user" "$rr_repo" "$restoration_status"
  return "$rr_status"
}

legacy_bind() {
  [ "$#" -eq 2 ] || die_code "$EXIT_USAGE" "bind requires USER and accepts one optional REPO"
  lb_user=$1
  validate_login "$lb_user" || die_code "$EXIT_USAGE" "invalid account login"
  assert_safe_git_context
  lb_repo=$(repository_root "$2" 2>/dev/null || true)
  [ -n "$lb_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $2"
  git_config_posture_is_safe "$lb_repo" || \
    die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  begin_operation "$lb_user" false false
  lb_begin=$?
  case "$lb_begin" in
    0) ;;
    2|5|6) die_code "$EXIT_TEMPFAIL" "account routing is temporarily unavailable" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported operation-lock backend is available" ;;
    7) die_code "$EXIT_AUTH" "binding requires one previously active account that can be restored" ;;
    8) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
    *) die_code "$EXIT_FAILURE" "could not select healthy account '$lb_user'" ;;
  esac
  bind_account_transactional "$lb_user" "$lb_repo"
  lb_status=$?
  finish_operation "$lb_status"
}

legacy_use() {
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die_code "$EXIT_USAGE" "use requires USER and accepts one optional REPO"
  lu_user=$1
  validate_login "$lu_user" || die_code "$EXIT_USAGE" "invalid account login"
  assert_safe_git_context
  lu_repo=
  [ "$#" -eq 1 ] || lu_repo=$(repository_root "$2" 2>/dev/null || true)
  [ "$#" -eq 1 ] || [ -n "$lu_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $2"
  if [ -n "$lu_repo" ]; then
    git_config_posture_is_safe "$lu_repo" || \
      die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  fi
  begin_operation "$lu_user" false true
  lu_begin=$?
  case "$lu_begin" in
    0) ;;
    2|5|6) die_code "$EXIT_TEMPFAIL" "account routing is temporarily unavailable" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported operation-lock backend is available" ;;
    8) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
    *) die_code "$EXIT_FAILURE" "could not select healthy account '$lu_user'" ;;
  esac
  if [ "$auto_revalidation_required" = true ]; then
    lu_current_binding=$(bound_account "$lu_repo")
    if [ "$lu_current_binding" != "$auto_expected_binding" ]; then
      auto_revalidation_required=false
      finish_operation "$EXIT_TEMPFAIL" || true
      return "$EXIT_TEMPFAIL"
    fi
    if [ -z "$auto_expected_binding" ]; then
      if ! parse_remote "$lu_repo" || ! stored_account "$remote_owner" || \
         [ "$(printf '%s' "$(canonical_account "$remote_owner")" | tr '[:upper:]' '[:lower:]')" != \
           "$(printf '%s' "$lu_user" | tr '[:upper:]' '[:lower:]')" ]; then
        auto_revalidation_required=false
        finish_operation "$EXIT_TEMPFAIL" || true
        return "$EXIT_TEMPFAIL"
      fi
    fi
    auto_revalidation_required=false
  fi
  lu_status=0
  verify_effective_identity "$lu_user" || lu_status=$EXIT_AUTH
  if [ "$lu_status" -eq 0 ] && [ -n "$lu_repo" ]; then
    bind_account_transactional "$lu_user" "$lu_repo" true || lu_status=$EXIT_FAILURE
  fi
  if [ "$lu_status" -eq 0 ] && [ -n "$lu_repo" ]; then
    commit_persistent_binding "$lu_user" "$lu_repo"
    lu_commit_status=$?
    case "$lu_commit_status" in
      0) ;;
      1)
        # The logical commit did not reach durable binding_committed state.
        # Roll the repository binding back while its registered Git lock and
        # the UID-wide operation lock are still held, before restoring the
        # prior account. If recovery cannot complete, hand the intact WAL to
        # the next lock owner and prevent EXIT cleanup outside the lock.
        lu_status=$EXIT_FAILURE
        if rollback_binding_transaction && clear_transaction_journal; then
          transaction_mode=none
          clear_binding_transaction_state
        else
          lu_status=$EXIT_TEMPFAIL
          transaction_mode=none
          clear_binding_transaction_state
          temp_root=
        fi
        ;;
      2)
        # The durable committed journal owns remaining metadata cleanup. Do not
        # let EXIT touch it after the operation lock is released, and preserve
        # its private snapshots for the next lock owner.
        lu_status=$EXIT_TEMPFAIL
        transaction_mode=none
        clear_binding_transaction_state
        temp_root=
        ;;
      *) lu_status=$EXIT_FAILURE ;;
    esac
  elif [ "$lu_status" -eq 0 ]; then
    clear_restore_quarantine || lu_status=$EXIT_FAILURE
    if [ "$lu_status" -eq 0 ]; then
      restore_required=false
      restoration_status=not-required
    fi
  fi
  if [ "$lu_status" -eq 0 ] || [ "$transaction_mode" = binding_committed ]; then
    release_lock || lu_status=$EXIT_TEMPFAIL
  else
    finish_operation "$lu_status"
    lu_status=$?
  fi
  [ "$lu_status" -ne 0 ] || printf 'gh-active: %s\n' "$lu_user"
  return "$lu_status"
}

legacy_auto() {
  [ "$#" -le 1 ] || die_code "$EXIT_USAGE" "auto accepts one optional REPO"
  la_path=${1:-.}
  assert_safe_git_context
  la_repo=$(repository_root "$la_path" 2>/dev/null || true)
  [ -n "$la_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $la_path"
  git_config_posture_is_safe "$la_repo" || \
    die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  refresh_accounts || die_code "$EXIT_FAILURE" "could not inspect GitHub CLI accounts"
  auto_expected_binding=$(bound_account "$la_repo")
  la_user=$auto_expected_binding
  if [ -n "$la_user" ] && ! validate_login "$la_user"; then
    die_code "$EXIT_CONFIG" "repository account metadata is invalid; run doctor"
  fi
  if [ -z "$la_user" ]; then
    if parse_remote "$la_repo" && stored_account "$remote_owner"; then
      la_user=$(canonical_account "$remote_owner")
    else
      die_code "$EXIT_CONFIG" "no safe account inference; bind an explicit account"
    fi
  fi
  usable_account "$la_user" || die_code "$EXIT_AUTH" "repository account '$la_user' requires native-keyring reauthentication"
  auto_revalidation_required=true
  legacy_use "$la_user" "$la_repo"
}

valid_repository_selector() {
  vrs_value=$1
  case "$vrs_value" in
    "$host"/*/*) vrs_path=${vrs_value#"$host"/} ;;
    */*) vrs_path=$vrs_value ;;
    *) return 1 ;;
  esac
  case "$vrs_path" in
    */*/*|/*|*/|*[!A-Za-z0-9_.\/-]*) return 1 ;;
  esac
  vrs_owner=${vrs_path%%/*}
  vrs_repo=${vrs_path#*/}
  [ -n "$vrs_owner" ] && [ -n "$vrs_repo" ]
}

gh_command_uses_repository() {
  case "$1" in
    issue|pr|release|run|workflow) return 0 ;;
    repo)
      case "${2:-}" in list|create) return 1 ;; *) return 0 ;; esac
      ;;
    *) return 1 ;;
  esac
}

exec_routes_to_host() {
  [ "${GH_REPO+x}" != x ] || return 1
  erh_command=${1:-}
  erh_expect_repo=false
  erh_explicit_repo=false
  exec_resolved_repo=
  for erh_arg in "$@"; do
    if [ "$erh_expect_repo" = true ]; then
      valid_repository_selector "$erh_arg" || return 1
      erh_explicit_repo=true
      erh_expect_repo=false
      continue
    fi
    case "$erh_arg" in
      --web|-w) return 1 ;;
      --hostname|--repo|-R) [ "$erh_arg" = --hostname ] && return 1; erh_expect_repo=true ;;
      --hostname=*|--repo=) return 1 ;;
      --repo=*) valid_repository_selector "${erh_arg#--repo=}" || return 1; erh_explicit_repo=true ;;
      -R?*) valid_repository_selector "${erh_arg#-R}" || return 1; erh_explicit_repo=true ;;
      http://*|https://*|ssh://*|git@*)
        case "$erh_arg" in
          "https://$host/"*|"http://$host/"*|"ssh://git@$host/"*|"git@$host:"*) ;;
          *) return 1 ;;
        esac
        ;;
      */*/*)
        if [ "$erh_command" != api ]; then
          case "$erh_arg" in
            "$host/"*/*) valid_repository_selector "$erh_arg" || return 1; erh_explicit_repo=true ;;
            *) return 1 ;;
          esac
        fi
        ;;
    esac
  done
  [ "$erh_expect_repo" = false ] || return 1
  if gh_command_uses_repository "$@"; then
    erh_repo=$(repository_root . 2>/dev/null || true)
    if [ -n "$erh_repo" ]; then
      git_config_posture_is_safe "$erh_repo" || return 1
      parse_remote "$erh_repo"
      erh_remote=$?
      case "$erh_remote" in
        0) exec_resolved_repo=$host/$remote_owner/$remote_repo ;;
        1) [ "$erh_explicit_repo" = true ] || return 1 ;;
        *) return 1 ;;
      esac
    elif [ "$erh_explicit_repo" != true ]; then
      return 1
    fi
  fi
  return 0
}

graphql_variable_assignment_is_safe() {
  gvas_assignment=$1
  case "$gvas_assignment" in
    *=*) ;;
    *) return 1 ;;
  esac
  gvas_name=${gvas_assignment%%=*}
  case "$gvas_name" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
  esac
  gvas_name_lower=$(printf '%s' "$gvas_name" | tr '[:upper:]' '[:lower:]')
  case "$gvas_name_lower" in query|operationname) return 1 ;; esac
  return 0
}

api_is_read_only() {
  if [ "${1:-}" = graphql ]; then
    shift
    airo_expect_field=
    airo_query_seen=false
    for airo_arg in "$@"; do
      if [ -n "$airo_expect_field" ]; then
        if [ "$airo_expect_field" = raw ]; then
          case "$airo_arg" in
            query=*) airo_query=${airo_arg#query=} ;;
            *) return 1 ;;
          esac
        else
          graphql_variable_assignment_is_safe "$airo_arg" || return 1
          airo_expect_field=
          continue
        fi
        airo_expect_field=
      else
        case "$airo_arg" in
          -f|--raw-field) airo_expect_field=raw; continue ;;
          -F|--field) airo_expect_field=typed; continue ;;
          -fquery=*) airo_query=${airo_arg#-fquery=} ;;
          --raw-field=query=*) airo_query=${airo_arg#--raw-field=query=} ;;
          -f*|--raw-field=*) return 1 ;;
          -F*)
            graphql_variable_assignment_is_safe "${airo_arg#-F}" || return 1
            continue
            ;;
          --field=*)
            graphql_variable_assignment_is_safe "${airo_arg#--field=}" || return 1
            continue
            ;;
          *) return 1 ;;
        esac
      fi
      [ "$airo_query_seen" = false ] || return 1
      airo_query_seen=true
      printf '%s' "$airo_query" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
      airo_query_lower=$(printf '%s' "$airo_query" | tr '[:upper:]' '[:lower:]')
      case "$airo_query_lower" in query\(*|query\ *|\{*) ;; *) return 1 ;; esac
      case "$airo_query_lower" in *mutation*|*subscription*) return 1 ;; esac
    done
    [ -z "$airo_expect_field" ] && [ "$airo_query_seen" = true ]
    return
  fi
  airo_expect_method=false
  for airo_arg in "$@"; do
    if [ "$airo_expect_method" = true ]; then
      [ "$airo_arg" = GET ] || return 1
      airo_expect_method=false
      continue
    fi
    case "$airo_arg" in
      -X|--method) airo_expect_method=true ;;
      -XGET|--method=GET) ;;
      -X*|--method=*) return 1 ;;
      -f|-F|--field|--raw-field|--input|-H|--header) return 1 ;;
      -f*|-F*|--field=*|--raw-field=*|--input=*|-H?*|--header=*) return 1 ;;
    esac
  done
  [ "$airo_expect_method" = false ]
}

exec_is_safe() {
  eis_first=${1:-}
  eis_second=${2:-}
  exec_routes_to_host "$@" || return 1
  case "$eis_first" in
    auth)
      [ "$eis_second" = status ] || return 1
      shift 2
      for eis_arg in "$@"; do
        case "$eis_arg" in
          --show-token|--show-token=*|-h|-h*) return 1 ;;
          --*) ;;
          -*)
            eis_short=${eis_arg#-}
            case "$eis_short" in *t*) return 1 ;; esac
            ;;
        esac
      done
      ;;
    api)
      shift
      api_is_read_only "$@" || return 1
      ;;
    repo)
      case "$eis_second" in ''|-*) return 1 ;; esac
      case "$eis_second" in clone|sync|fork|deploy-key) return 1 ;; esac
      ;;
    pr) case "$eis_second" in ''|-*|checkout) return 1 ;; esac ;;
    issue) case "$eis_second" in ''|-*|develop) return 1 ;; esac ;;
    secret) [ "$eis_second" = list ] || return 1 ;;
    codespace) [ "$eis_second" = list ] || return 1 ;;
    gist) case "$eis_second" in ''|-*|clone) return 1 ;; esac ;;
    agent-task|attestation|cache|completion|discussion|label|licenses|org|project|release|ruleset|run|search|skill|status|variable|workflow)
      ;;
    *) return 1 ;;
  esac
  return 0
}

exec_command() {
  [ "$#" -ge 2 ] || die_code "$EXIT_USAGE" "exec requires USER and gh arguments"
  ec_user=$1
  shift
  [ "${1:-}" = -- ] && shift
  [ "$#" -gt 0 ] || die_code "$EXIT_USAGE" "exec requires gh arguments"
  validate_login "$ec_user" || die_code "$EXIT_USAGE" "invalid account login"
  assert_safe_git_context
  if ! exec_is_safe "$@"; then
    if command_exists jq && init_findings; then
      add_finding SAFETY.REFUSED error "unsafe authentication, credential, API mutation, or cross-host routing was refused" false true false
      emit_event safety.refused refused action_required "$EXIT_NOPERM" gh-account "$ec_user" "" "$restoration_status"
    fi
    die_code "$EXIT_NOPERM" "SAFETY.REFUSED: command would bypass the configured host or protected authentication boundary"
  fi
  begin_operation "$ec_user" false false
  ec_begin=$?
  if [ "$ec_begin" -eq 2 ]; then
    die_code "$EXIT_TEMPFAIL" "timed out waiting for another account operation"
  elif [ "$ec_begin" -eq 4 ]; then
    die_code "$EXIT_AUTH" "account '$ec_user' is missing or unhealthy; run doctor"
  elif [ "$ec_begin" -eq 7 ]; then
    die_code "$EXIT_AUTH" "temporary routing requires one previously active account; select one with gh-account use"
  elif [ "$ec_begin" -eq 3 ]; then
    die_code "$EXIT_UNAVAILABLE" "no supported operation-lock backend is available"
  elif [ "$ec_begin" -eq 8 ]; then
    die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely"
  elif [ "$ec_begin" -eq 5 ] || [ "$ec_begin" -eq 6 ]; then
    die_code "$EXIT_TEMPFAIL" "account routing recovery is required before retrying"
  elif [ "$ec_begin" -ne 0 ]; then
    die_code "$EXIT_FAILURE" "could not select account '$ec_user'"
  fi
  if ! verify_effective_identity "$ec_user"; then
    ec_verify_status=$EXIT_AUTH
    [ -z "$last_network_failure" ] || ec_verify_status=$EXIT_TEMPFAIL
    finish_operation "$ec_verify_status"
    ec_verify_status=$?
    if [ -n "$last_network_failure" ]; then
      die_code "$ec_verify_status" "GitHub API transport failed; credential invalidity is not proven"
    fi
    die_code "$ec_verify_status" "effective API identity does not match '$ec_user'"
  fi
  if [ -n "$exec_resolved_repo" ]; then
    run_tracked env GH_HOST="$host" GH_REPO="$exec_resolved_repo" \
      GH_PROMPT_DISABLED=1 GH_BROWSER=/usr/bin/false BROWSER=/usr/bin/false \
      GH_EDITOR=/usr/bin/false GIT_EDITOR=/usr/bin/false VISUAL=/usr/bin/false EDITOR=/usr/bin/false \
      GH_PAGER=/usr/bin/false GIT_PAGER=/usr/bin/false PAGER=/usr/bin/false \
      GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false SSH_ASKPASS=/usr/bin/false \
      gh "$@"
  else
    run_tracked env GH_HOST="$host" \
      GH_PROMPT_DISABLED=1 GH_BROWSER=/usr/bin/false BROWSER=/usr/bin/false \
      GH_EDITOR=/usr/bin/false GIT_EDITOR=/usr/bin/false VISUAL=/usr/bin/false EDITOR=/usr/bin/false \
      GH_PAGER=/usr/bin/false GIT_PAGER=/usr/bin/false PAGER=/usr/bin/false \
      GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false SSH_ASKPASS=/usr/bin/false \
      gh "$@"
  fi
  ec_status=$?
  finish_operation "$ec_status"
  ec_status=$?
  emit_event gh.exec.completed "$(event_outcome "$ec_status")" "$( [ "$ec_status" -eq 0 ] && printf healthy || printf action_required )" "$ec_status" gh "$ec_user" "" "$restoration_status"
  return "$ec_status"
}

git_exec_is_safe() {
  [ "$#" -ge 2 ] || return 1
  ges_command=$1
  ges_remote=$2
  case "$ges_command" in fetch|push|ls-remote) ;; *) return 1 ;; esac
  [ "$ges_remote" = origin ] || return 1
  shift 2
  ges_end_options=false
  for ges_arg in "$@"; do
    printf '%s' "$ges_arg" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
    case "$ges_arg" in
      http://*|https://*|ssh://*|git@*) return 1 ;;
      --) ges_end_options=true; continue ;;
    esac
    [ "$ges_end_options" = false ] || continue
    case "$ges_arg" in -*) ;; *) continue ;; esac
    case "$ges_command:$ges_arg" in
      push:-f|push:--force|push:--force-with-lease|push:--force-with-lease=*|\
      push:--force-if-includes|push:--atomic|push:--no-atomic|push:--follow-tags|push:--no-follow-tags|\
      push:--tags|push:--delete|push:-d|push:-n|push:--dry-run|push:--porcelain|push:-q|push:--quiet|\
      push:-v|push:--verbose|push:--no-verify|push:-o|push:-o?*|\
      push:--push-option|push:--push-option=*|push:--ipv4|push:--ipv6|push:--progress|push:--no-progress|\
      push:--thin|push:--no-thin|push:--prune) ;;
      fetch:-a|fetch:--append|fetch:-f|fetch:--force|fetch:-p|fetch:--prune|fetch:-P|fetch:--prune-tags|\
      fetch:-t|fetch:--tags|fetch:-n|fetch:--no-tags|fetch:-j|fetch:-j?*|fetch:--jobs|fetch:--jobs=*|\
      fetch:-k|fetch:--keep|fetch:--depth|fetch:--depth=*|fetch:--deepen|fetch:--deepen=*|\
      fetch:--shallow-since|fetch:--shallow-since=*|fetch:--shallow-exclude|fetch:--shallow-exclude=*|\
      fetch:--unshallow|fetch:--update-shallow|fetch:--refetch|fetch:--dry-run|\
      fetch:--write-fetch-head|fetch:--no-write-fetch-head|fetch:-q|fetch:--quiet|fetch:-v|fetch:--verbose|\
      fetch:--progress|fetch:--no-progress|fetch:--ipv4|fetch:--ipv6|\
      fetch:--negotiation-tip|fetch:--negotiation-tip=*) ;;
      ls-remote:-h|ls-remote:--heads|ls-remote:-t|ls-remote:--tags|ls-remote:--refs|\
      ls-remote:--exit-code|ls-remote:--sort=*|ls-remote:--symref|ls-remote:--get-url|\
      ls-remote:-q|ls-remote:--quiet) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

git_exec_repository_is_safe() {
  ger_user=$1
  ger_repo=$2
  git_route_failure=repository-binding
  ger_marker=$(git -C "$ger_repo" config --local --get github.account 2>/dev/null || true)
  ger_credential=$(git -C "$ger_repo" config --local --get credential.username 2>/dev/null || true)
  ger_name=$(git -C "$ger_repo" config --local --get user.name 2>/dev/null || true)
  ger_email=$(git -C "$ger_repo" config --local --get user.email 2>/dev/null || true)
  validate_login "$ger_marker" && validate_login "$ger_credential" || return 1
  ger_expected=$(printf '%s' "$ger_user" | tr '[:upper:]' '[:lower:]')
  [ "$(printf '%s' "$ger_marker" | tr '[:upper:]' '[:lower:]')" = "$ger_expected" ] && \
    [ "$(printf '%s' "$ger_credential" | tr '[:upper:]' '[:lower:]')" = "$ger_expected" ] || return 1
  git_route_failure=commit-identity
  commit_name_is_configured "$ger_name" && [ "$ger_email" = "$identity_email" ] || return 1
  git_route_failure=effective-identity-override
  [ "$(git -C "$ger_repo" config --get github.account 2>/dev/null || true)" = "$ger_marker" ] && \
    [ "$(git -C "$ger_repo" config --get credential.username 2>/dev/null || true)" = "$ger_credential" ] && \
    [ "$(git -C "$ger_repo" config --get user.name 2>/dev/null || true)" = "$ger_name" ] && \
    [ "$(git -C "$ger_repo" config --get user.email 2>/dev/null || true)" = "$ger_email" ] || return 1
  git_route_failure=origin-url
  parse_remote "$ger_repo" || return 1
  git_route_failure=non-https-origin
  [ "$remote_protocol" = https ] || return 1
  git_route_failure=transport-override
  repository_transport_overrides "$ger_repo" || return 1
  [ "$repository_helper_override" = false ] && \
    [ "$repository_username_override" = false ] && \
    [ "$repository_header_override" = false ] && \
    [ "$repository_tls_unsafe" = false ] && \
    [ "$repository_proxy_configured" = false ] && \
    [ "$repository_use_http_path_unsafe" = false ] && \
    [ "$repository_use_config_only_unsafe" = false ] && \
    [ "$repository_url_rewrite" = false ] || return 1
  git_route_failure=use-http-path
  [ "$(git config --global --get "credential.https://$host.useHttpPath" 2>/dev/null || true)" = true ] || return 1
  git_route_failure=use-config-only
  [ "$(git config --global --get user.useConfigOnly 2>/dev/null || true)" = true ] || return 1
  git_route_failure=credential-helper
  native_helper_configured "$host" "$ger_repo" || return 1
  git_route_failure=
  return 0
}

git_exec_command() {
  [ "$#" -ge 4 ] || die_code "$EXIT_USAGE" "git-exec requires USER, REPO, --, and a routed Git command"
  gec_user=$1
  gec_repo_arg=$2
  shift 2
  [ "${1:-}" = -- ] || die_code "$EXIT_USAGE" "git-exec requires -- before Git arguments"
  shift
  validate_login "$gec_user" || die_code "$EXIT_USAGE" "invalid account login"
  assert_safe_git_context
  git_exec_is_safe "$@" || die_code "$EXIT_NOPERM" "SAFETY.REFUSED: git-exec permits only a reviewed origin fetch, push, or ls-remote"
  gec_repo=$(repository_root "$gec_repo_arg" 2>/dev/null || true)
  [ -n "$gec_repo" ] || die_code "$EXIT_CONFIG" "not a Git repository: $gec_repo_arg (git-exec REPO_PATH is a path to a local worktree, not owner/repo)"
  make_temp || die_code "$EXIT_TEMPFAIL" "repository Git configuration could not be inspected safely"
  gec_config_origins=$new_temp_path
  git_config_posture_is_safe "$gec_repo" "$gec_config_origins" || \
    die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  begin_operation "$gec_user" false false
  gec_begin=$?
  case "$gec_begin" in
    0) ;;
    2|5|6) die_code "$EXIT_TEMPFAIL" "could not acquire a safe routed Git operation" ;;
    4) die_code "$EXIT_AUTH" "account is missing or unhealthy; run doctor" ;;
    7) die_code "$EXIT_AUTH" "temporary routing requires one previously active account; select one with gh-account use" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported operation-lock backend is available" ;;
    8) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
    *) die_code "$EXIT_FAILURE" "could not select the requested GitHub account" ;;
  esac
  if ! resolve_active_identity "$gec_user"; then
    gec_verify_status=$EXIT_CONFIG
    [ -z "$last_network_failure" ] || gec_verify_status=$EXIT_TEMPFAIL
    finish_operation "$gec_verify_status"
    gec_verify_status=$?
    if [ -n "$last_network_failure" ]; then
      die_code "$gec_verify_status" "GitHub API transport failed; credential invalidity is not proven"
    fi
    die_code "$gec_verify_status" "effective API identity does not match the requested account"
  fi
  if ! prepare_git_exec_config_guards "$gec_repo" "$gec_config_origins"; then
    finish_operation "$EXIT_TEMPFAIL" || true
    die_code "$EXIT_TEMPFAIL" "repository configuration could not be snapshotted safely for routed Git"
  fi
  if ! git_exec_repository_is_safe "$gec_user" "$gec_repo"; then
    finish_operation "$EXIT_CONFIG" || true
    die_code "$EXIT_CONFIG" "repository route is not safe for routed Git (${git_route_failure:-repository}); run preflight"
  fi
  if ! acquire_git_exec_config_guards; then
    finish_operation "$EXIT_TEMPFAIL" || true
    die_code "$EXIT_TEMPFAIL" "repository configuration changed or could not be locked for routed Git"
  fi
  gec_git_command=$1
  shift
  case "$gec_git_command" in
    fetch|push)
      run_tracked env GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false \
        SSH_ASKPASS=/usr/bin/false GIT_PAGER=/usr/bin/false PAGER=/usr/bin/false \
        git --no-pager -C "$gec_repo" \
        -c core.hooksPath=/dev/null -c push.gpgSign=false \
        "$gec_git_command" --no-recurse-submodules "$@"
      ;;
    *)
      run_tracked env GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false \
        SSH_ASKPASS=/usr/bin/false GIT_PAGER=/usr/bin/false PAGER=/usr/bin/false \
        git --no-pager -C "$gec_repo" \
        -c core.hooksPath=/dev/null "$gec_git_command" "$@"
      ;;
  esac
  gec_status=$?
  finish_operation "$gec_status"
  gec_status=$?
  emit_event git.exec.completed "$(event_outcome "$gec_status")" "$( [ "$gec_status" -eq 0 ] && printf healthy || printf action_required )" "$gec_status" git "$gec_user" "$gec_repo" "$restoration_status"
  return "$gec_status"
}

list_command() {
  if ! command_exists gh || ! command_exists jq; then
    die_code "$EXIT_UNAVAILABLE" "list requires gh and jq"
  fi
  acquire_lock
  lc_lock_status=$?
  case "$lc_lock_status" in
    0) ;;
    2) die_code "$EXIT_TEMPFAIL" "another account-routed operation is in progress" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported advisory lock backend is available" ;;
    *) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
  esac
  refresh_accounts || { release_lock || true; die_code "$EXIT_FAILURE" "could not read GitHub CLI account inventory"; }
  printf '%s\n' "$accounts_cache" | jq -r --arg host "$host" '
    .hosts[$host][] | [.login, (if .active then "active" else "stored" end), .state, (.tokenSource // "unknown")] | @tsv
  '
  lc_status=$?
  release_lock || die_code "$EXIT_TEMPFAIL" "failed to release the account snapshot lock"
  return "$lc_status"
}

current_command() {
  [ "$#" -le 1 ] || die_code "$EXIT_USAGE" "current accepts one optional REPO"
  if ! command_exists gh || ! command_exists git || ! command_exists jq; then
    die_code "$EXIT_UNAVAILABLE" "current requires gh, git, and jq"
  fi
  assert_safe_git_context
  cc_repo=$(repository_root "${1:-.}" 2>/dev/null || true)
  if [ -n "$cc_repo" ]; then
    git_config_posture_is_safe "$cc_repo" || \
      die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: repository Git configuration ownership, permissions, or ACLs are unsafe"
  fi
  acquire_lock
  cc_lock_status=$?
  case "$cc_lock_status" in
    0) ;;
    2) die_code "$EXIT_TEMPFAIL" "another account-routed operation is in progress" ;;
    3) die_code "$EXIT_UNAVAILABLE" "no supported advisory lock backend is available" ;;
    *) die_code "$EXIT_NOPERM" "the account-operation lock could not be validated safely" ;;
  esac
  refresh_accounts || { release_lock || true; die_code "$EXIT_FAILURE" "could not read GitHub CLI account state"; }
  cc_active=$(active_account)
  printf 'gh-active: %s\n' "$cc_active"
  [ -z "$cc_active" ] || printf 'gh-auth-state: %s\n' "$(account_state "$cc_active")"
  if [ -n "$cc_repo" ]; then
    cc_bound=$(bound_account "$cc_repo")
    cc_name=$(git -C "$cc_repo" config --local --get user.name 2>/dev/null || true)
    cc_email=$(git -C "$cc_repo" config --local --get user.email 2>/dev/null || true)
    cc_bound_status=$cc_bound
    if [ -n "$cc_bound" ] && ! validate_login "$cc_bound"; then
      cc_bound_status=invalid-redacted
      cc_bound=
    fi
    [ -n "$cc_bound_status" ] || cc_bound_status=unbound
    printf 'git-bound: %s\n' "$cc_bound_status"
    commit_name_is_configured "$cc_name" && [ -n "$cc_email" ] && cc_author=configured-redacted || cc_author=unconfigured
    printf 'git-author: %s\n' "$cc_author"
    cc_identity=mismatch
    if [ -n "$cc_bound" ] && commit_name_is_configured "$cc_name" && noreply_email_matches_login "$cc_bound" "$cc_email"; then
      cc_identity=ok
    fi
    printf 'identity-status: %s\n' "$cc_identity"
    printf 'repository: %s\n' "$cc_repo"
  fi
  release_lock || die_code "$EXIT_TEMPFAIL" "failed to release the account snapshot lock"
}

insights_command() {
  # Prefer the analyzer bundled alongside this script (repo/extension install);
  # fall back to an AIAUDIT_HOME-style external audit wiki if one is present.
  case "$0" in
    /*) ic_self_dir=${0%/*} ;;
    */*) ic_self_dir=$(cd "${0%/*}" 2>/dev/null && pwd) || ic_self_dir= ;;
    *) ic_self_dir=$(command -v "$0" 2>/dev/null); ic_self_dir=${ic_self_dir%/*} ;;
  esac
  ic_bundled=${ic_self_dir:+$ic_self_dir/scripts/analyze-gh-account-events.sh}
  if [ -n "$ic_bundled" ] && [ -x "$ic_bundled" ]; then
    ic_root=${AIAUDIT_HOME:-$HOME/.local/state/gh-account}
    ic_analyzer=$ic_bundled
  else
    ic_root=${AIAUDIT_HOME:-$HOME/.ai-audit}
    ic_analyzer=$ic_root/scripts/analyze-gh-account-events.sh
  fi
  [ -x "$ic_analyzer" ] || die_code "$EXIT_UNAVAILABLE" "audit analyzer is unavailable: $ic_analyzer"
  AIAUDIT_ROOT="$ic_root" "$ic_analyzer" "$@"
}

main() {
  command=${1:-help}
  [ "$#" -eq 0 ] || shift
  case "$command" in
    doctor|insights|help|-h|--help) ;;
    *)
      validate_host || die_code "$EXIT_CONFIG" "invalid GH_ACCOUNT_HOST"
      assert_safe_gh_context
      gh_config_posture_is_safe || \
        die_code "$EXIT_NOPERM" "CONFIG.UNSAFE_PERMISSIONS: GitHub CLI configuration ownership, permissions, links, or ACLs are unsafe"
      ;;
  esac
  case "$command" in
    list) [ "$#" -eq 0 ] || die_code "$EXIT_USAGE" "list accepts no arguments"; list_command ;;
    current) current_command "$@" ;;
    doctor) doctor_command "$@" ;;
    preflight) preflight_command "$@" ;;
    repair) repair_command "$@" ;;
    reauth) reauth_command "$@" ;;
    onboard) onboard_command "$@" ;;
    insights) insights_command "$@" ;;
    bind)
      [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die_code "$EXIT_USAGE" "bind requires USER and accepts one optional REPO"
      legacy_bind "$1" "${2:-.}"
      ;;
    use) legacy_use "$@" ;;
    auto) legacy_auto "$@" ;;
    exec) exec_command "$@" ;;
    git-exec) git_exec_command "$@" ;;
    help|-h|--help) [ "$#" -eq 0 ] || die_code "$EXIT_USAGE" "help accepts no arguments"; usage ;;
    *) usage >&2; die_code "$EXIT_USAGE" "unknown command '$command'" ;;
  esac
}

trap 'handle_signal HUP' HUP
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM
trap final_cleanup 0

main "$@"
